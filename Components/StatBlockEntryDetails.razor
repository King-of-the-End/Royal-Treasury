@using System.Text.Json
@using Website_of_Everything.Models
@using Website_of_Everything.Components.Pages


@if (
    !string.IsNullOrWhiteSpace(
        Entry.Description))
{
    <GlossaryText
        Text="@Entry.Description"
        Context="GlossaryContext.StatBlock" />
}


@if (Entry.Spellcasting is not null)
{
    @if (Entry.Spellcasting.AlternativeSpellLists.Count > 0)
    {
        <div class="rt-spell-list-switcher">
            <div class="rt-spell-list-switcher-title">
                Spell Lists
            </div>

            <div
                class="rt-spell-list-tabs"
                role="tablist"
                aria-label="Spell list">

                <button
                    type="button"
                    class="@SpellListTabClass(0)"
                    role="tab"
                    aria-selected="@(_selectedSpellListIndex == 0)"
                    @onclick="() => SelectSpellList(0)">
                    Spell List 1
                </button>

                @for (
                    var index = 0;
                    index < Entry.Spellcasting.AlternativeSpellLists.Count;
                    index++)
                {
                    var tabIndex =
                        index + 1;

                    var alternative =
                        Entry.Spellcasting.AlternativeSpellLists[index];

                    <button
                        type="button"
                        class="@SpellListTabClass(tabIndex)"
                        role="tab"
                        aria-selected="@(_selectedSpellListIndex == tabIndex)"
                        @onclick="() => SelectSpellList(tabIndex)">
                        @($"Spell List {tabIndex + 1}")
                    </button>
                }

            </div>
        </div>
    }


    @if (ActiveSpells.Count > 0 || ActivePreparedSpells.Count > 0)
    {
        <div class="rt-spell-list-rows">

            @foreach (
                var spellGroup
                in ActiveSpells)
            {
                <div class="rt-spell-row">
                    <div class="rt-spell-row-heading">
                        <GlossaryText
                            Text="@spellGroup.Frequency"
                            Context="GlossaryContext.StatBlock" />
                    </div>

                    <div class="rt-spell-row-spells">
                        @for (
                            var index = 0;
                            index < spellGroup.Spells.Count;
                            index++)
                        {
                            if (index > 0)
                            {
                                <span class="rt-spell-separator">, </span>
                            }

                            <GlossaryText
                                Text="@spellGroup.Spells[index]"
                                Context="GlossaryContext.StatBlock" />
                        }
                    </div>
                </div>
            }


            @foreach (
                var preparedGroup
                in ActivePreparedSpells)
            {
                <div class="rt-spell-row">
                    <div class="rt-spell-row-heading">
                        @PreparedSpellHeading(
                            preparedGroup)
                    </div>

                    <div class="rt-spell-row-spells">
                        @for (
                            var index = 0;
                            index < preparedGroup.Spells.Count;
                            index++)
                        {
                            if (index > 0)
                            {
                                <span class="rt-spell-separator">, </span>
                            }

                            <GlossaryText
                                Text="@preparedGroup.Spells[index]"
                                Context="GlossaryContext.StatBlock" />
                        }
                    </div>
                </div>
            }

        </div>
    }


    @if (
        !string.IsNullOrWhiteSpace(
            ActiveAdditionalText))
    {
        <br />
        <br />

        <GlossaryText
            Text="@ActiveAdditionalText"
            Context="GlossaryContext.StatBlock" />
    }


    @if (
        !string.IsNullOrWhiteSpace(
            ActiveCastingLevelNote))
    {
        <br />
        <br />

        <GlossaryText
            Text="@ActiveCastingLevelNote"
            Context="GlossaryContext.StatBlock" />
    }


    @foreach (
        var note
        in ActiveNotes)
    {
        if (
            !string.IsNullOrWhiteSpace(
                note))
        {
            <br />
            <br />

            <GlossaryText
                Text="@note"
                Context="GlossaryContext.StatBlock" />
        }
    }
}

@if (NestedEntries.Count > 0)
{
    @foreach (
        var option
        in NestedEntries)
    {
        <br />

        <span>
            •
        </span>

        @if (
            !string.IsNullOrWhiteSpace(
                option.Name))
        {
            <strong>
                <em>

                    <GlossaryText
                        Text="@option.Name"
                        Context="GlossaryContext.StatBlock" />.

                </em>
            </strong>

            <span>
                @(" ")
            </span>
        }

        <StatBlockEntryDetails
            Entry="@option" />
    }
}


@if (
    !string.IsNullOrWhiteSpace(
        Entry.AdditionalText))
{
    <br />
    <br />

    <GlossaryText
        Text="@Entry.AdditionalText"
        Context="GlossaryContext.StatBlock" />
}


@code {

    [Parameter]
    [EditorRequired]
    public StatBlockEntry Entry { get; set; } =
        new();


    private int _selectedSpellListIndex;


    private string PrimarySpellListName =>
        string.IsNullOrWhiteSpace(
            Entry.Spellcasting?.SpellListName)

        ? "Default"

        : Entry.Spellcasting!.SpellListName.Trim();


    private StatBlockAlternativeSpellList?
        SelectedAlternativeSpellList
    {
        get
        {
            if (
                Entry.Spellcasting is null ||
                _selectedSpellListIndex <= 0)
            {
                return null;
            }

            var alternativeIndex =
                _selectedSpellListIndex - 1;

            return
                alternativeIndex >= 0 &&
                alternativeIndex <
                    Entry.Spellcasting.AlternativeSpellLists.Count

                ? Entry.Spellcasting.AlternativeSpellLists[
                    alternativeIndex]

                : null;
        }
    }


    private IReadOnlyList<StatBlockSpellFrequency>
        ActiveSpells =>
            SelectedAlternativeSpellList?.Spells
            ??
            Entry.Spellcasting?.Spells
            ??
            new List<StatBlockSpellFrequency>();


    private IReadOnlyList<StatBlockPreparedSpellLevel>
        ActivePreparedSpells =>
            SelectedAlternativeSpellList?.PreparedSpells
            ??
            Entry.Spellcasting?.PreparedSpells
            ??
            new List<StatBlockPreparedSpellLevel>();


    private string ActiveAdditionalText =>
        SelectedAlternativeSpellList is { } alternative &&
        !string.IsNullOrWhiteSpace(
            alternative.AdditionalText)

        ? alternative.AdditionalText

        : Entry.Spellcasting?.AdditionalText
          ??
          string.Empty;


    private string ActiveCastingLevelNote =>
        SelectedAlternativeSpellList is { } alternative &&
        !string.IsNullOrWhiteSpace(
            alternative.CastingLevelNote)

        ? alternative.CastingLevelNote

        : Entry.Spellcasting?.CastingLevelNote
          ??
          string.Empty;


    private IReadOnlyList<string> ActiveNotes =>
        SelectedAlternativeSpellList is { } alternative &&
        alternative.Notes.Count > 0

        ? alternative.Notes

        : Entry.Spellcasting?.Notes
          ??
          new List<string>();


    protected override void OnParametersSet()
    {
        var alternativeCount =
            Entry.Spellcasting?.AlternativeSpellLists.Count
            ??
            0;

        if (
            _selectedSpellListIndex < 0 ||
            _selectedSpellListIndex > alternativeCount)
        {
            _selectedSpellListIndex = 0;
        }
    }


    private void SelectSpellList(
        int selectedIndex)
    {
        var alternativeCount =
            Entry.Spellcasting?.AlternativeSpellLists.Count
            ??
            0;

        if (
            selectedIndex >= 0 &&
            selectedIndex <= alternativeCount)
        {
            _selectedSpellListIndex =
                selectedIndex;
        }
    }


    private string SpellListTabClass(
        int tabIndex)
    {
        return
            tabIndex == _selectedSpellListIndex
            ? "rt-spell-list-tab is-active"
            : "rt-spell-list-tab";
    }


    private static string AlternativeSpellListName(
        StatBlockAlternativeSpellList alternative,
        int index)
    {
        return
            string.IsNullOrWhiteSpace(
                alternative.Name)

            ? $"Alternative {index + 1}"

            : alternative.Name.Trim();
    }


    private IReadOnlyList<StatBlockEntry>
        NestedEntries =>
            Entry.Options
                .Concat(
                    Entry.Subentries)
                .Concat(
                    Entry.Bullets)
                .ToList();


    // =====================================
    // PREPARED SPELL HEADING
    //
    // Example:
    //
    // 1st level (4 slots)
    // =====================================

    private static string
        PreparedSpellHeading(
            StatBlockPreparedSpellLevel group)
    {
        var level =
            group.Level?.Trim()
            ??
            string.Empty;


        var slots =
            JsonValue(
                group.Slots);


        if (
            string.IsNullOrWhiteSpace(
                slots))
        {
            return
                string.IsNullOrWhiteSpace(
                    level)

                ? "Prepared"

                : $"{level} level";
        }


        var slotLabel =
            slots == "1"

            ? "slot"

            : "slots";


        return
            string.IsNullOrWhiteSpace(
                level)

            ? $"{slots} {slotLabel}"

            : $"{level} level " +
              $"({slots} {slotLabel})";
    }


    // =====================================
    // JSON VALUE
    // =====================================

    private static string
        JsonValue(
            JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String =>
                value.GetString()
                ??
                string.Empty,

            JsonValueKind.Number =>
                value.ToString(),

            _ =>
                string.Empty
        };
    }

}
