@page "/"

<PageTitle>Royal Treasury</PageTitle>

<section class="landing-page">

    <div class="landing-header">

        <div class="landing-kicker">
            Compendium
        </div>

        <h1>Royal Treasury</h1>

        <p class="landing-intro">
            Choose a section to begin browsing the compendium.
        </p>

    </div>


    <div class="card-grid">


        <!-- RULES -->
        <a class="landing-card"
           href="/rules">

            <div class="card-icon">

                <img src="/images/rules.webp"
                     alt="Rules"
                     loading="lazy"
                     decoding="async" />

            </div>

            <strong>
                Rules
            </strong>

        </a>



        <!-- RACES -->
        <a class="landing-card"
           href="/races">

            <div class="card-icon">

                <img src="/images/race.webp"
                     alt="Races"
                     loading="lazy"
                     decoding="async" />

            </div>

            <strong>
                Races
            </strong>

        </a>



        <!-- BACKGROUND -->
