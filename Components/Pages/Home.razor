@page "/"

<PageTitle>Royal Treasury</PageTitle>

<section class="landing-page">

    <div class="landing-header">

        <div class="landing-kicker">
            Compendium
        </div>

        <h1>Royal Treasury</h1>

        <p class="landing-intro">
            Choose a section to begin browsing the compendium.
        </p>

    </div>


    <div class="card-grid">


        <!-- RULES -->
        <a class="landing-card"
           href="/rules">

            <div class="card-icon">

                <img src="/images/rules.png"
                     alt="Rules" />

            </div>

            <strong>
                Rules
            </strong>

        </a>



        <!-- RACES -->
        <a class="landing-card"
           href="/races">

            <div class="card-icon">

                <img src="/images/race.png"
                     alt="Races" />

            </div>

            <strong>
                Races
            </strong>

        </a>



        <!-- BACKGROUND -->
        <a class="landing-card"
           href="/background">

            <div class="card-icon">

                <img src="/images/background.png"
                     alt="Background" />

            </div>

            <strong>
                Background
            </strong>

        </a>



        <!-- CLASSES -->
        <a class="landing-card"
           href="/classes">

            <div class="card-icon">

                <img src="/images/classes.png"
                     alt="Classes" />

            </div>

            <strong>
                Classes
            </strong>

        </a>



        <!-- SPELLS -->
        <a class="landing-card"
           href="/spells">

            <div class="card-icon">

                <img src="/images/spells.png"
                     alt="Spells" />

            </div>

            <strong>
                Spells
            </strong>

        </a>



        <!-- FEATS -->
        <a class="landing-card"
           href="/feats">

            <div class="card-icon">

                <img src="/images/feat.png"
                     alt="Feats" />

            </div>

            <strong>
                Feats
            </strong>

        </a>



        <!-- ITEMS -->
        <a class="landing-card"
           href="/items">

            <div class="card-icon">

                <img src="/images/items.png"
                     alt="Items" />

            </div>

            <strong>
                Items
            </strong>

        </a>



        <!-- BESTIARY -->
        <a class="landing-card"
           href="/bestiary">

            <div class="card-icon">

                <img src="/images/bestiary.png"
                     alt="Bestiary" />

            </div>

            <strong>
                Bestiary
            </strong>

        </a>


    </div>

</section>