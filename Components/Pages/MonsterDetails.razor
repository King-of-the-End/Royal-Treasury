@page "/bestiary/{ChallengeRating}/{Slug}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.WebUtilities
@using Website_of_Everything.Models
@using Website_of_Everything.Services

@inject MonsterService MonsterService
@inject NavigationManager Navigation


<PageTitle>
    @MonsterPageTitle
    - Royal Treasury
</PageTitle>


@if (isLoading)
{
    <section class="monster-detail-page">

        <div class="spell-empty-state">
            Loading monster...
        </div>

    </section>
}
else if (monster is null)
{
    <section class="monster-detail-page">

        <a
            class="monster-back-link"
            href="@BackUrl">

            ← Back to Bestiary

        </a>


        <div class="spell-empty-state">

            That monster could not be found.

        </div>

    </section>
}
else
{
    <article class="monster-detail-page">


        <!-- =================================
             BACK LINK
             ================================= -->

        <a
            class="monster-back-link"
            href="@BackUrl">

            ← Back to Bestiary

        </a>


        <!-- =================================
             DETAIL TABS

             LORE:
             - Monster name
             - Source
             - Group
             - Challenge Rating
             - Monster-specific lore
             - Monster-specific refinement
             - Group lore
             - Monster image

             MONSTER:
             - Full stat block
             ================================= -->

        <div
            class="monster-detail-tabs"
            role="tablist"
            aria-label="Monster details">

            <button
                type="button"
                role="tab"
                aria-selected="@(activeTab == DetailTab.Lore)"
                class="@DetailTabClass(DetailTab.Lore)"
                @onclick="() => SetTab(DetailTab.Lore)">

                Lore

            </button>


            <button
                type="button"
                role="tab"
                aria-selected="@(activeTab == DetailTab.Monster)"
                class="@DetailTabClass(DetailTab.Monster)"
                @onclick="() => SetTab(DetailTab.Monster)">

                Monster

            </button>

        </div>


        <!-- =================================
             LORE TAB
             ================================= -->

        @if (activeTab == DetailTab.Lore)
        {
            <section
                class="monster-detail-tab-panel monster-lore-panel"
                role="tabpanel">


                <!-- =============================
                     MONSTER-SPECIFIC LORE
                     ============================= -->

                @if (
                    HasMetadata
                    ||
                    !string.IsNullOrWhiteSpace(
                        monster.Information)
                    ||
                    monster.LoreTables.Count > 0)
                {
                    <section class="monster-detail-intro">


                        <!-- =============================
                             MONSTER NAME

                             Uses the same heading style
                             as the group lore title.
                             ============================= -->

                        <h2 class="monster-lore-title">

                            @MonsterPageTitle

                        </h2>


                        <!-- =============================
                             SOURCE / GROUP / CR
                             ============================= -->

                        @if (HasMetadata)
                        {
                            <div class="monster-detail-meta">


                                <!-- SOURCE -->

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        DisplaySource))
                                {
                                    <div>

                                        <strong>
                                            Source
                                        </strong>

                                        <span>
                                            @DisplaySource
                                        </span>

                                    </div>
                                }


                                <!-- GROUPS

                                     A monster can belong to more than
                                     one group.

                                     Each group gets its own metadata
                                     field instead of combining every
                                     group into one comma-separated box.

                                     The same group collection is also
                                     used below to load one lore section
                                     for every group.
                                     -->

                                @foreach (
                                    var group
                                    in DistinctMonsterGroups)
                                {
                                    <div>

                                        <strong>
                                            Group
                                        </strong>

                                        <span>
                                            @group
                                        </span>

                                    </div>
                                }


                                <!-- CHALLENGE RATING -->

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        monster.ChallengeRating))
                                {
                                    <div>

                                        <strong>
                                            Challenge Rating
                                        </strong>

                                        <span>
                                            @monster.ChallengeRating
                                        </span>

                                    </div>
                                }

                            </div>
                        }


                        <!-- =============================
                             MONSTER INFORMATION
                             ============================= -->

                        @if (
                            !string.IsNullOrWhiteSpace(
                                monster.Information))
                        {
                            <p class="monster-detail-information">

                                <FormattedGlossaryText
                                    Text="@monster.Information"
                                    Context="GlossaryContext.General" />

                            </p>
                        }


                        <!-- =========================
                             GENERIC MONSTER LORE TABLES

                             Loaded from outer JSON:

                             "Tables": [
                               {
                                 "Title": "...",
                                 "Columns": [ ... ],
                                 "Rows": [ ... ]
                               }
                             ]

                             These belong to Lore and
                             are deliberately not part
                             of the rendered stat block.
                             ========================= -->

                        @foreach (
                            var loreTable
                            in monster.LoreTables)
                        {
                            @if (
                                loreTable.Columns.Count > 0
                                ||
                                loreTable.Rows.Count > 0)
                            {
                                <section class="monster-specific-lore-table">

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            loreTable.Title))
                                    {
                                        <h3>
                                            <GlossaryText
                                                Text="@loreTable.Title"
                                                Context="GlossaryContext.General" />
                                        </h3>
                                    }


                                    <div class="monster-lore-table-wrap">

                                        <table class="monster-lore-table">

                                            @if (
                                                loreTable.Columns.Count > 0)
                                            {
                                                <thead>
                                                    <tr>

                                                        @foreach (
                                                            var column
                                                            in loreTable.Columns)
                                                        {
                                                            <th>
                                                                <GlossaryText
                                                                    Text="@column"
                                                                    Context="GlossaryContext.General" />
                                                            </th>
                                                        }

                                                    </tr>
                                                </thead>
                                            }

                                            <tbody>

                                                @foreach (
                                                    var row
                                                    in loreTable.Rows)
                                                {
                                                    <tr>

                                                        @foreach (
                                                            var cell
                                                            in row)
                                                        {
                                                            <td>
                                                                <GlossaryText
                                                                    Text="@cell"
                                                                    Context="GlossaryContext.General" />
                                                            </td>
                                                        }

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </section>
                            }
                        }

                    </section>
                }


                <!-- =============================
                     GENERIC BARDING TABLE

                     Loaded from the outer:

                     "Barding": {
                       "headers": [ ... ],
                       "rows": [ ... ]
                     }

                     It appears directly after the
                     monster-specific lore that
                     explains the barding options.
                     ============================= -->

                @if (
                    monster.Barding is not null
                    &&
                    (
                        monster.Barding.Headers.Count > 0
                        ||
                        monster.Barding.Rows.Count > 0
                    ))
                {
                    <div class="monster-lore-table-wrap">

                        <table class="monster-lore-table">

                            @if (
                                monster.Barding.Headers.Count > 0)
                            {
                                <thead>
                                    <tr>

                                        @foreach (
                                            var header
                                            in monster.Barding.Headers)
                                        {
                                            <th>
                                                <GlossaryText
                                                    Text="@header.Text"
                                                    Context="GlossaryContext.General" />
                                            </th>
                                        }

                                    </tr>
                                </thead>
                            }

                            <tbody>

                                @foreach (
                                    var row
                                    in monster.Barding.Rows)
                                {
                                    <tr>

                                        @foreach (
                                            var cell
                                            in row)
                                        {
                                            <td>
                                                <GlossaryText
                                                    Text="@cell"
                                                    Context="GlossaryContext.General" />
                                            </td>
                                        }

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }


                <!-- =============================
                     MONSTER REFINEMENT

                     Loaded from the outer
                     "Refinement" object.
                     ============================= -->

                @if (
                    monster.Refinement is not null)
                {
                    <section class="monster-refinement">

                        @if (
                            !string.IsNullOrWhiteSpace(
                                monster.Refinement.Title))
                        {
                            <h2>
                                @monster.Refinement.Title
                            </h2>
                        }


                        @if (
                            !string.IsNullOrWhiteSpace(
                                monster.Refinement.Description))
                        {
                            <p>
                                <FormattedGlossaryText
                                    Text="@monster.Refinement.Description"
                                    Context="GlossaryContext.General" />
                            </p>
                        }


                        @if (
                            monster.Refinement.Notes.Count > 0)
                        {
                            <ul class="monster-refinement-notes">

                                @foreach (
                                    var note
                                    in monster.Refinement.Notes)
                                {
                                    <li>
                                        <FormattedGlossaryText
                                            Text="@note"
                                            Context="GlossaryContext.General" />
                                    </li>
                                }

                            </ul>
                        }


                        @if (
                            monster.Refinement.Table.Count > 0)
                        {
                            <div class="monster-refinement-table-wrap">

                                <table class="monster-refinement-table">

                                    <thead>
                                        <tr>
                                            <th>Dragon</th>
                                            <th>Ability Scores</th>
                                            <th>Hit Points</th>
                                            <th>Movement</th>
                                            <th>Immunities</th>
                                            <th>Attack</th>
                                            <th>Breath / Blood DC</th>
                                            <th>Wing DC</th>
                                            <th>Breath Damage</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (
                                            var row
                                            in monster.Refinement.Table)
                                        {
                                            <tr>
                                                <td>@row.Color</td>
                                                <td>@FormatRefinementAbilityScores(row)</td>
                                                <td>@row.HitPoints</td>
                                                <td>@DisplayValues(row.Movement)</td>
                                                <td>@DisplayValues(row.Immunities)</td>
                                                <td>@row.AttackModifier</td>
                                                <td>@row.BreathAndBloodDc</td>
                                                <td>@row.WingDc</td>
                                                <td>@row.BreathDamage</td>
                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </section>
                }


                <!-- =============================
                     GROUP LORE

                     Supports "title" or "name",
                     section headings, paragraphs,
                     bullets and tables.
                     ============================= -->

                @foreach (
                    var groupLore
                    in groupLores)
                {
                    <section class="monster-group-lore">

                        <h2>
                            @groupLore.DisplayTitle.Text
                        </h2>


                        @foreach (
                            var loreSection
                            in groupLore.Sections)
                        {
                            @if (
                                !string.IsNullOrWhiteSpace(
                                    loreSection.Name.Text))
                            {
                                <h3>
                                    <GlossaryText
                                        Text="@loreSection.Name.Text"
                                        Context="GlossaryContext.General" />
                                </h3>
                            }


                            @foreach (
                                var paragraph
                                in loreSection.Paragraphs)
                            {
                                <p>

                                    <FormattedGlossaryText
                                        Spans="@paragraph.Spans"
                                        Context="GlossaryContext.General" />

                                </p>
                            }


                            @if (
                                loreSection.Bullets.Count > 0)
                            {
                                <ul class="monster-group-lore-list">

                                    @foreach (
                                        var bullet
                                        in loreSection.Bullets)
                                    {
                                        <li>
                                            <FormattedGlossaryText
                                                Text="@bullet.Text"
                                                Context="GlossaryContext.General" />
                                        </li>
                                    }

                                </ul>
                            }


                            @if (
                                loreSection.Table is not null
                                &&
                                (
                                    loreSection.Table.Headers.Count > 0
                                    ||
                                    loreSection.Table.Rows.Count > 0
                                ))
                            {
                                <div class="monster-lore-table-wrap">

                                    <table class="monster-lore-table">

                                        @if (
                                            loreSection.Table.Headers.Count > 0)
                                        {
                                            <thead>
                                                <tr>

                                                    @foreach (
                                                        var header
                                                        in loreSection.Table.Headers)
                                                    {
                                                        <th>
                                                            <GlossaryText
                                                                Text="@header.Text"
                                                                Context="GlossaryContext.General" />
                                                        </th>
                                                    }

                                                </tr>
                                            </thead>
                                        }

                                        <tbody>

                                            @foreach (
                                                var row
                                                in loreSection.Table.Rows)
                                            {
                                                <tr>

                                                    @foreach (
                                                        var cell
                                                        in row)
                                                    {
                                                        <td>
                                                            <GlossaryText
                                                                Text="@cell"
                                                                Context="GlossaryContext.General" />
                                                        </td>
                                                    }

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>
                            }
                        }

                    </section>
                }


                <!-- =============================
                     MONSTER IMAGE

                     The value of monster.Image
                     may be:

                     - a local wwwroot path

                     OR

                     - a complete external URL,
                       such as a Cloudflare R2
                       custom-domain URL.

                     Example JSON:

                     "image":
                     "https://images.example.com/
                     monsters/
                     black-bloated-horker.webp"

                     This is deliberately placed
                     at the very bottom of Lore.
                     ============================= -->

                @if (MonsterImages.Count > 0)
                {
                    <!-- =========================
                         IMAGE VARIANT TABS

                         Image 1 is always the
                         standard "Image" URL.

                         Image 2 onward come from
                         "Image Variants".
                         ========================= -->

                    @if (MonsterImages.Count > 1)
                    {
                        <div
                            class="monster-variant-tabs monster-image-tabs"
                            role="tablist"
                            aria-label="@($"{MonsterPageTitle} images")">

                            @for (
                                var imageIndex = 0;
                                imageIndex < MonsterImages.Count;
                                imageIndex++)
                            {
                                var capturedImageIndex =
                                    imageIndex;


                                <button
                                    type="button"
                                    role="tab"
                                    aria-selected="@(selectedImageIndex == capturedImageIndex)"
                                    class="@ImageTabClass(capturedImageIndex)"
                                    @onclick="() => SetImage(capturedImageIndex)">

                                    Image @(capturedImageIndex + 1)

                                </button>
                            }

                        </div>
                    }


                    <div class="monster-detail-image-wrap">

                        <img
                            @key="SelectedMonsterImage"
                            src="@SelectedMonsterImage"
                            alt="@($"{MonsterPageTitle} image {selectedImageIndex + 1}")"
                            loading="lazy"
                            decoding="async" />

                    </div>
                }


                <!-- =============================
                     NO LORE AVAILABLE

                     An image counts as Lore-page
                     content, so this message does
                     not appear when an image exists.
                     ============================= -->

                @if (
                    !HasAnyLore
                    &&
                    groupLores.Count == 0
                    &&
                    monster.Refinement is null
                    &&
                    MonsterImages.Count == 0)
                {
                    <div class="spell-empty-state">

                        No lore is available for this monster yet.

                    </div>
                }

            </section>
        }


        <!-- =================================
             MONSTER TAB
             ================================= -->

        @if (activeTab == DetailTab.Monster)
        {
            <section
                class="monster-detail-tab-panel monster-statblock-panel"
                role="tabpanel">


                <!-- =============================
                     STAT-BLOCK VARIANT TABS

                     Shown only when the outer
                     monster document contains
                     more than one stat block.
                     ============================= -->

                @if (monsterVariants.Count > 1)
                {
                    <div
                        class="monster-variant-tabs"
                        role="tablist"
                        aria-label="@($"{MonsterPageTitle} stat block versions")">

                        @foreach (
                            var variant
                            in monsterVariants)
                        {
                            <button
                                type="button"
                                role="tab"
                                aria-selected="@IsSelectedMonsterVariant(variant)"
                                class="@MonsterVariantTabClass(variant)"
                                @onclick="() => SetMonsterVariant(variant)">

                                @MonsterVariantLabel(variant)

                            </button>
                        }

                    </div>
                }


                <!-- =============================
                     SELECTED FULL STAT BLOCK
                     ============================= -->

                @if (selectedMonsterVariant is not null)
                {
                    <div class="monster-variant-statblock">

                        <StatBlock
                            Data="@selectedMonsterVariant" />

                    </div>
                }

            </section>
        }

    </article>
}


@code {

    // =====================================
    // DETAIL TABS
    // =====================================

    private enum DetailTab
    {
        Lore,
        Monster
    }


    // =====================================
    // ROUTE PARAMETERS
    // =====================================

    [Parameter]
    public string ChallengeRating { get; set; } =
        string.Empty;


    [Parameter]
    public string Slug { get; set; } =
        string.Empty;


    // =====================================
    // PAGE STATE
    // =====================================

    private StatBlockData? monster;


    private IReadOnlyList<StatBlockData>
        monsterVariants =
            Array.Empty<StatBlockData>();


    private StatBlockData?
        selectedMonsterVariant;


    private IReadOnlyList<MonsterGroupLoreData>
        groupLores =
            Array.Empty<MonsterGroupLoreData>();


    private bool isLoading =
        true;


    private DetailTab activeTab =
        DetailTab.Lore;


    private int selectedImageIndex =
        0;


    // =====================================
    // LOAD MONSTER WHEN ROUTE CHANGES
    // =====================================

    protected override async Task
        OnParametersSetAsync()
    {
        // =================================
        // BEGIN LOADING
        // =================================

        isLoading =
            true;


        // =================================
        // DEFAULT TO LORE
        // =================================

        activeTab =
            DetailTab.Lore;


        selectedImageIndex =
            0;


        // =================================
        // LOAD MONSTER
        // =================================

        monster =
            await MonsterService
                .GetMonsterAsync(
                    ChallengeRating,
                    Slug);


        // =================================
        // MONSTER NOT FOUND
        // =================================

        if (monster is null)
        {
            monsterVariants =
                Array.Empty<StatBlockData>();


            selectedMonsterVariant =
                null;


            groupLores =
                Array.Empty<MonsterGroupLoreData>();


            isLoading =
                false;


            return;
        }


        // =================================
        // LOAD STAT-BLOCK VARIANTS
        // =================================

        monsterVariants =
            await MonsterService
                .GetMonsterVariantsAsync(
                    ChallengeRating,
                    Slug);


        if (monsterVariants.Count == 0)
        {
            monsterVariants =
                new[]
                {
                    monster
                };
        }


        selectedMonsterVariant =
            monsterVariants
                .FirstOrDefault(
                    variant =>
                        SameMonster(
                            variant,
                            monster))
            ??
            monsterVariants[0];


        // =================================
        // LOAD GROUP LORE
        //
        // For example:
        //
        // monster.Group = "Abishai"
        //
        // loads:
        //
        // data/monster/Groups/Abishai.json
        // =================================

        groupLores =
            await MonsterService
                .GetMonsterGroupLoreAsync(
                    DistinctMonsterGroups);


        // =================================
        // FINISHED
        // =================================

        isLoading =
            false;
    }


    // =====================================
    // SET ACTIVE TAB
    // =====================================

    private void SetTab(
        DetailTab tab)
    {
        activeTab =
            tab;
    }


    // =====================================
    // TAB CLASS
    // =====================================

    private string DetailTabClass(
        DetailTab tab)
    {
        return
            activeTab == tab

            ? "monster-detail-tab active"

            : "monster-detail-tab";
    }


    // =====================================
    // MONSTER PAGE TITLE
    // =====================================

    private string MonsterPageTitle
    {
        get
        {
            if (monster is null)
            {
                return
                    "Monster";
            }


            if (
                monsterVariants.Count > 1
                &&
                !string.IsNullOrWhiteSpace(
                    monster.MonsterSetName))
            {
                return
                    monster.MonsterSetName.Trim();
            }


            return
                monster.Title;
        }
    }


    // =====================================
    // SELECT MONSTER VARIANT
    // =====================================

    private void SetMonsterVariant(
        StatBlockData variant)
    {
        selectedMonsterVariant =
            variant;
    }


    // =====================================
    // VARIANT ACTIVE STATE
    // =====================================

    private bool IsSelectedMonsterVariant(
        StatBlockData variant)
    {
        if (
            selectedMonsterVariant is null)
        {
            return
                false;
        }


        return
            SameMonster(
                selectedMonsterVariant,
                variant);
    }


    // =====================================
    // VARIANT TAB CLASS
    // =====================================

    private string MonsterVariantTabClass(
        StatBlockData variant)
    {
        return
            IsSelectedMonsterVariant(
                variant)

            ? "monster-variant-tab active"

            : "monster-variant-tab";
    }


    // =====================================
    // VARIANT TAB LABEL
    //
    // Uses an explicit JSON "tag" when one
    // is supplied. Otherwise it derives a
    // short label from the outer monster set
    // name where possible.
    //
    // Belzers + Ambush Belzer -> Ambush
    // =====================================

    private string MonsterVariantLabel(
        StatBlockData variant)
    {
        if (
            !string.IsNullOrWhiteSpace(
                variant.Tag))
        {
            return
                variant.Tag.Trim();
        }


        var title =
            variant.Title?.Trim()
            ??
            string.Empty;


        if (
            string.IsNullOrWhiteSpace(
                title))
        {
            return
                "Version";
        }


        var setName =
            monster?.MonsterSetName
                ?.Trim()
            ??
            string.Empty;


        if (
            !string.IsNullOrWhiteSpace(
                setName)
            &&
            setName.EndsWith(
                "s",
                StringComparison.OrdinalIgnoreCase)
            &&
            setName.Length > 1)
        {
            var singularSetName =
                setName[..^1];


            var suffix =
                $" {singularSetName}";


            if (
                title.EndsWith(
                    suffix,
                    StringComparison.OrdinalIgnoreCase)
                &&
                title.Length > suffix.Length)
            {
                var shortLabel =
                    title[
                        ..^suffix.Length]
                        .Trim();


                if (
                    !string.IsNullOrWhiteSpace(
                        shortLabel))
                {
                    return
                        shortLabel;
                }
            }
        }


        return
            title;
    }


    // =====================================
    // SAME STAT BLOCK
    // =====================================

    private static bool SameMonster(
        StatBlockData left,
        StatBlockData right)
    {
        if (
            !string.IsNullOrWhiteSpace(
                left.Id)
            &&
            !string.IsNullOrWhiteSpace(
                right.Id))
        {
            return
                left.Id.Equals(
                    right.Id,
                    StringComparison.OrdinalIgnoreCase);
        }


        return
            left.Title.Equals(
                right.Title,
                StringComparison.OrdinalIgnoreCase);
    }


    // =====================================
    // MONSTER IMAGES
    //
    // Image 1 is always the standard Image.
    // Image Variants are appended in JSON
    // order and become Image 2, Image 3, etc.
    // Duplicate URLs are removed.
    // =====================================

    private IReadOnlyList<string> MonsterImages
    {
        get
        {
            if (monster is null)
            {
                return
                    Array.Empty<string>();
            }


            var images =
                new List<string>();


            if (
                !string.IsNullOrWhiteSpace(
                    monster.Image))
            {
                images.Add(
                    monster.Image.Trim());
            }


            foreach (
                var image
                in monster.ImageVariants
                ??
                new List<string>())
            {
                if (
                    string.IsNullOrWhiteSpace(
                        image))
                {
                    continue;
                }


                var cleaned =
                    image.Trim();


                if (
                    images.Any(
                        existing =>
                            existing.Equals(
                                cleaned,
                                StringComparison.OrdinalIgnoreCase)))
                {
                    continue;
                }


                images.Add(
                    cleaned);
            }


            return
                images;
        }
    }


    // =====================================
    // SELECTED MONSTER IMAGE
    // =====================================

    private string SelectedMonsterImage
    {
        get
        {
            var images =
                MonsterImages;


            if (images.Count == 0)
            {
                return
                    string.Empty;
            }


            if (
                selectedImageIndex < 0
                ||
                selectedImageIndex >= images.Count)
            {
                selectedImageIndex =
                    0;
            }


            return
                images[selectedImageIndex];
        }
    }


    // =====================================
    // SELECT IMAGE
    // =====================================

    private void SetImage(
        int imageIndex)
    {
        if (
            imageIndex < 0
            ||
            imageIndex >= MonsterImages.Count)
        {
            return;
        }


        selectedImageIndex =
            imageIndex;
    }


    // =====================================
    // IMAGE TAB CLASS
    // =====================================

    private string ImageTabClass(
        int imageIndex)
    {
        return
            selectedImageIndex == imageIndex

            ? "monster-variant-tab monster-image-tab active"

            : "monster-variant-tab monster-image-tab";
    }


    // =====================================
    // BACK URL
    //
    // When the user entered the monster
    // page from the Bestiary, preserve the
    // Bestiary's:
    //
    // - CR
    // - search
    // - type
    // - group
    // - source
    //
    // through returnUrl.
    //
    //
    // Direct URLs fall back to:
    //
    // CR3
    // ->
    // /bestiary?cr=3
    //
    // CR0.125
    // ->
    // /bestiary?cr=0.125
    // =====================================

    private string BackUrl
    {
        get
        {
            // =================================
            // CURRENT URL
            // =================================

            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);


            var query =
                QueryHelpers.ParseQuery(
                    uri.Query);


            // =================================
            // PRESERVED BESTIARY URL
            // =================================

            if (
                query.TryGetValue(
                    "returnUrl",
                    out var returnValue))
            {
                var returnUrl =
                    returnValue
                        .FirstOrDefault();


                /*
                 * Security/sanity check:
                 *
                 * only allow an internal
                 * Bestiary path.
                 */
                if (
                    !string.IsNullOrWhiteSpace(
                        returnUrl)
                    &&
                    returnUrl.StartsWith(
                        "/bestiary",
                        StringComparison.OrdinalIgnoreCase))
                {
                    return
                        returnUrl;
                }
            }


            // =================================
            // FALLBACK
            // =================================

            var cr =
                ChallengeRating
                    ?.Trim()
                ??
                string.Empty;


            // =================================
            // REMOVE "CR"
            // =================================

            if (
                cr.StartsWith(
                    "CR",
                    StringComparison.OrdinalIgnoreCase))
            {
                cr =
                    cr[2..];
            }


            // =================================
            // BUILD BESTIARY URL
            // =================================

            return
                string.IsNullOrWhiteSpace(
                    cr)

                ? "/bestiary"

                : $"/bestiary?cr=" +
                  $"{Uri.EscapeDataString(cr)}";
        }
    }


    // =====================================
    // DISPLAY GROUP
    // =====================================

    private string DisplayGroup =>
        DisplayValues(
            DistinctMonsterGroups);


    // =====================================
    // DISTINCT MONSTER GROUPS
    //
    // A monster can belong to any number of
    // groups.
    //
    // Supported outer JSON forms include:
    //
    // "Group": "Abishai"
    //
    // "Groups": [
    //   "Abishai",
    //   "Devils"
    // ]
    //
    // and MonsterService also accepts an
    // array directly in the outer "Group"
    // property.
    //
    // This normalized collection drives:
    //
    // - the separate Group metadata boxes
    // - all group-lore file loading
    // - the combined DisplayGroup string
    // =====================================

    private IReadOnlyList<string>
        DistinctMonsterGroups =>
            monster is null

            ? Array.Empty<string>()

            : MonsterGroups(
                    monster)
                .Where(
                    group =>
                        !string.IsNullOrWhiteSpace(
                            group))
                .Select(
                    group =>
                        group.Trim())
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .ToList();


    // =====================================
    // DISPLAY SOURCE
    // =====================================

    private string DisplaySource =>
        monster is null

        ? string.Empty

        : DisplayValues(
            MonsterSources(
                monster));


    // =====================================
    // HAS METADATA
    // =====================================

    private bool HasMetadata =>
        monster is not null
        &&
        (
            !string.IsNullOrWhiteSpace(
                DisplayGroup)
            ||
            !string.IsNullOrWhiteSpace(
                DisplaySource)
            ||
            !string.IsNullOrWhiteSpace(
                monster.ChallengeRating)
        );


    // =====================================
    // HAS MONSTER-SPECIFIC LORE
    //
    // Refinement counts as monster-specific
    // lore and is rendered before group lore.
    // The image is handled separately so it
    // can remain at the bottom of the Lore tab.
    // =====================================

    private bool HasAnyLore =>
        monster is not null
        &&
        (
            HasMetadata
            ||
            !string.IsNullOrWhiteSpace(
                monster.Information)
            ||
            monster.LoreTables.Count > 0
            ||
            monster.Refinement is not null
        );


    // =====================================
    // MONSTER GROUPS
    //
    // Supports both:
    //
    // "group": "Abishai"
    //
    // and:
    //
    // "groups": [
    //   "Abishai",
    //   "Devils"
    // ]
    // =====================================

    private static IEnumerable<string>
        MonsterGroups(
            StatBlockData data)
    {
        // =================================
        // PRIMARY GROUP
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                data.Group))
        {
            yield return
                data.Group.Trim();
        }


        // =================================
        // ADDITIONAL GROUPS
        // =================================

        foreach (
            var group
            in data.Groups)
        {
            if (
                !string.IsNullOrWhiteSpace(
                    group))
            {
                yield return
                    group.Trim();
            }
        }
    }


    // =====================================
    // MONSTER SOURCES
    //
    // Supports both:
    //
    // "source": "..."
    //
    // and:
    //
    // "sources": [
    //   "...",
    //   "..."
    // ]
    // =====================================

    private static IEnumerable<string>
        MonsterSources(
            StatBlockData data)
    {
        // =================================
        // PRIMARY SOURCE
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                data.Source))
        {
            yield return
                data.Source.Trim();
        }


        // =================================
        // ADDITIONAL SOURCES
        // =================================

        foreach (
            var source
            in data.Sources)
        {
            if (
                !string.IsNullOrWhiteSpace(
                    source))
            {
                yield return
                    source.Trim();
            }
        }
    }


    // =====================================
    // FORMAT REFINEMENT ABILITY SCORES
    // =====================================

    private static string
        FormatRefinementAbilityScores(
            MonsterRefinementRow row)
    {
        var order =
            new[]
            {
                "STR",
                "DEX",
                "CON",
                "INT",
                "WIS",
                "CHA"
            };


        return
            string.Join(
                " | ",
                order
                    .Where(
                        ability =>
                            row.AbilityScores
                                .ContainsKey(
                                    ability))
                    .Select(
                        ability =>
                            $"{ability} " +
                            $"{row.AbilityScores[ability]}"));
    }


    // =====================================
    // DISPLAY UNIQUE VALUES
    // =====================================

    private static string DisplayValues(
        IEnumerable<string> values)
    {
        return
            string.Join(
                ", ",
                values
                    .Where(
                        value =>
                            !string.IsNullOrWhiteSpace(
                                value))
                    .Select(
                        value =>
                            value.Trim())
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase));
    }

}