@page "/bestiary/{ChallengeRating}/{Slug}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.WebUtilities
@using Website_of_Everything.Models
@using Website_of_Everything.Services

@inject MonsterService MonsterService
@inject NavigationManager Navigation


<PageTitle>
    @(monster is null
        ? "Monster"
        : monster.Title)
    - Royal Treasury
</PageTitle>


@if (isLoading)
{
    <section class="monster-detail-page">

        <div class="spell-empty-state">
            Loading monster...
        </div>

    </section>
}
else if (monster is null)
{
    <section class="monster-detail-page">

        <a
            class="monster-back-link"
            href="@BackUrl">

            ← Back to Bestiary

        </a>


        <div class="spell-empty-state">

            That monster could not be found.

        </div>

    </section>
}
else
{
    <article class="monster-detail-page">


        <!-- =================================
             BACK LINK
             ================================= -->

        <a
            class="monster-back-link"
            href="@BackUrl">

            ← Back to Bestiary

        </a>


        <!-- =================================
             DETAIL TABS

             LORE:
             - Monster name
             - Source
             - Group
             - Challenge Rating
             - Monster-specific lore
             - Monster-specific refinement
             - Group lore
             - Monster image

             MONSTER:
             - Full stat block
             ================================= -->

        <div
            class="monster-detail-tabs"
            role="tablist"
            aria-label="Monster details">

            <button
                type="button"
                role="tab"
                aria-selected="@(activeTab == DetailTab.Lore)"
                class="@DetailTabClass(DetailTab.Lore)"
                @onclick="() => SetTab(DetailTab.Lore)">

                Lore

            </button>


            <button
                type="button"
                role="tab"
                aria-selected="@(activeTab == DetailTab.Monster)"
                class="@DetailTabClass(DetailTab.Monster)"
                @onclick="() => SetTab(DetailTab.Monster)">

                Monster

            </button>

        </div>


        <!-- =================================
             LORE TAB
             ================================= -->

        @if (activeTab == DetailTab.Lore)
        {
            <section
                class="monster-detail-tab-panel monster-lore-panel"
                role="tabpanel">


                <!-- =============================
                     MONSTER-SPECIFIC LORE
                     ============================= -->

                @if (
                    HasMetadata
                    ||
                    !string.IsNullOrWhiteSpace(
                        monster.Information))
                {
                    <section class="monster-detail-intro">


                        <!-- =============================
                             MONSTER NAME

                             Uses the same heading style
                             as the group lore title.
                             ============================= -->

                        <h2 class="monster-lore-title">

                            @monster.Title

                        </h2>


                        <!-- =============================
                             SOURCE / GROUP / CR
                             ============================= -->

                        @if (HasMetadata)
                        {
                            <div class="monster-detail-meta">


                                <!-- SOURCE -->

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        DisplaySource))
                                {
                                    <div>

                                        <strong>
                                            Source
                                        </strong>

                                        <span>
                                            @DisplaySource
                                        </span>

                                    </div>
                                }


                                <!-- GROUP -->

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        DisplayGroup))
                                {
                                    <div>

                                        <strong>
                                            Group
                                        </strong>

                                        <span>
                                            @DisplayGroup
                                        </span>

                                    </div>
                                }


                                <!-- CHALLENGE RATING -->

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        monster.ChallengeRating))
                                {
                                    <div>

                                        <strong>
                                            Challenge Rating
                                        </strong>

                                        <span>
                                            @monster.ChallengeRating
                                        </span>

                                    </div>
                                }

                            </div>
                        }


                        <!-- =============================
                             MONSTER INFORMATION
                             ============================= -->

                        @if (
                            !string.IsNullOrWhiteSpace(
                                monster.Information))
                        {
                            <p class="monster-detail-information">

                                <FormattedGlossaryText
                                    Text="@monster.Information"
                                    Context="GlossaryContext.General" />

                            </p>
                        }

                    </section>
                }


                <!-- =============================
                     MONSTER REFINEMENT

                     Loaded from the outer
                     "Refinement" object.
                     ============================= -->

                @if (
                    monster.Refinement is not null)
                {
                    <section class="monster-refinement">

                        @if (
                            !string.IsNullOrWhiteSpace(
                                monster.Refinement.Title))
                        {
                            <h2>
                                @monster.Refinement.Title
                            </h2>
                        }


                        @if (
                            !string.IsNullOrWhiteSpace(
                                monster.Refinement.Description))
                        {
                            <p>
                                <FormattedGlossaryText
                                    Text="@monster.Refinement.Description"
                                    Context="GlossaryContext.General" />
                            </p>
                        }


                        @if (
                            monster.Refinement.Notes.Count > 0)
                        {
                            <ul class="monster-refinement-notes">

                                @foreach (
                                    var note
                                    in monster.Refinement.Notes)
                                {
                                    <li>
                                        <FormattedGlossaryText
                                            Text="@note"
                                            Context="GlossaryContext.General" />
                                    </li>
                                }

                            </ul>
                        }


                        @if (
                            monster.Refinement.Table.Count > 0)
                        {
                            <div class="monster-refinement-table-wrap">

                                <table class="monster-refinement-table">

                                    <thead>
                                        <tr>
                                            <th>Dragon</th>
                                            <th>Ability Scores</th>
                                            <th>Hit Points</th>
                                            <th>Movement</th>
                                            <th>Immunities</th>
                                            <th>Attack</th>
                                            <th>Breath / Blood DC</th>
                                            <th>Wing DC</th>
                                            <th>Breath Damage</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (
                                            var row
                                            in monster.Refinement.Table)
                                        {
                                            <tr>
                                                <td>@row.Color</td>
                                                <td>@FormatRefinementAbilityScores(row)</td>
                                                <td>@row.HitPoints</td>
                                                <td>@DisplayValues(row.Movement)</td>
                                                <td>@DisplayValues(row.Immunities)</td>
                                                <td>@row.AttackModifier</td>
                                                <td>@row.BreathAndBloodDc</td>
                                                <td>@row.WingDc</td>
                                                <td>@row.BreathDamage</td>
                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </section>
                }


                <!-- =============================
                     GROUP LORE

                     Supports "title" or "name",
                     section headings, paragraphs,
                     bullets and tables.
                     ============================= -->

                @foreach (
                    var groupLore
                    in groupLores)
                {
                    <section class="monster-group-lore">

                        <h2>
                            @groupLore.DisplayTitle.Text
                        </h2>


                        @foreach (
                            var loreSection
                            in groupLore.Sections)
                        {
                            @if (
                                !string.IsNullOrWhiteSpace(
                                    loreSection.Name.Text))
                            {
                                <h3>
                                    <GlossaryText
                                        Text="@loreSection.Name.Text"
                                        Context="GlossaryContext.General" />
                                </h3>
                            }


                            @foreach (
                                var paragraph
                                in loreSection.Paragraphs)
                            {
                                <p>

                                    <FormattedGlossaryText
                                        Spans="@paragraph.Spans"
                                        Context="GlossaryContext.General" />

                                </p>
                            }


                            @if (
                                loreSection.Bullets.Count > 0)
                            {
                                <ul class="monster-group-lore-list">

                                    @foreach (
                                        var bullet
                                        in loreSection.Bullets)
                                    {
                                        <li>
                                            <FormattedGlossaryText
                                                Text="@bullet.Text"
                                                Context="GlossaryContext.General" />
                                        </li>
                                    }

                                </ul>
                            }


                            @if (
                                loreSection.Table is not null
                                &&
                                (
                                    loreSection.Table.Headers.Count > 0
                                    ||
                                    loreSection.Table.Rows.Count > 0
                                ))
                            {
                                <div class="monster-lore-table-wrap">

                                    <table class="monster-lore-table">

                                        @if (
                                            loreSection.Table.Headers.Count > 0)
                                        {
                                            <thead>
                                                <tr>

                                                    @foreach (
                                                        var header
                                                        in loreSection.Table.Headers)
                                                    {
                                                        <th>
                                                            <GlossaryText
                                                                Text="@header.Text"
                                                                Context="GlossaryContext.General" />
                                                        </th>
                                                    }

                                                </tr>
                                            </thead>
                                        }

                                        <tbody>

                                            @foreach (
                                                var row
                                                in loreSection.Table.Rows)
                                            {
                                                <tr>

                                                    @foreach (
                                                        var cell
                                                        in row)
                                                    {
                                                        <td>
                                                            <GlossaryText
                                                                Text="@cell"
                                                                Context="GlossaryContext.General" />
                                                        </td>
                                                    }

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>
                            }
                        }

                    </section>
                }


                <!-- =============================
                     MONSTER IMAGE

                     The value of monster.Image
                     may be:

                     - a local wwwroot path

                     OR

                     - a complete external URL,
                       such as a Cloudflare R2
                       custom-domain URL.

                     Example JSON:

                     "image":
                     "https://images.example.com/
                     monsters/
                     black-bloated-horker.webp"

                     This is deliberately placed
                     at the very bottom of Lore.
                     ============================= -->

                @if (
                    !string.IsNullOrWhiteSpace(
                        monster.Image))
                {
                    <div class="monster-detail-image-wrap">

                        <img
                            src="@monster.Image"
                            alt="@monster.Title"
                            loading="lazy"
                            decoding="async" />

                    </div>
                }


                <!-- =============================
                     NO LORE AVAILABLE

                     An image counts as Lore-page
                     content, so this message does
                     not appear when an image exists.
                     ============================= -->

                @if (
                    !HasAnyLore
                    &&
                    groupLores.Count == 0
                    &&
                    monster.Refinement is null
                    &&
                    string.IsNullOrWhiteSpace(
                        monster.Image))
                {
                    <div class="spell-empty-state">

                        No lore is available for this monster yet.

                    </div>
                }

            </section>
        }


        <!-- =================================
             MONSTER TAB
             ================================= -->

        @if (activeTab == DetailTab.Monster)
        {
            <section
                class="monster-detail-tab-panel monster-statblock-panel"
                role="tabpanel">


                <!-- =============================
                     FULL STAT BLOCK

                     Artwork is intentionally NOT
                     rendered in this tab.
                     ============================= -->

                <StatBlock
                    Data="@monster" />

            </section>
        }

    </article>
}


@code {

    // =====================================
    // DETAIL TABS
    // =====================================

    private enum DetailTab
    {
        Lore,
        Monster
    }


    // =====================================
    // ROUTE PARAMETERS
    // =====================================

    [Parameter]
    public string ChallengeRating { get; set; } =
        string.Empty;


    [Parameter]
    public string Slug { get; set; } =
        string.Empty;


    // =====================================
    // PAGE STATE
    // =====================================

    private StatBlockData? monster;


    private IReadOnlyList<MonsterGroupLoreData>
        groupLores =
            Array.Empty<MonsterGroupLoreData>();


    private bool isLoading =
        true;


    private DetailTab activeTab =
        DetailTab.Lore;


    // =====================================
    // LOAD MONSTER WHEN ROUTE CHANGES
    // =====================================

    protected override async Task
        OnParametersSetAsync()
    {
        // =================================
        // BEGIN LOADING
        // =================================

        isLoading =
            true;


        // =================================
        // DEFAULT TO LORE
        // =================================

        activeTab =
            DetailTab.Lore;


        // =================================
        // LOAD MONSTER
        // =================================

        monster =
            await MonsterService
                .GetMonsterAsync(
                    ChallengeRating,
                    Slug);


        // =================================
        // MONSTER NOT FOUND
        // =================================

        if (monster is null)
        {
            groupLores =
                Array.Empty<MonsterGroupLoreData>();


            isLoading =
                false;


            return;
        }


        // =================================
        // LOAD GROUP LORE
        //
        // For example:
        //
        // monster.Group = "Abishai"
        //
        // loads:
        //
        // data/monster/Groups/Abishai.json
        // =================================

        groupLores =
            await MonsterService
                .GetMonsterGroupLoreAsync(
                    MonsterGroups(
                        monster));


        // =================================
        // FINISHED
        // =================================

        isLoading =
            false;
    }


    // =====================================
    // SET ACTIVE TAB
    // =====================================

    private void SetTab(
        DetailTab tab)
    {
        activeTab =
            tab;
    }


    // =====================================
    // TAB CLASS
    // =====================================

    private string DetailTabClass(
        DetailTab tab)
    {
        return
            activeTab == tab

            ? "monster-detail-tab active"

            : "monster-detail-tab";
    }


    // =====================================
    // BACK URL
    //
    // When the user entered the monster
    // page from the Bestiary, preserve the
    // Bestiary's:
    //
    // - CR
    // - search
    // - type
    // - group
    // - source
    //
    // through returnUrl.
    //
    //
    // Direct URLs fall back to:
    //
    // CR3
    // ->
    // /bestiary?cr=3
    //
    // CR0.125
    // ->
    // /bestiary?cr=0.125
    // =====================================

    private string BackUrl
    {
        get
        {
            // =================================
            // CURRENT URL
            // =================================

            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);


            var query =
                QueryHelpers.ParseQuery(
                    uri.Query);


            // =================================
            // PRESERVED BESTIARY URL
            // =================================

            if (
                query.TryGetValue(
                    "returnUrl",
                    out var returnValue))
            {
                var returnUrl =
                    returnValue
                        .FirstOrDefault();


                /*
                 * Security/sanity check:
                 *
                 * only allow an internal
                 * Bestiary path.
                 */
                if (
                    !string.IsNullOrWhiteSpace(
                        returnUrl)
                    &&
                    returnUrl.StartsWith(
                        "/bestiary",
                        StringComparison.OrdinalIgnoreCase))
                {
                    return
                        returnUrl;
                }
            }


            // =================================
            // FALLBACK
            // =================================

            var cr =
                ChallengeRating
                    ?.Trim()
                ??
                string.Empty;


            // =================================
            // REMOVE "CR"
            // =================================

            if (
                cr.StartsWith(
                    "CR",
                    StringComparison.OrdinalIgnoreCase))
            {
                cr =
                    cr[2..];
            }


            // =================================
            // BUILD BESTIARY URL
            // =================================

            return
                string.IsNullOrWhiteSpace(
                    cr)

                ? "/bestiary"

                : $"/bestiary?cr=" +
                  $"{Uri.EscapeDataString(cr)}";
        }
    }


    // =====================================
    // DISPLAY GROUP
    // =====================================

    private string DisplayGroup =>
        monster is null

        ? string.Empty

        : DisplayValues(
            MonsterGroups(
                monster));


    // =====================================
    // DISPLAY SOURCE
    // =====================================

    private string DisplaySource =>
        monster is null

        ? string.Empty

        : DisplayValues(
            MonsterSources(
                monster));


    // =====================================
    // HAS METADATA
    // =====================================

    private bool HasMetadata =>
        monster is not null
        &&
        (
            !string.IsNullOrWhiteSpace(
                DisplayGroup)
            ||
            !string.IsNullOrWhiteSpace(
                DisplaySource)
            ||
            !string.IsNullOrWhiteSpace(
                monster.ChallengeRating)
        );


    // =====================================
    // HAS MONSTER-SPECIFIC LORE
    //
    // Refinement counts as monster-specific
    // lore and is rendered before group lore.
    // The image is handled separately so it
    // can remain at the bottom of the Lore tab.
    // =====================================

    private bool HasAnyLore =>
        monster is not null
        &&
        (
            HasMetadata
            ||
            !string.IsNullOrWhiteSpace(
                monster.Information)
            ||
            monster.Refinement is not null
        );


    // =====================================
    // MONSTER GROUPS
    //
    // Supports both:
    //
    // "group": "Abishai"
    //
    // and:
    //
    // "groups": [
    //   "Abishai",
    //   "Devils"
    // ]
    // =====================================

    private static IEnumerable<string>
        MonsterGroups(
            StatBlockData data)
    {
        // =================================
        // PRIMARY GROUP
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                data.Group))
        {
            yield return
                data.Group.Trim();
        }


        // =================================
        // ADDITIONAL GROUPS
        // =================================

        foreach (
            var group
            in data.Groups)
        {
            if (
                !string.IsNullOrWhiteSpace(
                    group))
            {
                yield return
                    group.Trim();
            }
        }
    }


    // =====================================
    // MONSTER SOURCES
    //
    // Supports both:
    //
    // "source": "..."
    //
    // and:
    //
    // "sources": [
    //   "...",
    //   "..."
    // ]
    // =====================================

    private static IEnumerable<string>
        MonsterSources(
            StatBlockData data)
    {
        // =================================
        // PRIMARY SOURCE
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                data.Source))
        {
            yield return
                data.Source.Trim();
        }


        // =================================
        // ADDITIONAL SOURCES
        // =================================

        foreach (
            var source
            in data.Sources)
        {
            if (
                !string.IsNullOrWhiteSpace(
                    source))
            {
                yield return
                    source.Trim();
            }
        }
    }


    // =====================================
    // FORMAT REFINEMENT ABILITY SCORES
    // =====================================

    private static string
        FormatRefinementAbilityScores(
            MonsterRefinementRow row)
    {
        var order =
            new[]
            {
                "STR",
                "DEX",
                "CON",
                "INT",
                "WIS",
                "CHA"
            };


        return
            string.Join(
                " | ",
                order
                    .Where(
                        ability =>
                            row.AbilityScores
                                .ContainsKey(
                                    ability))
                    .Select(
                        ability =>
                            $"{ability} " +
                            $"{row.AbilityScores[ability]}"));
    }


    // =====================================
    // DISPLAY UNIQUE VALUES
    // =====================================

    private static string DisplayValues(
        IEnumerable<string> values)
    {
        return
            string.Join(
                ", ",
                values
                    .Where(
                        value =>
                            !string.IsNullOrWhiteSpace(
                                value))
                    .Select(
                        value =>
                            value.Trim())
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase));
    }

}