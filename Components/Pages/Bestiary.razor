    // =====================================
    // RESTORE URL STATE
    // =====================================

    private void RestoreStateFromUrl()
    {
        var uri =
            Navigation.ToAbsoluteUri(
                Navigation.Uri);


        var query =
            QueryHelpers.ParseQuery(
                uri.Query);


        // =================================
        // CR
        // =================================

        var requestedCr =
            QueryValue(
                query,
                "cr");


        if (
            ChallengeRatings.Any(
                cr =>
                    string.Equals(
                        cr.Value,
                        requestedCr,
                        StringComparison.OrdinalIgnoreCase)))
        {
            activeChallengeRating =
                requestedCr;
        }


        // =================================
        // SEARCH
        // =================================

        searchQuery =
            QueryValue(
                query,
                "search");


        // =================================
        // OPEN PANELS
        // =================================

        typeFilterOpen =
            QueryIsTrue(
                query,
                "typeOpen");


        groupFilterOpen =
            QueryIsTrue(
                query,
                "groupOpen");


        sourceFilterOpen =
            QueryIsTrue(
                query,
                "sourceOpen");


        // =================================
        // TYPE
        // =================================

        selectedCreatureType =
            QueryValue(
                query,
                "type");


        if (
            !string.IsNullOrWhiteSpace(
                selectedCreatureType))
        {
            var valid =
                CreatureTypes.Any(
                    type =>
                        type.Value.Equals(
                            selectedCreatureType,
                            StringComparison.OrdinalIgnoreCase));


            if (!valid)
            {
                selectedCreatureType =
                    string.Empty;
            }
        }


        // =================================
        // GROUP
        // =================================

        selectedGroup =
            QueryValue(
                query,
                "group");


        // =================================
        // SOURCE
        // =================================

        selectedSource =
            QueryValue(
                query,
                "source");


        // =================================
        // IF A VALUE EXISTS, KEEP ITS PANEL
        // OPEN SO THE USER CAN SEE IT.
        // =================================

        typeFilterOpen |=
            !string.IsNullOrWhiteSpace(
                selectedCreatureType);


        groupFilterOpen |=
            !string.IsNullOrWhiteSpace(
                selectedGroup);


        sourceFilterOpen |=
            !string.IsNullOrWhiteSpace(
                selectedSource);
    }


    // =====================================
    // SYNC URL
    // =====================================

    private void SyncUrl()
    {
        Navigation.NavigateTo(
            BuildListUrl(),
            replace: true);
    }


    // =====================================
    // BUILD URL
    // =====================================

    private string BuildListUrl()
    {
        var query =
            new Dictionary<string, string?>
            {
                ["cr"] =
                    activeChallengeRating
            };


        // =================================
        // SEARCH
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                searchQuery))
        {
            query["search"] =
                searchQuery.Trim();
        }


        // =================================
        // OPEN FILTER PANELS
        // =================================

        if (typeFilterOpen)
        {
            query["typeOpen"] =
                "1";
        }


        if (groupFilterOpen)
        {
            query["groupOpen"] =
                "1";
        }


        if (sourceFilterOpen)
        {
            query["sourceOpen"] =
                "1";
        }


        // =================================
        // TYPE
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                selectedCreatureType))
        {
            query["type"] =
                selectedCreatureType;
        }


        // =================================
        // GROUP
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                selectedGroup))
        {
            query["group"] =
                selectedGroup;
        }


        // =================================
        // SOURCE
        // =================================

        if (
            !string.IsNullOrWhiteSpace(
                selectedSource))
        {
            query["source"] =
                selectedSource;
        }


        return
            QueryHelpers.AddQueryString(
                "/bestiary",
                query);
    }


    // =====================================
    // SEARCH HELPER
    // =====================================

    private static bool ContainsSearch(
        string? value,
        string search)
    {
        return
            !string.IsNullOrWhiteSpace(
                value)
            &&
            value.Contains(
                search,
                StringComparison.OrdinalIgnoreCase);
    }


    // =====================================
    // DISPLAY ONE VALUE
    // =====================================

    private static string DisplayValue(
        string? value)
    {
        return
            string.IsNullOrWhiteSpace(
                value)

            ? "—"

            : value;
    }


    // =====================================
    // DISPLAY LIST
    // =====================================

    private static string DisplayList(
        IEnumerable<string> values)
    {
        var list =
            values
                .Where(
                    value =>
                        !string.IsNullOrWhiteSpace(
                            value))
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .ToList();


        return
            list.Count == 0

            ? "—"

            : string.Join(
                ", ",
                list);
    }


    // =====================================
    // QUERY BOOLEAN
    // =====================================

    private static bool QueryIsTrue(
        Dictionary<
            string,
            Microsoft.Extensions.Primitives.StringValues
        > query,
        string key)
    {
        return
            query.TryGetValue(
                key,
                out var value)
            &&
            value.FirstOrDefault()
                == "1";
    }


    // =====================================
    // QUERY STRING
    // =====================================

    private static string QueryValue(
        Dictionary<
            string,
            Microsoft.Extensions.Primitives.StringValues
        > query,
        string key)
    {
        return
            query.TryGetValue(
                key,
                out var value)

            ? value.FirstOrDefault()
                ?? string.Empty

            : string.Empty;
    }

