    // =====================================
    // SELECT TYPE
    // =====================================

    private void SelectCreatureType(
        CreatureTypeFilter creatureType)
    {
        if (
            string.Equals(
                selectedCreatureType,
                creatureType.Value,
                StringComparison.OrdinalIgnoreCase))
        {
            selectedCreatureType =
                string.Empty;
        }
        else
        {
            selectedCreatureType =
                creatureType.Value;
        }


        SyncUrl();
    }


    // =====================================
    // TYPE MATCH
    //
    // StartsWith means:
    //
    // Fiend
    //
    // also matches:
    //
    // fiend (yokai)
    // fiend (devil)
    // fiend (demon)
    //
    // etc.
    // =====================================

    private static bool MonsterMatchesType(
        StatBlockData monster,
        string selectedType)
    {
        var monsterType =
            monster.Creature?.Type
                ?.Trim()
            ??
            string.Empty;


        return
            monsterType.StartsWith(
                selectedType,
                StringComparison.OrdinalIgnoreCase);
    }


    // =====================================
    // MONSTER GROUPS
    //
    // Supports:
    //
    // "group": "Devil"
    //
    // and:
    //
    // "groups": [
    //   "Devil",
    //   "Infernal"
    // ]
    // =====================================

    private static IEnumerable<string>
        MonsterGroups(
            StatBlockData monster)
    {
        if (
            !string.IsNullOrWhiteSpace(
                monster.Group))
        {
            yield return
                monster.Group.Trim();
        }


        if (monster.Groups is not null)
        {
            foreach (
                var group
                in monster.Groups)
            {
                if (
                    !string.IsNullOrWhiteSpace(
                        group))
                {
                    yield return
                        group.Trim();
                }
            }
        }
    }


    // =====================================
    // MONSTER SOURCES
    //
    // Supports:
    //
    // "source": "Monster Manual"
    //
    // and:
    //
    // "sources": [
    //   "Monster Manual",
    //   "Royal Treasury"
    // ]
    // =====================================

    private static IEnumerable<string>
        MonsterSources(
            StatBlockData monster)
    {
        if (
            !string.IsNullOrWhiteSpace(
                monster.Source))
        {
            yield return
                monster.Source.Trim();
        }


        if (monster.Sources is not null)
        {
            foreach (
                var source
                in monster.Sources)
            {
                if (
                    !string.IsNullOrWhiteSpace(
                        source))
                {
                    yield return
                        source.Trim();
                }
            }
        }
    }


