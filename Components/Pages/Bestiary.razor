        if (!groupFilterOpen)
        {
            selectedGroup =
                string.Empty;
        }


        SyncUrl();
    }


    // =====================================
    // TOGGLE SOURCE
    //
    // Type and Group are unaffected.
    // =====================================

    private void ToggleSourceFilter()
