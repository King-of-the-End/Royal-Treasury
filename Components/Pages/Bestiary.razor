@page "/bestiary"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Web
@using Website_of_Everything.Models
@using Website_of_Everything.Services

@inject MonsterService MonsterService
@inject NavigationManager Navigation
@inject IJSRuntime JS


<PageTitle>
    Bestiary - Royal Treasury
</PageTitle>


<section class="spell-browser bestiary-browser">


    <!-- =====================================
         HEADER
         ===================================== -->

    <header class="spell-browser-header">

        <div class="landing-kicker">
            Compendium
        </div>


        <h1>
            Bestiary
        </h1>


        <p>
            Browse monsters by challenge rating,
            type, group, and source.
        </p>

    </header>


    <!-- =====================================
         MAIN FILTER BUTTONS
         ===================================== -->

    <div class="spell-filter-buttons">


        <!-- ALL MONSTERS -->

        <button
            type="button"
            class="@FilterButtonClass(AllFiltersClear)"
            @onclick="ClearMonsterFilters">

            All Monsters

        </button>


        <!-- MONSTERS BY TYPE -->

        <button
            type="button"
            class="@FilterButtonClass(typeFilterOpen)"
            @onclick="ToggleTypeFilter">

            Monsters by Type

        </button>


        <!-- MONSTERS BY GROUP -->

        <button
            type="button"
            class="@FilterButtonClass(groupFilterOpen)"
            @onclick="ToggleGroupFilter">

            Monsters by Group

        </button>


        <!-- MONSTERS BY SOURCE -->

        <button
            type="button"
            class="@FilterButtonClass(sourceFilterOpen)"
            @onclick="ToggleSourceFilter">

            Monsters by Source

        </button>

    </div>


    <!-- =====================================
         SEARCH
         ===================================== -->

    <SiteSearchBar
        Id="bestiary-search"
        Value="@searchQuery"
        ValueChanged="SearchChanged"
        Placeholder="Search monsters..."
        AriaLabel="Search monsters" />


    <!-- =====================================
         FILTER PANEL

         Type, Group, and Source are
         completely independent.

         Any or all may be open and active
         at the same time.
         ===================================== -->

    @if (
        typeFilterOpen
        ||
        groupFilterOpen
        ||
        sourceFilterOpen)
    {
        <div class="spell-filter-selects bestiary-filter-selects">


            <!-- =================================
                 TYPE
                 ================================= -->

            @if (typeFilterOpen)
            {
                <div class="
                    spell-filter-field
                    bestiary-type-filter-field">

                    <span>
                        Creature Type
                    </span>


                    <div class="bestiary-type-filter-buttons">

                        @foreach (
                            var creatureType
                            in CreatureTypes)
                        {
                            <button
                                type="button"
                                class="@TypeFilterButtonClass(
                                    creatureType)"
                                @onclick="() =>
                                    SelectCreatureType(
                                        creatureType)">

                                @creatureType.Label

                            </button>
                        }

                    </div>

                </div>
            }


            <!-- =================================
                 GROUP
                 ================================= -->

            @if (groupFilterOpen)
            {
                <label class="spell-filter-field">

                    <span>
                        Monster Group
                    </span>


                    <select
                        @bind="selectedGroup"
                        @bind:after="SyncUrl">

                        <option value="">
                            All Monster Groups
                        </option>


                        @foreach (
                            var group
                            in GroupOptions)
                        {
                            <option value="@group">
                                @group
                            </option>
                        }

                    </select>

                </label>
            }


            <!-- =================================
                 SOURCE
                 ================================= -->

            @if (sourceFilterOpen)
            {
                <label class="spell-filter-field">

                    <span>
                        Source
                    </span>


                    <select
                        @bind="selectedSource"
                        @bind:after="SyncUrl">

                        <option value="">
                            All Sources
                        </option>


                        @foreach (
                            var source
                            in SourceOptions)
                        {
                            <option value="@source">
                                @source
                            </option>
                        }

                    </select>

                </label>
            }

        </div>
    }


    <!-- =====================================
         CHALLENGE RATING TABS
         ===================================== -->

    <div
        class="bestiary-cr-tabs"
        role="tablist"
        aria-label="Challenge rating">


        @foreach (
            var cr
            in ChallengeRatings)
        {
            <button
                type="button"
                role="tab"
                aria-selected="@(
                    ActiveChallengeRating.Value
                    == cr.Value)"
                class="@ChallengeRatingTabClass(cr)"
                @onclick="() =>
                    SelectChallengeRatingAsync(cr)">

                @cr.Label

            </button>
        }

    </div>


    <!-- =====================================
         RESULTS
         ===================================== -->

    <section
        class="spell-results bestiary-results"
        role="tabpanel">


        <!-- =================================
             LOADING
             ================================= -->

        @if (isLoading)
        {
            <div class="spell-empty-state">

                Loading
                @ActiveChallengeRating.Label
                monsters...

            </div>
        }


        <!-- =================================
             LOAD ERROR
             ================================= -->

        @if (
            !isLoading
            &&
            !string.IsNullOrWhiteSpace(
                loadError))
        {
            <div class="spell-empty-state">

                @loadError

            </div>
        }


        <!-- =================================
             NO FILTER RESULTS
             ================================= -->

        @if (
            !isLoading
            &&
            string.IsNullOrWhiteSpace(
                loadError)
            &&
            !FilteredMonsters.Any())
        {
            <div class="spell-empty-state">

                No monsters match the current
                search and filters in
                @ActiveChallengeRating.Label.

            </div>
        }


        <!-- =================================
             MONSTER TABLE
             ================================= -->

        @if (
            !isLoading
            &&
            string.IsNullOrWhiteSpace(
                loadError)
            &&
            FilteredMonsters.Any())
        {
            <div class="spell-results-heading">

                <h2>
                    @ResultsHeading
                </h2>


                <span>

                    @FilteredMonsterCount

                    @(FilteredMonsterCount == 1
                        ? "monster"
                        : "monsters")

                </span>

            </div>


            <div class="spell-table-wrap bestiary-table-wrap">

                <table class="spell-table bestiary-table">


                    <!-- =========================
                         TABLE HEADER
                         ========================= -->

                    <thead>

                        <tr>

                            <th>
                                Name
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Alignment
                            </th>

                            <th>
                                Size
                            </th>

                            <th>
                                Source
                            </th>

                            <th>
                                Group
                            </th>

                        </tr>

                    </thead>


                    <!-- =========================
                         TABLE BODY
                         ========================= -->

                    <tbody>

                        @foreach (
                            var monster
                            in FilteredMonsters)
                        {
                            <tr
                                class="bestiary-table-row"
                                role="link"
                                tabindex="0"
                                aria-label="View @BestiaryMonsterName(monster)"
                                title="View @BestiaryMonsterName(monster)"
                                @onclick="() =>
                                    OpenMonster(monster)"
                                @onkeydown="args =>
                                    HandleMonsterRowKeyDown(
                                        args,
                                        monster)">


                                <!-- =====================
                                     NAME
                                     ===================== -->

                                <td class="spell-name-cell">

                                    <a
                                        class="bestiary-monster-link"
                                        href="@MonsterDetailsUrl(monster)"
                                        @onclick:stopPropagation="true">

                                        @BestiaryMonsterName(monster)

                                    </a>

                                </td>


                                <!-- =====================
                                     TYPE
                                     ===================== -->

                                <td
                                    class="bestiary-type-cell"
                                    @onclick:stopPropagation="true">

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            monster.Creature?.Type))
                                    {
                                        <GlossaryText
                                            Text="@monster.Creature.Type"
                                            Context="GlossaryContext.StatBlockCreatureLine" />
                                    }
                                    else
                                    {
                                        <span>
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- =====================
                                     ALIGNMENT
                                     ===================== -->

                                <td>

                                    @DisplayValue(
                                        monster.Creature?.Alignment)

                                </td>


                                <!-- =====================
                                     SIZE
                                     ===================== -->

                                <td>

                                    @DisplayValue(
                                        monster.Creature?.Size)

                                </td>


                                <!-- =====================
                                     SOURCE
                                     ===================== -->

                                <td>

                                    @DisplayList(
                                        MonsterSources(
                                            monster))

                                </td>


                                <!-- =====================
                                     GROUP
                                     ===================== -->

                                <td>

                                    @DisplayList(
                                        MonsterGroups(
                                            monster))

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</section>


@code {

    // =====================================
    // CHALLENGE RATING TAB
    // =====================================

    private sealed record ChallengeRatingTab(
        string Label,
        string Value,
        string FileName);


    // =====================================
    // CREATURE TYPE FILTER
    // =====================================

    private sealed record CreatureTypeFilter(
        string Label,
        string Value);


    // =====================================
    // CHALLENGE RATINGS
    // =====================================

    private static readonly IReadOnlyList<
        ChallengeRatingTab>
        ChallengeRatings =
            BuildChallengeRatings();


    // =====================================
    // CREATURE TYPES
    // =====================================

    private static readonly IReadOnlyList<
        CreatureTypeFilter>
        CreatureTypes =
            new[]
            {
                new CreatureTypeFilter(
                    "Aberration",
                    "Aberration"),

                new CreatureTypeFilter(
                    "Beast",
                    "Beast"),

                new CreatureTypeFilter(
                    "Celestial",
                    "Celestial"),

                new CreatureTypeFilter(
                    "Construct",
                    "Construct"),

                new CreatureTypeFilter(
                    "Dragon",
                    "Dragon"),

                new CreatureTypeFilter(
                    "Elemental",
                    "Elemental"),

                new CreatureTypeFilter(
                    "Fey",
                    "Fey"),

                new CreatureTypeFilter(
                    "Fiend",
                    "Fiend"),

                new CreatureTypeFilter(
                    "Giant",
                    "Giant"),

                new CreatureTypeFilter(
                    "Humanoid",
                    "Humanoid"),

                new CreatureTypeFilter(
                    "Monstrosity",
                    "Monstrosity"),

                new CreatureTypeFilter(
                    "Oozes",
                    "Ooze"),

                new CreatureTypeFilter(
                    "Plant",
                    "Plant"),

                new CreatureTypeFilter(
                    "Undead",
                    "Undead")
            };


    // =====================================
    // CURRENT MONSTERS
    // =====================================

    private IReadOnlyList<StatBlockData>
        monsters =
            Array.Empty<StatBlockData>();


    // =====================================
    // CURRENT CR
    // =====================================

    private string activeChallengeRating =
        "0";


    // =====================================
    // SEARCH
    // =====================================

    private string searchQuery =
        string.Empty;


    // =====================================
    // FILTER PANELS
    //
    // These are independent.
    // =====================================

    private bool typeFilterOpen;


    private bool groupFilterOpen;


    private bool sourceFilterOpen;


    // =====================================
    // FILTER VALUES
    // =====================================

    private string selectedCreatureType =
        string.Empty;


    private string selectedGroup =
        string.Empty;


    private string selectedSource =
        string.Empty;


    // =====================================
    // LOAD STATE
    // =====================================

    private bool isLoading;


    private string? loadError;


    // =====================================
    // ACTIVE CR
    // =====================================

    private ChallengeRatingTab
        ActiveChallengeRating =>
            ChallengeRatings
                .FirstOrDefault(
                    cr =>
                        string.Equals(
                            cr.Value,
                            activeChallengeRating,
                            StringComparison.OrdinalIgnoreCase))
            ??
            ChallengeRatings[0];


    // =====================================
    // ALL MONSTERS ACTIVE STATE
    // =====================================

    private bool AllFiltersClear =>
        !typeFilterOpen
        &&
        !groupFilterOpen
        &&
        !sourceFilterOpen
        &&
        string.IsNullOrWhiteSpace(
            selectedCreatureType)
        &&
        string.IsNullOrWhiteSpace(
            selectedGroup)
        &&
        string.IsNullOrWhiteSpace(
            selectedSource)
        &&
        string.IsNullOrWhiteSpace(
            searchQuery);


    // =====================================
    // AVAILABLE GROUPS
    //
    // Automatically generated from the
    // monsters in the selected CR.
    // =====================================

    private IEnumerable<string>
        GroupOptions =>
            monsters
                .SelectMany(
                    MonsterGroups)
                .Where(
                    value =>
                        !string.IsNullOrWhiteSpace(
                            value))
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(
                    value =>
                        value,
                    StringComparer.OrdinalIgnoreCase);


    // =====================================
    // AVAILABLE SOURCES
    // =====================================

    private IEnumerable<string>
        SourceOptions =>
            monsters
                .SelectMany(
                    MonsterSources)
                .Where(
                    value =>
                        !string.IsNullOrWhiteSpace(
                            value))
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(
                    value =>
                        value,
                    StringComparer.OrdinalIgnoreCase);


    // =====================================
    // RESULTS HEADING
    // =====================================

    private string ResultsHeading
    {
        get
        {
            var filters =
                new List<string>();


            // =================================
            // TYPE
            // =================================

            if (
                !string.IsNullOrWhiteSpace(
                    selectedCreatureType))
            {
                var type =
                    CreatureTypes
                        .FirstOrDefault(
                            value =>
                                value.Value.Equals(
                                    selectedCreatureType,
                                    StringComparison.OrdinalIgnoreCase));


                filters.Add(
                    type?.Label
                    ??
                    selectedCreatureType);
            }


            // =================================
            // GROUP
            // =================================

            if (
                !string.IsNullOrWhiteSpace(
                    selectedGroup))
            {
                filters.Add(
                    selectedGroup);
            }


            // =================================
            // SOURCE
            // =================================

            if (
                !string.IsNullOrWhiteSpace(
                    selectedSource))
            {
                filters.Add(
                    selectedSource);
            }


            if (filters.Count == 0)
            {
                return
                    ActiveChallengeRating.Label;
            }


            return
                $"{string.Join(
                    " • ",
                    filters)} — " +
                ActiveChallengeRating.Label;
        }
    }


    // =====================================
    // BESTIARY MONSTERS
    //
    // A monster JSON file can contain
    // several stat blocks that represent
    // variants of one Bestiary entry.
    //
    // Example:
    //
    // "Name": "Belzers"
    //
    // "Stat Blocks": [
    //   Ambush Belzer,
    //   Defense Belzer,
    //   Shielding Belzer,
    //   Shift Belzer,
    //   Targeting Belzer
    // ]
    //
    // Those variants should appear as ONE
    // Bestiary row. The detail page then
    // exposes the individual stat blocks as
    // Monster sub-tabs.
    // =====================================

    private IEnumerable<StatBlockData>
        BestiaryMonsters =>
            monsters
                .GroupBy(
                    BestiaryMonsterIdentity,
                    StringComparer.OrdinalIgnoreCase)
                .Select(
                    group =>
                        group.First());


    // =====================================
    // BESTIARY MONSTER IDENTITY
    //
    // Multi-stat-block documents inherit the
    // same MonsterSetName from their outer
    // JSON "Name" property.
    //
    // Single-stat-block monsters also have a
    // MonsterSetName, normally equal to their
    // own title, so they remain one row.
    // =====================================

    private static string
        BestiaryMonsterIdentity(
            StatBlockData monster)
    {
        if (
            !string.IsNullOrWhiteSpace(
                monster.MonsterSetName))
        {
            return
                monster.MonsterSetName.Trim();
        }


        if (
            !string.IsNullOrWhiteSpace(
                monster.Id))
        {
            return
                monster.Id.Trim();
        }


        return
            monster.Title.Trim();
    }


    // =====================================
    // BESTIARY DISPLAY NAME
    //
    // For a variant collection such as the
    // Belzers, use the outer monster name
    // rather than the first stat-block title.
    //
    // Belzers
    //
    // instead of:
    //
    // Ambush Belzer
    // =====================================

    private static string
        BestiaryMonsterName(
            StatBlockData monster)
    {
        return
            !string.IsNullOrWhiteSpace(
                monster.MonsterSetName)

            ? monster.MonsterSetName.Trim()

            : monster.Title;
    }


    // =====================================
    // VARIANTS FOR ONE BESTIARY ENTRY
    // =====================================

    private IEnumerable<StatBlockData>
        BestiaryMonsterVariants(
            StatBlockData monster)
    {
        var identity =
            BestiaryMonsterIdentity(
                monster);


        return
            monsters.Where(
                candidate =>
                    string.Equals(
                        BestiaryMonsterIdentity(
                            candidate),
                        identity,
                        StringComparison.OrdinalIgnoreCase));
    }


    // =====================================
    // FILTERED MONSTERS
    //
    // Search, Type, Group, and Source all
    // stack with one another.
    //
    // Filtering is performed against the
    // complete variant set while only ONE
    // representative row is returned.
    //
    // This means searching for:
    //
    // Defense Belzer
    //
    // still finds the single:
    //
    // Belzers
    //
    // Bestiary entry.
    // =====================================

    private IEnumerable<StatBlockData>
        FilteredMonsters
    {
        get
        {
            IEnumerable<StatBlockData>
                result =
                    BestiaryMonsters;


            // =================================
            // SEARCH
            // =================================

            if (
                !string.IsNullOrWhiteSpace(
                    searchQuery))
            {
                var search =
                    searchQuery.Trim();


                result =
                    result.Where(
                        monster =>
                            BestiaryMonsterVariants(
                                monster)
                                .Any(
                                    variant =>
                                        ContainsSearch(
                                            BestiaryMonsterName(
                                                variant),
                                            search)

                                        ||

                                        ContainsSearch(
                                            variant.Title,
                                            search)

                                        ||

                                        ContainsSearch(
                                            variant.Creature?.Type,
                                            search)

                                        ||

                                        ContainsSearch(
                                            variant.Creature?.Alignment,
                                            search)

                                        ||

                                        ContainsSearch(
                                            variant.Creature?.Size,
                                            search)

                                        ||

                                        MonsterGroups(
                                            variant)
                                            .Any(
                                                group =>
                                                    ContainsSearch(
                                                        group,
                                                        search))

                                        ||

                                        MonsterSources(
                                            variant)
                                            .Any(
                                                source =>
                                                    ContainsSearch(
                                                        source,
                                                        search))));
            }


            // =================================
            // TYPE
            // =================================

            if (
                !string.IsNullOrWhiteSpace(
                    selectedCreatureType))
            {
                result =
                    result.Where(
                        monster =>
                            BestiaryMonsterVariants(
                                monster)
                                .Any(
                                    variant =>
                                        MonsterMatchesType(
                                            variant,
                                            selectedCreatureType)));
            }


            // =================================
            // GROUP
            // =================================

            if (
                !string.IsNullOrWhiteSpace(
                    selectedGroup))
            {
                result =
                    result.Where(
                        monster =>
                            BestiaryMonsterVariants(
                                monster)
                                .Any(
                                    variant =>
                                        MonsterGroups(
                                            variant)
                                            .Any(
                                                group =>
                                                    string.Equals(
                                                        group,
                                                        selectedGroup,
                                                        StringComparison.OrdinalIgnoreCase))));
            }


            // =================================
            // SOURCE
            // =================================

            if (
                !string.IsNullOrWhiteSpace(
                    selectedSource))
            {
                result =
                    result.Where(
                        monster =>
                            BestiaryMonsterVariants(
                                monster)
                                .Any(
                                    variant =>
                                        MonsterSources(
                                            variant)
                                            .Any(
                                                source =>
                                                    string.Equals(
                                                        source,
                                                        selectedSource,
                                                        StringComparison.OrdinalIgnoreCase))));
            }


            // =================================
            // ALPHABETICAL ORDER
            // =================================

            return
                result.OrderBy(
                    monster =>
                        BestiaryMonsterName(
                            monster),
                    StringComparer.OrdinalIgnoreCase);
        }
    }


    // =====================================
    // RESULT COUNT
    // =====================================

    private int FilteredMonsterCount =>
        FilteredMonsters.Count();


    // =====================================
    // INITIAL LOAD
    // =====================================

    protected override async Task
        OnInitializedAsync()
    {
        RestoreStateFromUrl();


        await LoadActiveChallengeRatingAsync();
    }


    // =====================================
    // BUILD CR TABS
    // =====================================

    private static IReadOnlyList<
        ChallengeRatingTab>
        BuildChallengeRatings()
    {
        var result =
            new List<ChallengeRatingTab>
            {
                new(
                    "CR 0",
                    "0",
                    "CR0"),

                new(
                    "CR 1/8",
                    "0.125",
                    "CR0.125"),

                new(
                    "CR 1/4",
                    "0.25",
                    "CR0.25"),

                new(
                    "CR 1/2",
                    "0.5",
                    "CR0.5")
            };


        // =================================
        // CR 1 - CR 30
        // =================================

        for (
            var challengeRating = 1;
            challengeRating <= 30;
            challengeRating++)
        {
            result.Add(
                new ChallengeRatingTab(
                    $"CR {challengeRating}",
                    challengeRating.ToString(),
                    $"CR{challengeRating}"));
        }


        return result;
    }


    // =====================================
    // SELECT CR
    // =====================================

    private async Task
        SelectChallengeRatingAsync(
            ChallengeRatingTab cr)
    {
        if (
            string.Equals(
                activeChallengeRating,
                cr.Value,
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }


        activeChallengeRating =
            cr.Value;


        SyncUrl();


        await LoadActiveChallengeRatingAsync();
    }


    // =====================================
    // LOAD CURRENT CR
    // =====================================

    private async Task
        LoadActiveChallengeRatingAsync()
    {
        isLoading =
            true;


        loadError =
            null;


        monsters =
            Array.Empty<StatBlockData>();


        try
        {
            monsters =
                await MonsterService
                    .GetMonstersForChallengeRatingAsync(
                        ActiveChallengeRating.FileName);


            if (monsters.Count == 0)
            {
                loadError =
                    $"No monsters were found for " +
                    $"{ActiveChallengeRating.Label}.";
            }
        }
        catch (Exception ex)
        {
            loadError =
                $"Could not load " +
                $"{ActiveChallengeRating.Label}: " +
                ex.Message;
        }
        finally
        {
            isLoading =
                false;
        }
    }


    // =====================================
    // OPEN MONSTER
    // =====================================

    private async Task OpenMonster(
        StatBlockData monster)
    {
        await JS.InvokeVoidAsync(
            "royalTreasuryLoading.show");

        Navigation.NavigateTo(
            MonsterDetailsUrl(
                monster));
    }


    // =====================================
    // KEYBOARD ROW NAVIGATION
    // =====================================

    private void HandleMonsterRowKeyDown(
        KeyboardEventArgs args,
        StatBlockData monster)
    {
        if (
            args.Key.Equals(
                "Enter",
                StringComparison.OrdinalIgnoreCase)
            ||
            args.Key.Equals(
                " ",
                StringComparison.Ordinal))
        {
            _ = OpenMonster(
                monster);
        }
    }


    // =====================================
    // MONSTER DETAIL URL
    // =====================================

    private string MonsterDetailsUrl(
        StatBlockData monster)
    {
        var detailUrl =
            $"/bestiary/" +
            $"{Uri.EscapeDataString(
                ActiveChallengeRating.FileName)}/" +
            $"{Uri.EscapeDataString(
                MonsterSlug(monster))}";


        return
            QueryHelpers.AddQueryString(
                detailUrl,
                "returnUrl",
                BuildListUrl());
    }


    // =====================================
    // MONSTER SLUG
    // =====================================

    private static string MonsterSlug(
        StatBlockData monster)
    {
        var value =
            !string.IsNullOrWhiteSpace(
                monster.MonsterSetName)

            ? monster.MonsterSetName

            : !string.IsNullOrWhiteSpace(
                monster.Id)

                ? monster.Id

                : monster.Title;


        var result =
            new List<char>();


        var needsSeparator =
            false;


        foreach (
            var character
            in value.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character))
            {
                if (
                    needsSeparator
                    &&
                    result.Count > 0)
                {
                    result.Add('-');
                }


                result.Add(character);


                needsSeparator =
                    false;
            }
            else
            {
                needsSeparator =
                    result.Count > 0;
            }
        }


        return
            new string(
                result.ToArray());
    }


    // =====================================
    // SEARCH
    // =====================================

    private void SearchChanged(
        string value)
    {
        searchQuery =
            value;


        SyncUrl();
    }


    // =====================================
    // ALL MONSTERS
    //
    // Clears every Bestiary filter and the
    // search box.
    //
    // Does not change the selected CR.
    // =====================================

    private void ClearMonsterFilters()
    {
        typeFilterOpen =
            false;


        groupFilterOpen =
            false;


        sourceFilterOpen =
            false;


        selectedCreatureType =
            string.Empty;


        selectedGroup =
            string.Empty;


        selectedSource =
            string.Empty;


        searchQuery =
            string.Empty;


        SyncUrl();
    }


    // =====================================
    // TOGGLE TYPE
    //
    // Group and Source are unaffected.
    // =====================================

    private void ToggleTypeFilter()
    {
        typeFilterOpen =
            !typeFilterOpen;


        if (!typeFilterOpen)
        {
            selectedCreatureType =
                string.Empty;
        }


        SyncUrl();
    }


    // =====================================
    // TOGGLE GROUP
