@page "/feats"
@rendermode InteractiveServer

@using Website_of_Everything.Models
@using Website_of_Everything.Services

@inject CompendiumJsonService CompendiumJsonService

<PageTitle>Feats - Royal Treasury</PageTitle>

<section class="spell-browser feats-browser">
    <header class="spell-browser-header">
        <div class="landing-kicker">Compendium</div>
        <h1>Feats</h1>
        <p>Browse feats by type or source.</p>
    </header>

    <div class="spell-filter-buttons">
        <button
            type="button"
            class="@FilterButtonClass(!typeFilterOpen && !sourceFilterOpen && FiltersClear)"
            @onclick="ClearFilters">
            All Feats
        </button>

        <button
            type="button"
            class="@FilterButtonClass(typeFilterOpen)"
            @onclick="ToggleTypeFilter">
            Feats by Type
        </button>

        <button
            type="button"
            class="@FilterButtonClass(sourceFilterOpen)"
            @onclick="ToggleSourceFilter">
            Feats by Source
        </button>
    </div>

    <SiteSearchBar
        Id="feat-search"
        Value="@searchQuery"
        ValueChanged="SearchChanged"
        Placeholder="Search feats..."
        AriaLabel="Search feats" />

    @if (typeFilterOpen || sourceFilterOpen)
    {
        <div class="spell-filter-selects feats-filter-selects">
            @if (typeFilterOpen)
            {
                <label class="spell-filter-field">
                    <span>Feat Type</span>
                    <select @bind="selectedType">
                        <option value="">All Feat Types</option>
                        @foreach (var type in TypeOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </label>
            }

            @if (sourceFilterOpen)
            {
                <label class="spell-filter-field">
                    <span>Source</span>
                    <select @bind="selectedSource">
                        <option value="">All Sources</option>
                        @foreach (var source in SourceOptions)
                        {
                            <option value="@source">@source</option>
                        }
                    </select>
                </label>
            }
        </div>
    }

    <section class="spell-results">
        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="spell-empty-state">@loadError</div>
        }
        else if (!FilteredFeats.Any())
        {
            <div class="spell-empty-state">
                No feats match the current search and filters.
            </div>
        }
        else
        {
            <div class="spell-results-heading">
                <h2>Feats</h2>
                <span>
                    @FilteredFeats.Count()
                    @(FilteredFeats.Count() == 1 ? "feat" : "feats")
                </span>
            </div>

            <div class="spell-table-wrap">
                <table class="spell-table feats-table">
                    <thead>
                        <tr>
                            <th>Feat Name</th>
                            <th>Type</th>
                            <th>Prerequisite</th>
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var feat in FilteredFeats)
                        {
                            <tr class="spell-table-row">
                                <td class="spell-name-cell">@feat.Name</td>
                                <td>@DisplayOrDash(feat.Type)</td>
                                <td>@DisplayOrDash(feat.Prerequisite)</td>
                                <td>@DisplayOrDash(feat.Source)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

@code {
    private IReadOnlyList<CompendiumListEntry> feats =
        Array.Empty<CompendiumListEntry>();

    private string searchQuery = string.Empty;
    private string selectedType = string.Empty;
    private string selectedSource = string.Empty;
    private bool typeFilterOpen;
    private bool sourceFilterOpen;
    private string? loadError;

    private bool FiltersClear =>
        string.IsNullOrWhiteSpace(selectedType)
        && string.IsNullOrWhiteSpace(selectedSource);

    private IEnumerable<string> TypeOptions =>
        feats
            .Select(feat => feat.Type)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> SourceOptions =>
        feats
            .Select(feat => feat.Source)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<CompendiumListEntry> FilteredFeats
    {
        get
        {
            IEnumerable<CompendiumListEntry> result = feats;

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var search = searchQuery.Trim();
                result = result.Where(feat =>
                    feat.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || feat.Type.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || feat.Source.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || feat.Prerequisite.Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedType))
            {
                result = result.Where(feat =>
                    string.Equals(feat.Type, selectedType, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedSource))
            {
                result = result.Where(feat =>
                    string.Equals(feat.Source, selectedSource, StringComparison.OrdinalIgnoreCase));
            }

            return result.OrderBy(feat => feat.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            feats = await CompendiumJsonService.GetEntriesAsync("feats");

            if (feats.Count == 0)
            {
                loadError = "No feat JSON files were found in wwwroot/data/feats/.";
            }
        }
        catch (Exception ex)
        {
            loadError = $"The feat files could not be loaded: {ex.Message}";
        }
    }

    private void SearchChanged(string value)
    {
        searchQuery = value;
    }

    private void ClearFilters()
    {
        typeFilterOpen = false;
        sourceFilterOpen = false;
        selectedType = string.Empty;
        selectedSource = string.Empty;
        searchQuery = string.Empty;
    }

    private void ToggleTypeFilter()
    {
        typeFilterOpen = !typeFilterOpen;

        if (!typeFilterOpen)
        {
            selectedType = string.Empty;
        }
    }

    private void ToggleSourceFilter()
    {
        sourceFilterOpen = !sourceFilterOpen;

        if (!sourceFilterOpen)
        {
            selectedSource = string.Empty;
        }
    }

    private static string FilterButtonClass(bool active) =>
        active ? "spell-filter-button active" : "spell-filter-button";

    private static string DisplayOrDash(string value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;
}
