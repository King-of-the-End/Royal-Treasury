@page "/classes"

<PageTitle>Classes</PageTitle>

<section class="landing-page">

    <div class="landing-header">

        <div class="landing-kicker">
            Character Options
        </div>

        <h1>Classes</h1>

        <p class="landing-intro">
            Choose a class to explore its features, abilities, and progression.
        </p>

    </div>


    <div class="card-grid">

        @foreach (var characterClass in ClassCards)
        {
            <a class="landing-card"
               href="@($"/classes/{characterClass.Slug}")">

                <div class="card-icon class-emblem-icon">
                    <img src="@characterClass.ImagePath"
                         alt="@($"{characterClass.Name} class emblem")" />
                </div>

                <strong>
                    @characterClass.Name
                </strong>

            </a>
        }

    </div>

</section>


