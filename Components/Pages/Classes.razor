<style>

    /*
        The existing homepage CSS already styles:
        .landing-page
        .landing-header
        .landing-kicker
        .landing-intro
        .card-grid
        .landing-card
        .card-icon
        .landing-card strong

        These rules only add support for inline SVGs.
    */

    .card-icon {
        color: var(--gold);
    }


    .card-icon svg {
        width: 88%;
        height: 88%;

        display: block;

        overflow: visible;

        transition:
            transform 150ms ease,
            filter 150ms ease;
    }


    .landing-card:hover .card-icon svg {
        transform:
            scale(1.08);

        filter:
            drop-shadow(
                0 0 6px
                rgba(255, 214, 77, 0.4)
            );
    }


    /*
        Arbiter subtitle
    */

