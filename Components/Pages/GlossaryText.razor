@using Website_of_Everything.Models
@using Website_of_Everything.Services

@inject GlossaryService GlossaryService


<span class="glossary-text">

    @foreach (var segment in segments)
    {
        if (
            segment.Entry is not null
            &&
            !segment.Entry.NoOverlay)
        {
            <span
                class="glossary-term"
                tabindex="0">

                <span class="glossary-term-text">
                    @RenderText(segment.Text)
                </span>


                <span
                    class="glossary-tooltip"
                    role="tooltip">

                    <strong class="glossary-tooltip-title">
                        @segment.Entry.Term
                    </strong>


                    <span class="glossary-tooltip-definition">
                        @segment.Entry.Definition
                    </span>

                </span>

            </span>
        }
        else
        {
            @RenderText(segment.Text)
        }
    }

</span>


@code {

    // =====================================
    // INPUT TEXT
    // =====================================

    [Parameter]
    public string Text { get; set; } =
        string.Empty;


    // =====================================
    // GLOSSARY CONTEXT
    //
    // General
    // Spell
    // StatBlock
    // Subclass
    // =====================================

    [Parameter]
    public GlossaryContext Context { get; set; } =
        GlossaryContext.General;


    // =====================================
    // GENERATED TEXT SEGMENTS
    // =====================================

    private List<GlossarySegment> segments =
        new();


    // =====================================
    // PROCESS TEXT
    // =====================================

    protected override async Task
        OnParametersSetAsync()
    {
        var entries =
            await GlossaryService
                .GetEntriesAsync(
                    Context);


        segments =
            BuildSegments(
                Text,
                entries,
                Context);
    }


    // =====================================
    // BUILD TEXT SEGMENTS
    //
    // Ordinary text:
    //
    // Entry = null
    //
    // Glossary term:
    //
    // Entry = matching glossary entry
    //
    // Suppressed glossary phrase:
    //
    // Entry = matching glossary entry
    // NoOverlay = true
    //
    // The suppressed phrase still gets
    // matched so shorter glossary terms
    // cannot activate inside it.
    // =====================================

    private static List<GlossarySegment>
        BuildSegments(
            string text,
            IReadOnlyList<GlossaryEntry> entries,
            GlossaryContext context)
    {
        var result =
            new List<GlossarySegment>();


        // =================================
        // NOTHING TO PROCESS
        // =================================

        if (
            string.IsNullOrEmpty(text)
            ||
            entries.Count == 0)
        {
            result.Add(
                new GlossarySegment
                {
                    Text =
                        text
                });


            return result;
        }


        // =================================
        // POSITION TRACKING
        // =================================

        var plainStart =
            0;


        var index =
            0;


        // =================================
        // SCAN THROUGH TEXT
        // =================================

        while (
            index <
            text.Length)
        {
            GlossaryEntry? matchedEntry =
                null;


            var matchedLength =
                0;


            /*
             * Find the longest ACTUAL source
             * match at this character.
             *
             * This matters for quality-trait
             * patterns because the source text
             * can be longer or shorter than the
             * glossary title.
             *
             * Example title:
             *
             * Regen X (Y)
             *
             * Source:
             *
             * Regen 10 (radiant, eidolic)
             */
            foreach (
                var entry
                in entries)
            {
                foreach (
                    var matchPattern
                    in GetMatchPatterns(
                        entry))
                {
                    if (
                        TryMatchAt(
                            text,
                            index,
                            matchPattern,
                            entry.CaseSensitive,
                            context,
                            out var candidateLength)
                        &&
                        candidateLength >
                        matchedLength)
                    {
                        matchedEntry =
                            entry;


                        matchedLength =
                            candidateLength;
                    }
                }
            }


            // =================================
            // NO MATCH AT THIS CHARACTER
            // =================================

            if (
                matchedEntry
                is null
                ||
                matchedLength <= 0)
            {
                index++;

                continue;
            }


            // =================================
            // ADD ORDINARY TEXT BEFORE MATCH
            // =================================

            if (
                index >
                plainStart)
            {
                result.Add(
                    new GlossarySegment
                    {
                        Text =
                            text.Substring(
                                plainStart,
                                index -
                                plainStart)
                    });
            }


            // =================================
            // ADD GLOSSARY MATCH
            //
            // The exact source text is kept as
            // the visible text, while the popup
            // title remains matchedEntry.Term.
            //
            // Example:
            //
            // visible:
            // Amorphous (1 inch)
            //
            // popup title:
            // Amorphous (X)
            // =================================

            result.Add(
                new GlossarySegment
                {
                    Text =
                        text.Substring(
                            index,
                            matchedLength),

                    Entry =
                        matchedEntry
                });


            // =================================
            // SKIP PAST MATCH
            // =================================

            index +=
                matchedLength;


            plainStart =
                index;
        }


        // =================================
        // ADD REMAINING NORMAL TEXT
        // =================================

        if (
            plainStart <
            text.Length)
        {
            result.Add(
                new GlossarySegment
                {
                    Text =
                        text.Substring(
                            plainStart)
                });
        }


        return result;
    }


    // =====================================
    // MATCH PATTERNS FOR AN ENTRY
    //
    // Term is always the popup title.
    // Aliases are only alternate ways to
    // recognise the same glossary entry.
    // =====================================

    private static IEnumerable<string>
        GetMatchPatterns(
            GlossaryEntry entry)
    {
        if (
            !string.IsNullOrWhiteSpace(
                entry.Term))
        {
            yield return
                entry.Term;
        }


        if (
            entry.Aliases is null)
        {
            yield break;
        }


        foreach (
            var alias
            in entry.Aliases)
        {
            if (
                string.IsNullOrWhiteSpace(
                    alias)
                ||
                string.Equals(
                    alias,
                    entry.Term,
                    StringComparison.Ordinal))
            {
                continue;
            }


            yield return
                alias;
        }
    }


    // =====================================
    // CHECK FOR A MATCH AT POSITION
    // =====================================

    private static bool TryMatchAt(
        string text,
        int index,
        string pattern,
        bool caseSensitive,
        GlossaryContext context,
        out int matchLength)
    {
        matchLength =
            0;


        if (
            string.IsNullOrEmpty(
                pattern))
        {
            return false;
        }


        /*
         * Placeholder matching is deliberately
         * restricted to Quality Traits.
         *
         * This prevents an ordinary glossary
         * term containing a literal X, Y, or
         * Type from unexpectedly becoming a
         * wildcard elsewhere on the site.
         */
        var usePlaceholders =
            context ==
            GlossaryContext
                .StatBlockQualityTrait;


        if (
            usePlaceholders
            &&
            ContainsPlaceholder(
                pattern))
        {
            if (
                !TryMatchPlaceholderPattern(
                    text,
                    index,
                    pattern,
                    caseSensitive,
                    out matchLength))
            {
                return false;
            }
        }
        else
        {
            if (
                !TryMatchLiteral(
                    text,
                    index,
                    pattern,
                    caseSensitive))
            {
                return false;
            }


            matchLength =
                pattern.Length;
        }


        // =================================
        // LEFT WORD BOUNDARY
        // =================================

        if (
            NeedsLeftBoundary(
                pattern)
            &&
            index > 0
            &&
            IsWordCharacter(
                text[index - 1]))
        {
            matchLength =
                0;

            return false;
        }


        // =================================
        // RIGHT WORD BOUNDARY
        // =================================

        var end =
            index +
            matchLength;


        if (
            NeedsRightBoundary(
                pattern)
            &&
            end <
            text.Length
            &&
            IsWordCharacter(
                text[end]))
        {
            matchLength =
                0;

            return false;
        }


        return true;
    }


    // =====================================
    // LITERAL MATCH
    // =====================================

    private static bool TryMatchLiteral(
        string text,
        int index,
        string literal,
        bool caseSensitive)
    {
        if (
            index < 0
            ||
            index +
            literal.Length >
            text.Length)
        {
            return false;
        }


        var comparison =
            caseSensitive

            ? StringComparison.Ordinal

            : StringComparison.OrdinalIgnoreCase;


        return
            text.AsSpan(
                    index,
                    literal.Length)
                .Equals(
                    literal.AsSpan(),
                    comparison);
    }


    // =====================================
    // PLACEHOLDER PATTERN MATCHING
    //
    // Recognised placeholders:
    //
    // X
    // Y
    // Type
    //
    // Examples:
    //
    // Amorphous (X)
    // -> Amorphous (1 inch)
    //
    // Angelic (X)
    // -> Angelic (2d8)
    //
    // Critical X
    // -> Critical 19
    //
    // Regen X (Y)
    // -> Regen 10 (radiant, eidolic)
    //
    // Eidolos (Type)
    // -> Eidolos (Seraphael)
    // =====================================

    private static bool TryMatchPlaceholderPattern(
        string text,
        int index,
        string pattern,
        bool caseSensitive,
        out int matchLength)
    {
        matchLength =
            0;


        var tokens =
            ParsePatternTokens(
                pattern);


        if (
            tokens.Count == 0)
        {
            return false;
        }


        var comparison =
            caseSensitive

            ? StringComparison.Ordinal

            : StringComparison.OrdinalIgnoreCase;


        var textIndex =
            index;


        for (
            var tokenIndex = 0;
            tokenIndex < tokens.Count;
            tokenIndex++)
        {
            var token =
                tokens[tokenIndex];


            // =============================
            // LITERAL TOKEN
            // =============================

            if (!token.IsPlaceholder)
            {
                if (
                    !TryMatchLiteral(
                        text,
                        textIndex,
                        token.Text,
                        caseSensitive))
                {
                    return false;
                }


                textIndex +=
                    token.Text.Length;


                continue;
            }


            // =============================
            // PLACEHOLDER TOKEN
            //
            // It must consume at least one
            // non-whitespace character.
            // =============================

            var nextLiteral =
                string.Empty;


            for (
                var nextIndex =
                    tokenIndex + 1;
                nextIndex <
                    tokens.Count;
                nextIndex++)
            {
                if (
                    !tokens[nextIndex]
                        .IsPlaceholder
                    &&
                    tokens[nextIndex]
                        .Text.Length > 0)
                {
                    nextLiteral =
                        tokens[nextIndex]
                            .Text;

                    break;
                }
            }


            int placeholderEnd;


            if (
                !string.IsNullOrEmpty(
                    nextLiteral))
            {
                placeholderEnd =
                    text.IndexOf(
                        nextLiteral,
                        textIndex,
                        comparison);


                if (
                    placeholderEnd < 0)
                {
                    return false;
                }
            }
            else
            {
                placeholderEnd =
                    FindQualityTraitValueEnd(
                        text,
                        textIndex);
            }


            if (
                placeholderEnd <=
                textIndex)
            {
                return false;
            }


            var placeholderValue =
                text.Substring(
                        textIndex,
                        placeholderEnd -
                        textIndex)
                    .Trim();


            if (
                placeholderValue.Length == 0)
            {
                return false;
            }


            textIndex =
                placeholderEnd;
        }


        matchLength =
            textIndex -
            index;


        return
            matchLength > 0;
    }


    // =====================================
    // END OF A FINAL QUALITY-TRAIT VALUE
    //
    // Quality traits are rendered as a
    // comma-separated list. A comma inside
    // parentheses belongs to the current
    // value, so only a top-level comma ends
    // the trait.
    // =====================================

    private static int FindQualityTraitValueEnd(
        string text,
        int startIndex)
    {
        var parenthesisDepth =
            0;


        for (
            var index = startIndex;
            index < text.Length;
            index++)
        {
            var value =
                text[index];


            if (value == '(')
            {
                parenthesisDepth++;

                continue;
            }


            if (
                value == ')'
                &&
                parenthesisDepth > 0)
            {
                parenthesisDepth--;

                continue;
            }


            if (
                parenthesisDepth == 0
                &&
                (
                    value == ','
                    ||
                    value == ';'
                    ||
                    value == '\n'
                    ||
                    value == '\r'
                ))
            {
                return index;
            }
        }


        return
            text.Length;
    }


    // =====================================
    // PATTERN TOKENISATION
    // =====================================

    private static List<GlossaryPatternToken>
        ParsePatternTokens(
            string pattern)
    {
        var result =
            new List<GlossaryPatternToken>();


        var literalStart =
            0;


        var index =
            0;


        while (
            index <
            pattern.Length)
        {
            if (
                TryReadPlaceholder(
                    pattern,
                    index,
                    out var placeholderLength))
            {
                if (
                    index >
                    literalStart)
                {
                    result.Add(
                        new GlossaryPatternToken
                        {
                            Text =
                                pattern.Substring(
                                    literalStart,
                                    index -
                                    literalStart)
                        });
                }


                result.Add(
                    new GlossaryPatternToken
                    {
                        Text =
                            pattern.Substring(
                                index,
                                placeholderLength),

                        IsPlaceholder =
                            true
                    });


                index +=
                    placeholderLength;


                literalStart =
                    index;


                continue;
            }


            index++;
        }


        if (
            literalStart <
            pattern.Length)
        {
            result.Add(
                new GlossaryPatternToken
                {
                    Text =
                        pattern.Substring(
                            literalStart)
                });
        }


        return result;
    }


    // =====================================
    // DOES PATTERN CONTAIN A PLACEHOLDER?
    // =====================================

    private static bool ContainsPlaceholder(
        string pattern)
    {
        for (
            var index = 0;
            index < pattern.Length;
            index++)
        {
            if (
                TryReadPlaceholder(
                    pattern,
                    index,
                    out _))
            {
                return true;
            }
        }


        return false;
    }


    // =====================================
    // READ PLACEHOLDER
    //
    // A placeholder must be a standalone
    // word in the glossary title/pattern.
    // =====================================

    private static bool TryReadPlaceholder(
        string pattern,
        int index,
        out int length)
    {
        length =
            0;


        foreach (
            var placeholder
            in PlaceholderNames)
        {
            if (
                index +
                placeholder.Length >
                pattern.Length)
            {
                continue;
            }


            if (
                !pattern.AsSpan(
                        index,
                        placeholder.Length)
                    .Equals(
                        placeholder.AsSpan(),
                        StringComparison.Ordinal))
            {
                continue;
            }


            var leftIsWord =
                index > 0
                &&
                IsWordCharacter(
                    pattern[index - 1]);


            var rightIndex =
                index +
                placeholder.Length;


            var rightIsWord =
                rightIndex <
                pattern.Length
                &&
                IsWordCharacter(
                    pattern[rightIndex]);


            if (
                leftIsWord
                ||
                rightIsWord)
            {
                continue;
            }


            length =
                placeholder.Length;


            return true;
        }


        return false;
    }


    // =====================================
    // PLACEHOLDER NAMES
    // =====================================

    private static readonly string[]
        PlaceholderNames =
        {
            "Type",
            "X",
            "Y",
            "Z"
        };


    // =====================================
    // LEFT BOUNDARY REQUIRED?
    // =====================================

    private static bool NeedsLeftBoundary(
        string pattern)
    {
        return
            pattern.Length > 0
            &&
            IsWordCharacter(
                pattern[0]);
    }


    // =====================================
    // RIGHT BOUNDARY REQUIRED?
    // =====================================

    private static bool NeedsRightBoundary(
        string pattern)
    {
        if (
            pattern.Length == 0)
        {
            return false;
        }


        if (
            TryGetLastMeaningfulPatternCharacter(
                pattern,
                out var value))
        {
            return
                IsWordCharacter(
                    value);
        }


        return false;
    }


    // =====================================
    // LAST MEANINGFUL PATTERN CHARACTER
    //
    // If the pattern ends in a placeholder,
    // treat it as word-like because the
    // substituted source value normally ends
    // in a word/number.
    // =====================================

    private static bool
        TryGetLastMeaningfulPatternCharacter(
            string pattern,
            out char value)
    {
        value =
            default;


        if (
            pattern.Length == 0)
        {
            return false;
        }


        for (
            var index =
                pattern.Length - 1;
            index >= 0;
            index--)
        {
            if (
                char.IsWhiteSpace(
                    pattern[index]))
            {
                continue;
            }


            value =
                pattern[index];


            return true;
        }


        return false;
    }


    // =====================================
    // WORD CHARACTER
    // =====================================

    private static bool IsWordCharacter(
        char value)
    {
        return
            char.IsLetterOrDigit(
                value)
            ||
            value == '_';
    }


    // =====================================
    // INTERNAL PATTERN TOKEN
    // =====================================

    private sealed class GlossaryPatternToken
    {
        public string Text { get; set; } =
            string.Empty;


        public bool IsPlaceholder { get; set; }
    }


    // =====================================
    // RENDER SOURCE LINE BREAKS
    //
    // Converts actual newline characters
    // from JSON into <br> elements without
    // preserving Razor indentation.
    // =====================================

    private static Microsoft.AspNetCore.Components.RenderFragment
        RenderText(
            string text)
    {
        return builder =>
        {
            if (
                string.IsNullOrEmpty(
                    text))
            {
                return;
            }


            var lines =
                text
                    .Replace(
                        "\r\n",
                        "\n")
                    .Replace(
                        '\r',
                        '\n')
                    .Split(
                        '\n');


            var sequence =
                0;


            for (
                var i = 0;
                i < lines.Length;
                i++)
            {
                if (i > 0)
                {
                    builder.OpenElement(
                        sequence++,
                        "br");


                    builder.CloseElement();
                }


                builder.AddContent(
                    sequence++,
                    lines[i]);
            }
        };
    }


    // =====================================
    // INTERNAL TEXT SEGMENT
    // =====================================

    private sealed class GlossarySegment
    {
        public string Text { get; set; } =
            string.Empty;


        public GlossaryEntry? Entry { get; set; }
    }

}