@page "/spells/{LevelFolder}/{Slug}"
@rendermode InteractiveServer

@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using Website_of_Everything.Models
@using Website_of_Everything.Services

@inject SpellService SpellService
@inject NavigationManager Navigation


<PageTitle>
    @(spell is null
        ? "Spell"
        : spell.Name)
    - Royal Treasury
</PageTitle>


@if (loading)
{
    <section class="spell-detail-page">

        <div class="spell-empty-state">
            Loading spell...
        </div>

    </section>
}
else if (spell is null)
{
    <section class="spell-detail-page">

        <a
            class="spell-back-link"
            href="@BackUrl">

            ← Back to Spells

        </a>


        <div class="spell-empty-state">
            That spell could not be found.
        </div>

    </section>
}
else
{
    <article class="spell-detail-page">


        <!-- =================================
             BACK
             ================================= -->

        <a
            class="spell-back-link"
            href="@BackUrl">

            ← Back to Spells

        </a>


        <!-- =================================
             TITLE
             ================================= -->

        <header class="spell-detail-header">

            <div class="landing-kicker">

                @LevelLabel(spell.Level)
                ·
                @spell.SpellSchool

            </div>


            <h1 class="spell-detail-title">

                @if (HasRitualTag(spell))
                {
                    <img
                        class="spell-ritual-title-icon"
                        src="https://pub-bf21913a9572403eaaeb529e5bc42880.r2.dev/site-images/spells/ritual-tag.png"
                        alt="Ritual"
                        title="Ritual" />
                }


                <span>
                    @spell.Name
                </span>

            </h1>


            @if (
                spell.SpellGroups.Count > 0)
            {
                <div class="spell-detail-groups">

                    @foreach (
                        var group
                        in spell.SpellGroups)
                    {
                        <span>

                            <GlossaryText
                                Text="@group"
                                Context="GlossaryContext.Spell" />

                        </span>
                    }

                </div>
            }

        </header>


        <!-- =================================
             QUICK INFO
             ================================= -->

        <dl class="spell-detail-summary">


            <!-- =================================
                 CASTING TIME
                 ================================= -->

            <div>

                <dt>
                    Casting Time
                </dt>


                <dd class="spell-casting-time-value">

                    <span>

                        <GlossaryText
                            Text="@spell.CastingTime"
                            Context="GlossaryContext.Spell" />

                    </span>


                    @if (HasRitualTag(spell))
                    {
                        <span class="spell-ritual-badge">
                            Ritual
                        </span>
                    }

                </dd>

            </div>


            <!-- =================================
                 RANGE
                 ================================= -->

            <div>

                <dt>
                    Range
                </dt>

                <dd>

                    <GlossaryText
                        Text="@spell.Range"
                        Context="GlossaryContext.Spell" />

                </dd>

            </div>


            <!-- =================================
                 COMPONENTS
                 ================================= -->

            <div>

                <dt>
                    Components
                </dt>

                <dd>

                    <GlossaryText
                        Text="@spell.Components"
                        Context="GlossaryContext.Spell" />

                </dd>

            </div>


            <!-- =================================
                 DURATION
                 ================================= -->

            <div>

                <dt>
                    Duration
                </dt>

                <dd>

                    <GlossaryText
                        Text="@spell.Duration"
                        Context="GlossaryContext.Spell" />

                </dd>

            </div>


            <!-- =================================
                 CLASSES
                 ================================= -->

            <div>

                <dt>
                    Classes
                </dt>

                <dd>

                    <GlossaryText
                        Text="@DisplayClasses"
                        Context="GlossaryContext.Spell" />

                </dd>

            </div>


            <!-- =================================
                 SPELL GROUP
                 ================================= -->

            <div>

                <dt>
                    Spell Group
                </dt>

                <dd>

                    <GlossaryText
                        Text="@DisplaySpellGroups"
                        Context="GlossaryContext.Spell" />

                </dd>

            </div>

        </dl>


        <!-- =================================
             DESCRIPTION
             ================================= -->

        @if (
            !string.IsNullOrWhiteSpace(
                spell.Description))
        {
            <section class="spell-detail-section">

                <h2>
                    Description
                </h2>


                <p>

                    <GlossaryText
                        Text="@CleanMarkers(spell.Description)"
                        Context="GlossaryContext.Spell" />

                </p>


                <!-- TABLES AFTER DESCRIPTION -->

                @foreach (
                    var table
                    in TablesFor(
                        "Description"))
                {
                    <div class="spell-inline-table-wrap">


                        @if (
                            !string.IsNullOrWhiteSpace(
                                table.Title))
                        {
                            <h3>

                                <GlossaryText
                                    Text="@table.Title"
                                    Context="GlossaryContext.Spell" />

                            </h3>
                        }


                        <table class="spell-inline-table">

                            <thead>

                                <tr>

                                    @foreach (
                                        var column
                                        in table.Columns)
                                    {
                                        <th>

                                            <GlossaryText
                                                Text="@column"
                                                Context="GlossaryContext.Spell" />

                                        </th>
                                    }

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (
                                    var row
                                    in table.Rows)
                                {
                                    <tr>

                                        @foreach (
                                            var column
                                            in table.Columns)
                                        {
                                            <td>

                                                <GlossaryText
                                                    Text="@TableCell(row, column)"
                                                    Context="GlossaryContext.Spell" />

                                            </td>
                                        }

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }


        <!-- =================================
             STAT BLOCKS:
             AFTER DESCRIPTION
             ================================= -->

        @foreach (
            var statBlock
            in StatBlocksFor(
                "After Description"))
        {
            <StatBlock
                Data="@statBlock" />


            @if (
                !string.IsNullOrWhiteSpace(
                    statBlock.Image))
            {
                <div class="spell-statblock-image-wrap">

                    <img
                        class="spell-statblock-image"
                        src="@statBlock.Image"
                        alt="@($"{statBlock.Title} artwork")"
                        loading="lazy" />

                </div>
            }
        }


        <!-- =================================
             AT HIGHER LEVELS
             ================================= -->

        @if (
            !string.IsNullOrWhiteSpace(
                spell.AtHigherLevels))
        {
            <section class="spell-detail-section">

                <h2>
                    At Higher Levels
                </h2>


                <p>

                    <GlossaryText
                        Text="@CleanMarkers(spell.AtHigherLevels)"
                        Context="GlossaryContext.Spell" />

                </p>


                <!-- TABLES AFTER HIGHER LEVELS -->

                @foreach (
                    var table
                    in TablesFor(
                        "At Higher Levels"))
                {
                    <div class="spell-inline-table-wrap">


                        @if (
                            !string.IsNullOrWhiteSpace(
                                table.Title))
                        {
                            <h3>

                                <GlossaryText
                                    Text="@table.Title"
                                    Context="GlossaryContext.Spell" />

                            </h3>
                        }


                        <table class="spell-inline-table">

                            <thead>

                                <tr>

                                    @foreach (
                                        var column
                                        in table.Columns)
                                    {
                                        <th>

                                            <GlossaryText
                                                Text="@column"
                                                Context="GlossaryContext.Spell" />

                                        </th>
                                    }

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (
                                    var row
                                    in table.Rows)
                                {
                                    <tr>

                                        @foreach (
                                            var column
                                            in table.Columns)
                                        {
                                            <td>

                                                <GlossaryText
                                                    Text="@TableCell(row, column)"
                                                    Context="GlossaryContext.Spell" />

                                            </td>
                                        }

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }


        <!-- =================================
             STAT BLOCKS:
             AFTER HIGHER LEVELS
             ================================= -->

        @foreach (
            var statBlock
            in StatBlocksFor(
                "After Higher Levels"))
        {
            <StatBlock
                Data="@statBlock" />


            @if (
                !string.IsNullOrWhiteSpace(
                    statBlock.Image))
            {
                <div class="spell-statblock-image-wrap">

                    <img
                        class="spell-statblock-image"
                        src="@statBlock.Image"
                        alt="@($"{statBlock.Title} artwork")"
                        loading="lazy" />

                </div>
            }
        }


        <!-- =================================
             STAT BLOCKS:
             AFTER SPELL

             Also catches unknown or blank
             placement values so a stat block
             is never silently lost.
             ================================= -->

        @foreach (
            var statBlock
            in AfterSpellStatBlocks())
        {
            <StatBlock
                Data="@statBlock" />


            @if (
                !string.IsNullOrWhiteSpace(
                    statBlock.Image))
            {
                <div class="spell-statblock-image-wrap">

                    <img
                        class="spell-statblock-image"
                        src="@statBlock.Image"
                        alt="@($"{statBlock.Title} artwork")"
                        loading="lazy" />

                </div>
            }
        }


        <!-- =================================
             FUTURE / EXTRA JSON FIELDS
             ================================= -->

        @if (
            spell.ExtraFields is not null)
        {
            @foreach (
                var field
                in spell.ExtraFields
                    .OrderBy(
                        pair =>
                            pair.Key,
                        StringComparer
                            .OrdinalIgnoreCase))
            {
                <section class="spell-detail-section">

                    <h2>
                        @field.Key
                    </h2>


                    <p>

                        <GlossaryText
                            Text="@FormatJsonValue(field.Value)"
                            Context="GlossaryContext.Spell" />

                    </p>

                </section>
            }
        }

    </article>
}


@code {

    // =====================================
    // ROUTE PARAMETERS
    // =====================================

    [Parameter]
    public string LevelFolder { get; set; } =
        string.Empty;


    [Parameter]
    public string Slug { get; set; } =
        string.Empty;


    // =====================================
    // SPELL
    // =====================================

    private SpellData? spell;


    private bool loading =
        true;


    // =====================================
    // DISPLAY CLASSES
    // =====================================

    private string DisplayClasses =>
        spell is null
        ||
        spell.Classes.Count == 0

        ? "—"

        : string.Join(
            ", ",
            spell.Classes);


    // =====================================
    // DISPLAY SPELL GROUPS
    // =====================================

    private string DisplaySpellGroups =>
        spell is null
        ||
        spell.SpellGroups.Count == 0

        ? "—"

        : string.Join(
            ", ",
            spell.SpellGroups);


    // =====================================
    // BACK URL
    // =====================================

    private string BackUrl
    {
        get
        {
            var uri =
                Navigation.ToAbsoluteUri(
                    Navigation.Uri);


            var query =
                QueryHelpers.ParseQuery(
                    uri.Query);


            /*
             * Spells.razor passes its current
             * search / filter state through
             * returnUrl.
             */
            if (
                query.TryGetValue(
                    "returnUrl",
                    out var returnValue))
            {
                var returnUrl =
                    returnValue
                        .FirstOrDefault();


                /*
                 * Only permit an internal
                 * spells URL.
                 */
                if (
                    !string.IsNullOrWhiteSpace(
                        returnUrl)
                    &&
                    returnUrl.StartsWith(
                        "/spells",
                        StringComparison
                            .OrdinalIgnoreCase))
                {
                    return returnUrl;
                }
            }


            /*
             * Fallback when someone opens a
             * spell directly.
             */
            return
                $"/spells?level=" +
                $"{LevelFromFolder(
                    LevelFolder)}";
        }
    }


    // =====================================
    // LOAD SPELL
    // =====================================

    protected override async Task
        OnParametersSetAsync()
    {
        loading =
            true;


        spell =
            await SpellService
                .GetSpellAsync(
                    LevelFolder,
                    Slug);


        loading =
            false;
    }


    // =====================================
    // RITUAL
    // =====================================

    private static bool HasRitualTag(
        SpellData value)
    {
        return
            value.Tags.Any(
                tag =>
                    string.Equals(
                        tag,
                        "Ritual",
                        StringComparison
                            .OrdinalIgnoreCase));
    }


    // =====================================
    // TABLES
    // =====================================

    private IEnumerable<SpellTable>
        TablesFor(
            string placement)
    {
        return
            spell?.Tables.Where(
                table =>
                    string.Equals(
                        table.Placement,
                        placement,
                        StringComparison
                            .OrdinalIgnoreCase))
            ??
            Enumerable.Empty<SpellTable>();
    }


    // =====================================
    // STAT BLOCKS
    // =====================================

    private IEnumerable<StatBlockData>
        StatBlocksFor(
            string placement)
    {
        return
            spell?.StatBlocks.Where(
                statBlock =>
                    string.Equals(
                        statBlock.Placement,
                        placement,
                        StringComparison
                            .OrdinalIgnoreCase))
            ??
            Enumerable.Empty<StatBlockData>();
    }


    // =====================================
    // STAT BLOCKS AFTER SPELL
    // =====================================

    private IEnumerable<StatBlockData>
        AfterSpellStatBlocks()
    {
        if (spell is null)
        {
            return
                Enumerable.Empty<
                    StatBlockData>();
        }


        return
            spell.StatBlocks.Where(
                statBlock =>
                {
                    /*
                     * No placement was supplied.
                     *
                     * Still render it.
                     */
                    if (
                        string.IsNullOrWhiteSpace(
                            statBlock.Placement))
                    {
                        return true;
                    }


                    /*
                     * Explicitly after spell.
                     */
                    if (
                        string.Equals(
                            statBlock.Placement,
                            "After Spell",
                            StringComparison
                                .OrdinalIgnoreCase))
                    {
                        return true;
                    }


                    /*
                     * These placements were
                     * already rendered above.
                     */
                    if (
                        string.Equals(
                            statBlock.Placement,
                            "After Description",
                            StringComparison
                                .OrdinalIgnoreCase)
                        ||
                        string.Equals(
                            statBlock.Placement,
                            "After Higher Levels",
                            StringComparison
                                .OrdinalIgnoreCase))
                    {
                        return false;
                    }


                    /*
                     * Unknown future placement:
                     *
                     * render at the bottom rather
                     * than silently ignoring it.
                     */
                    return true;
                });
    }


    // =====================================
    // CLEAN SPECIAL MARKERS
    // =====================================

    private static string CleanMarkers(
        string text)
    {
        /*
         * Removes:
         *
         * {{TABLE:table_id}}
         *
         * and:
         *
         * {{STAT_BLOCK:stat_block_id}}
         *
         * because the matching structured
         * object is rendered separately.
         */
        return
            System.Text.RegularExpressions
                .Regex
                .Replace(
                    text,
                    @"\s*\{\{(?:TABLE|STAT_BLOCK):[^}]+\}\}\s*",
                    " ",
                    System.Text.RegularExpressions
                        .RegexOptions
                        .IgnoreCase)
                .Trim();
    }


    // =====================================
    // TABLE CELL
    // =====================================

    private static string TableCell(
        Dictionary<
            string,
            JsonElement
        > row,
        string column)
    {
        return
            row.TryGetValue(
                column,
                out var value)

            ? FormatJsonValue(
                value)

            : string.Empty;
    }


    // =====================================
    // JSON DISPLAY
    // =====================================

    private static string FormatJsonValue(
        JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String =>
                value.GetString()
                ?? string.Empty,

            JsonValueKind.Array =>
                string.Join(
                    ", ",
                    value
                        .EnumerateArray()
                        .Select(
                            FormatJsonValue)),

            JsonValueKind.True =>
                "Yes",

            JsonValueKind.False =>
                "No",

            JsonValueKind.Null =>
                string.Empty,

            JsonValueKind.Undefined =>
                string.Empty,

            _ =>
                value.ToString()
        };
    }


    // =====================================
    // LEVEL FROM FOLDER
    // =====================================

    private static int LevelFromFolder(
        string folder)
    {
        return
            folder.ToLowerInvariant()
                switch
                {
                    "cantrips" => 0,
                    "1st" => 1,
                    "2nd" => 2,
                    "3rd" => 3,
                    "4th" => 4,
                    "5th" => 5,
                    "6th" => 6,
                    "7th" => 7,
                    "8th" => 8,
                    "9th" => 9,
                    _ => 0
                };
    }


    // =====================================
    // LEVEL LABEL
    // =====================================

    private static string LevelLabel(
        int level)
    {
        return level switch
        {
            0 =>
                "Cantrip",

            1 =>
                "1st Level",

            2 =>
                "2nd Level",

            3 =>
                "3rd Level",

            _ =>
                $"{level}th Level"
        };
    }

}