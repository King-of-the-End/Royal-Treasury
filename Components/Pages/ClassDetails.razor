@page "/classes/{Slug}"
@rendermode InteractiveServer

@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using Website_of_Everything.Models
@using Website_of_Everything.Components
@implements IDisposable

@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation

<PageTitle>@DisplayName</PageTitle>

@if (isLoading)
{
    <main class="class-page"><div class="class-loading">Loading class...</div></main>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <main class="class-page">
        <a href="/classes" class="class-back-link">← Back to Classes</a>
        <div class="class-error"><h1>Class Not Found</h1><p>@errorMessage</p></div>
    </main>
}
else if (classDocument is not null)
{
    var root = classDocument.RootElement;

    <main class="class-page" id="overview">
        <a href="/classes" class="class-back-link">← Back to Classes</a>

        <header class="class-hero">
            <div class="class-hero-emblem">
                <img src="@EmblemPath" alt="@($"{DisplayName} class emblem")" />
            </div>
            <div class="class-hero-copy">
                <div class="class-kicker">Class</div>
                <h1>@DisplayName</h1>
            </div>
        </header>

        @if (GetString(root, "quote") is string quote)
        {
            <blockquote class="class-quote">@RenderGlossaryText(quote)</blockquote>
        }

        @if (GetProperty(root, "introduction") is JsonElement introduction)
        {
            <section class="class-lore-section">
                @foreach (var paragraph in introduction.EnumerateArray())
                {
                    <p>@RenderGlossaryText(ValueToText(paragraph))</p>
                }
            </section>
        }

        <div class="class-tabs">
            <div class="class-tab-buttons">
                <button type="button"
                        class="class-tab-button @(activeTab == "lore" ? "active" : "")"
                        @onclick='() => SetTab("lore")'>
                    <span class="class-tab-icon">◆</span><span>Lore / Roleplay</span>
                </button>
                <button type="button"
                        class="class-tab-button @(activeTab == "mechanics" ? "active" : "")"
                        @onclick='() => SetTab("mechanics")'>
                    <span class="class-tab-icon">⚔</span><span>Mechanics</span>
                </button>
            </div>

            @if (activeTab == "lore")
            {
                <div class="class-tab-content">
                    @if (GetProperty(root, "lore_sections") is JsonElement loreSections)
                    {
                        <div class="class-lore-grid">
                            @foreach (var section in loreSections.EnumerateArray())
                            {
                                <section class="class-section"
                                         id="@AnchorId(GetString(section, "title") ?? "section")">
                                    <h2>@GetString(section, "title")</h2>
                                    @if (GetProperty(section, "paragraphs") is JsonElement paragraphs)
                                    {
                                        @foreach (var paragraph in paragraphs.EnumerateArray())
                                        {
                                            <p>@RenderGlossaryText(ValueToText(paragraph))</p>
                                        }
                                    }
                                </section>
                            }
                        </div>
                    }

                    @if (GetProperty(root, "roleplay") is JsonElement roleplay)
                    {
                        @if (GetString(roleplay, "complexity_note") is string complexity)
                        {
                            <aside class="class-note class-note-warning" id="complexity">
                                <div class="class-note-heading">Complexity</div><p>@RenderGlossaryText(complexity)</p>
                            </aside>
                        }

                        @if (GetString(roleplay, "quick_build") is string quickBuild)
                        {
                            <section class="class-section" id="quick-build">
                                <div class="class-section-kicker">Character Creation</div>
                                <h2>Quick Build</h2><p>@RenderGlossaryText(quickBuild)</p>
                            </section>
                        }

                        @if (GetProperty(roleplay, "quirks") is JsonElement quirks)
                        {
                            <section class="class-section class-table-section" id="quirks">
                                <div class="class-section-kicker">Roleplaying</div>
                                <h2>Quirks</h2>
                                <div class="class-table-scroll">
                                    <table class="class-table quirks-table">
                                        <thead><tr><th>d20</th><th>Quirk</th></tr></thead>
                                        <tbody>
                                            @foreach (var quirk in quirks.EnumerateArray())
                                            {
                                                <tr><td class="table-level">@GetValueText(quirk, "d20")</td><td>@RenderGlossaryText(GetString(quirk, "quirk"))</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }

                        @if (GetProperty(roleplay, "dark_origin") is JsonElement darkOrigin)
                        {
                            <section class="class-section class-table-section" id="dark-origin">
                                <div class="class-section-kicker">Roleplaying</div>
                                <h2>Dark Origin</h2>

                                <div class="class-table-scroll">
                                    <table class="class-table quirks-table">
                                        <thead>
                                            <tr>
                                                <th>d6</th>
                                                <th>Origin</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var origin in darkOrigin.EnumerateArray())
                                            {
                                                <tr>
                                                    <td class="table-level">@GetValueText(origin, "d6")</td>
                                                    <td>@RenderGlossaryText(GetString(origin, "origin"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    }
                </div>
            }

            @if (activeTab == "mechanics")
            {
                <div class="class-tab-content">
                    @if (GetProperty(root, "mechanics_tabs") is JsonElement mechanicsTabs &&
                         mechanicsTabs.ValueKind == JsonValueKind.Array &&
                         mechanicsTabs.GetArrayLength() > 0)
                    {
                        <div class="class-mechanics-tab-buttons">
                            @for (var i = 0; i < mechanicsTabs.GetArrayLength(); i++)
                            {
                                var tabIndex = i;
                                var mechanicsTab = mechanicsTabs[i];
                                var label = GetString(mechanicsTab, "label") ?? $"Mechanics {i + 1}";
                                <button type="button"
                                        class="class-mechanics-tab-button @(activeMechanicsTabIndex == i ? "active" : "")"
                                        @onclick="() => SetMechanicsTab(tabIndex)">
                                    @label
                                </button>
                            }
                        </div>

                        var selectedIndex = Math.Clamp(activeMechanicsTabIndex, 0, mechanicsTabs.GetArrayLength() - 1);
                        var selectedTab = mechanicsTabs[selectedIndex];

                        @if (GetProperty(selectedTab, "mechanics") is JsonElement selectedMechanics)
                        {
                            @RenderMechanicsContent(selectedMechanics)
                        }
                    }
                    else if (GetProperty(root, "mechanics") is JsonElement mechanics)
                    {
                        @RenderMechanicsContent(mechanics)
                    }
                </div>
            }
        </div>
    </main>
}

@code {
    private static string GetItemBlockThemeClass(
    JsonElement block)
{
    // Explicit theme always wins.
    //
    // Example:
    // "theme": "blood"
    //
    // gives:
    // item-theme-blood

    var theme =
        GetString(block, "theme");

    if (!string.IsNullOrWhiteSpace(theme))
    {
        return
            $"item-theme-{ToSlug(theme)}";
    }


    // Otherwise use rarity automatically.

    var rarity =
        GetString(block, "rarity");

    if (!string.IsNullOrWhiteSpace(rarity))
    {
        return
            $"item-rarity-{ToSlug(rarity)}";
    }


    return "item-theme-default";
}
    [Parameter] public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "mechanicsTab")]
    public int? MechanicsTab { get; set; }

    private JsonDocument? classDocument;
    private string? loadedClassSlug;
    private bool isLoading = true;
    private string? errorMessage;
    private string activeTab = "lore";
    private int activeMechanicsTabIndex = 0;
    private string activeInvocationTab = "General";

    private string DisplayName
        => classDocument is not null && GetString(classDocument.RootElement, "name") is string name && !string.IsNullOrWhiteSpace(name)
            ? name
            : SlugToDisplayName(Slug);

    private const string ClassEmblemBaseUrl =
        "https://pub-bf21913a9572403eaaeb529e5bc42880.r2.dev/site-images/class-emblems/";

    private string EmblemPath
        => $"{ClassEmblemBaseUrl}{Uri.EscapeDataString($"Class Emblem - {DisplayName}.png")}";

    private void SetTab(string tab)
    {
        activeTab = tab;

        var uri = Navigation.GetUriWithQueryParameter(
            "tab",
            tab);

        Navigation.NavigateTo(
            uri,
            replace: true);
    }

    private void SetMechanicsTab(int index)
    {
        activeMechanicsTabIndex = index;

        var uri = Navigation.GetUriWithQueryParameters(
            new Dictionary<string, object?>
            {
                ["tab"] = "mechanics",
                ["mechanicsTab"] = index
            });

        Navigation.NavigateTo(
            uri,
            replace: true);
    }

    private RenderFragment RenderMechanicsContent(JsonElement mechanics) => builder =>
    {
        var seq = 0;

        if (GetProperty(mechanics, "multiclassing") is JsonElement multiclassing)
            builder.AddContent(seq++, RenderMulticlassing(multiclassing));

        if (GetProperty(mechanics, "advancement") is JsonElement advancement)
        {
            builder.OpenElement(seq++, "section");
            builder.AddAttribute(seq++, "class", "class-section class-table-section");
            builder.AddAttribute(seq++, "id", "advancement");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "class-section-kicker");
            builder.AddContent(seq++, "Advancement");
            builder.CloseElement();
            builder.OpenElement(seq++, "h2");
            builder.AddContent(seq++, $"The {DisplayName}");
            builder.CloseElement();
            builder.AddContent(seq++, RenderDynamicTable(advancement, "class-table"));
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "section");
        builder.AddAttribute(seq++, "class", "class-feature-chapter");
        builder.AddAttribute(seq++, "id", "class-features");
        builder.OpenElement(seq++, "header");
        builder.AddAttribute(seq++, "class", "class-chapter-heading");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-section-kicker");
        builder.AddContent(seq++, "Abilities");
        builder.CloseElement();
        builder.OpenElement(seq++, "h2");
        builder.AddContent(seq++, "Class Features");
        builder.CloseElement();
        builder.CloseElement();

        if (GetProperty(mechanics, "pre_feature_sections") is JsonElement preFeatureSections)
            foreach (var section in preFeatureSections.EnumerateArray())
                builder.AddContent(seq++, RenderPreFeatureSection(section));

        if (GetProperty(mechanics, "features") is JsonElement features)
        {
            foreach (var feature in features.EnumerateArray())
            {
                builder.AddContent(
                    seq++,
                    GetProperty(feature, "alternatives") is JsonElement
                        ? RenderEitherOrFeature(feature)
                        : RenderFeatureCard(feature));
            }
        }

        builder.CloseElement();

        if (GetProperty(mechanics, "appendices") is JsonElement appendices)
        {
            foreach (var appendix in appendices
                .EnumerateArray()
                .OrderBy(AppendixSortKey, StringComparer.OrdinalIgnoreCase))
            {
                builder.AddContent(seq++, RenderAppendix(appendix));
            }
        }
    };

    protected override async Task OnParametersSetAsync()
    {
        /*
         * Query-string changes switch the visible class tab/mechanics tab,
         * but they do not change the class JSON itself. Keep the already
         * parsed document when only ?tab= or ?mechanicsTab= changes.
         */
        activeMechanicsTabIndex = Math.Max(0, MechanicsTab ?? 0);
        activeTab =
            string.Equals(
                Tab,
                "mechanics",
                StringComparison.OrdinalIgnoreCase)
                ? "mechanics"
                : "lore";

        var safeSlug = Slug.Trim().ToLowerInvariant();

        if (!IsSafeSlug(safeSlug))
        {
            isLoading = false;
            errorMessage = "The requested class name is invalid.";
            return;
        }

        if (
            classDocument is not null
            && string.Equals(
                loadedClassSlug,
                safeSlug,
                StringComparison.OrdinalIgnoreCase))
        {
            isLoading = false;
            errorMessage = null;
            return;
        }

        isLoading = true;
        errorMessage = null;

        classDocument?.Dispose();
        classDocument = null;
        loadedClassSlug = null;

        try
        {

            var classesRoot = Path.Combine(Environment.WebRootPath, "data", "classes");
            if (!Directory.Exists(classesRoot))
            {
                errorMessage = "The classes data folder could not be found.";
                return;
            }

            // Find the folder case-insensitively so this also works on Linux/Render.
            // Resolve every class folder through the same slug-normalisation path.
            // This keeps Arbiter, hyphenated classes, and all other classes on one loader.
            var classFolderPath = Directory
                .EnumerateDirectories(classesRoot, "*", SearchOption.TopDirectoryOnly)
                .FirstOrDefault(path => string.Equals(
                    ToSlug(Path.GetFileName(path)),
                    safeSlug,
                    StringComparison.OrdinalIgnoreCase));

            if (classFolderPath is null)
            {
                errorMessage = $"No class folder was found for \"{Slug}\".";
                return;
            }

            var preferredNames = new[]
            {
                $"{safeSlug}.json",
                $"{safeSlug.Replace('-', '_')}.json",
                "class.json"
            };
            string? jsonFilePath = null;

            foreach (var preferredName in preferredNames)
            {
                jsonFilePath = Directory
                    .EnumerateFiles(classFolderPath, "*.json", SearchOption.TopDirectoryOnly)
                    .FirstOrDefault(path => string.Equals(Path.GetFileName(path), preferredName, StringComparison.OrdinalIgnoreCase));
                if (jsonFilePath is not null) break;
            }

            jsonFilePath ??= Directory
                .EnumerateFiles(classFolderPath, "*.json", SearchOption.TopDirectoryOnly)
                .OrderBy(path => path)
                .FirstOrDefault();

            if (jsonFilePath is null)
            {
                errorMessage = $"No class JSON file was found inside the {Path.GetFileName(classFolderPath)} folder.";
                return;
            }

            await using var stream = File.OpenRead(jsonFilePath);
            classDocument = await JsonDocument.ParseAsync(stream);
            loadedClassSlug = safeSlug;
        }
        catch (JsonException ex)
        {
            errorMessage = $"The class JSON could not be read: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"The class could not be loaded: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static JsonElement? GetProperty(JsonElement element, string name)
        => element.ValueKind == JsonValueKind.Object && element.TryGetProperty(name, out var property) ? property : null;

    private static string? GetString(JsonElement element, string name)
        => GetProperty(element, name) is JsonElement value && value.ValueKind == JsonValueKind.String ? value.GetString() : null;

    private static string GetValueText(JsonElement element, string name)
        => GetProperty(element, name) is JsonElement value ? ValueToText(value) : string.Empty;

    private static string ValueToText(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString() ?? string.Empty,
        JsonValueKind.Number => value.ToString(),
        JsonValueKind.True => "Yes",
        JsonValueKind.False => "No",
        JsonValueKind.Null => "—",
        JsonValueKind.Array => string.Join(", ", value.EnumerateArray().Select(ValueToText).Where(x => !string.IsNullOrWhiteSpace(x))),
        _ => value.ToString()
    };


    private RenderFragment RenderGlossaryText(string? text) => builder =>
    {
        var seq = 0;

        builder.OpenComponent<GlossaryText>(seq++);
        builder.AddAttribute(seq++, "Text", text ?? string.Empty);
        builder.AddAttribute(seq++, "Context", GlossaryContext.Class);
        builder.AddAttribute(seq++, "ClassPage", Slug);
        builder.CloseComponent();
    };

    private RenderFragment RenderMulticlassing(JsonElement multiclassing) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "section");
        builder.AddAttribute(seq++, "class", "class-section");
        builder.AddAttribute(seq++, "id", "multiclassing");
        if (GetString(multiclassing, "kicker") is string kicker) { builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-section-kicker"); builder.AddContent(seq++, kicker); builder.CloseElement(); }
        builder.OpenElement(seq++, "h2"); builder.AddContent(seq++, GetString(multiclassing, "title") ?? "Multiclassing"); builder.CloseElement();

        if (GetProperty(multiclassing, "paragraphs") is JsonElement paragraphs)
            builder.AddContent(seq++, RenderParagraphs(paragraphs));

        if (GetProperty(multiclassing, "items") is JsonElement items)
        {
            builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-stat-list");
            foreach (var item in items.EnumerateArray())
            {
                builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-stat-row");
                builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, GetString(item, "label")); builder.CloseElement();
                builder.OpenElement(seq++, "span"); builder.AddContent(seq++, RenderGlossaryText(GetValueText(item, "value"))); builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        if (GetProperty(multiclassing, "cards") is JsonElement cards)
        {
            builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-mini-grid");
            foreach (var card in cards.EnumerateArray())
            {
                builder.OpenElement(seq++, "article"); builder.AddAttribute(seq++, "class", "class-mini-card");
                builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, GetString(card, "title")); builder.CloseElement();
                builder.OpenElement(seq++, "p"); builder.AddContent(seq++, RenderGlossaryText(GetString(card, "text"))); builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private RenderFragment RenderPreFeatureSection(JsonElement section) => builder =>
    {
        var seq = 0;
        var type = GetString(section, "type") ?? "section";

        if (type == "basics" && GetProperty(section, "content") is JsonElement basics)
        {
            builder.OpenElement(seq++, "section");
            builder.AddAttribute(seq++, "class", "class-section class-basics");
            builder.AddAttribute(
                seq++,
                "id",
                AnchorId(GetString(basics, "title") ?? "class-basics"));
            if (GetString(basics, "kicker") is string kicker) { builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-section-kicker"); builder.AddContent(seq++, kicker); builder.CloseElement(); }
            builder.OpenElement(seq++, "h2"); builder.AddContent(seq++, GetString(basics, "title") ?? "Class Basics"); builder.CloseElement();

            if (GetProperty(basics, "groups") is JsonElement groups)
            {
                foreach (var group in groups.EnumerateArray())
                {
                    builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-subsection");
                    builder.OpenElement(seq++, "h3"); builder.AddContent(seq++, GetString(group, "title")); builder.CloseElement();

                    if (GetProperty(group, "stats") is JsonElement stats)
                    {
                        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-stat-list");
                        foreach (var stat in stats.EnumerateArray())
                        {
                            builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-stat-row");
                            builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, GetString(stat, "label")); builder.CloseElement();
                            builder.OpenElement(seq++, "span"); builder.AddContent(seq++, RenderGlossaryText(GetValueText(stat, "value"))); builder.CloseElement();
                            builder.CloseElement();
                        }
                        builder.CloseElement();
                    }

                    if (GetProperty(group, "items") is JsonElement items)
                        builder.AddContent(seq++, RenderList(items));

                    builder.CloseElement();
                }
            }
            builder.CloseElement();
            return;
        }

        if (type == "note")
        {
            builder.OpenElement(seq++, "aside");
            builder.AddAttribute(seq++, "class", "class-note");
            builder.AddAttribute(
                seq++,
                "id",
                AnchorId(GetString(section, "title") ?? "note"));

            if (GetString(section, "title") is string title)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "class-note-heading");
                builder.AddContent(seq++, title);
                builder.CloseElement();
            }

            if (GetProperty(section, "paragraphs") is JsonElement paragraphs)
                builder.AddContent(seq++, RenderParagraphs(paragraphs));

            if (GetProperty(section, "blocks") is JsonElement noteBlocks)
            {
                foreach (var block in noteBlocks.EnumerateArray())
                    builder.AddContent(seq++, RenderBlock(block));
            }

            builder.CloseElement();
            return;
        }

        var content = GetProperty(section, "content_section") ?? section;
        builder.OpenElement(seq++, "section");
        builder.AddAttribute(seq++, "class", "class-section");
        builder.AddAttribute(
            seq++,
            "id",
            AnchorId(GetString(content, "title") ?? "section"));
        if (GetString(content, "kicker") is string sectionKicker) { builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-section-kicker"); builder.AddContent(seq++, sectionKicker); builder.CloseElement(); }
        if (GetString(content, "title") is string sectionTitle) { builder.OpenElement(seq++, "h2"); builder.AddContent(seq++, sectionTitle); builder.CloseElement(); }
        if (GetProperty(content, "blocks") is JsonElement blocks)
            foreach (var block in blocks.EnumerateArray()) builder.AddContent(seq++, RenderBlock(block));
        builder.CloseElement();
    };

    private RenderFragment RenderFeatureCard(JsonElement feature) => builder =>
    {
        var seq = 0;

        // Native <details> gives every level-tagged feature click-to-collapse
        // behavior without needing extra Blazor state.
        builder.OpenElement(seq++, "details");
        builder.AddAttribute(seq++, "class", "class-feature");
        builder.AddAttribute(
            seq++,
            "id",
            AnchorId(GetString(feature, "name") ?? "feature"));
        builder.AddAttribute(seq++, "open", true);

        builder.OpenElement(seq++, "summary");
        builder.AddAttribute(seq++, "class", "class-feature-header");

        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, GetString(feature, "name"));
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-feature-header-actions");

        if (GetValueText(feature, "level") is string level && !string.IsNullOrWhiteSpace(level))
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "class-level-badge");
            builder.AddContent(seq++, $"Level {level}");
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "class-feature-chevron");
        builder.AddAttribute(seq++, "aria-hidden", "true");
        builder.AddContent(seq++, "⌄");
        builder.CloseElement();

        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-feature-body");

        if (GetString(feature, "subtitle") is string subtitle)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "class-prerequisite");
            builder.AddContent(seq++, subtitle);
            builder.CloseElement();
        }

        if (GetProperty(feature, "blocks") is JsonElement blocks)
        {
            var isFightingStyle = string.Equals(
                GetString(feature, "name"),
                "Fighting Style",
                StringComparison.OrdinalIgnoreCase);

            foreach (var block in blocks.EnumerateArray())
                builder.AddContent(
                    seq++,
                    isFightingStyle
                        ? RenderFightingStyleBlock(block)
                        : RenderBlock(block));
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderEitherOrFeature(JsonElement feature) => builder =>
    {
        var seq = 0;
        var name = GetString(feature, "name") ?? "Feature Choice";

        builder.OpenElement(seq++, "details");
        builder.AddAttribute(seq++, "class", "class-feature class-feature-choice");
        builder.AddAttribute(seq++, "id", AnchorId(name));
        builder.AddAttribute(seq++, "open", true);

        builder.OpenElement(seq++, "summary");
        builder.AddAttribute(seq++, "class", "class-feature-header");

        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, name);
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-feature-header-actions");

        if (GetValueText(feature, "level") is string level && !string.IsNullOrWhiteSpace(level))
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "class-level-badge");
            builder.AddContent(seq++, $"Level {level}");
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "class-feature-chevron");
        builder.AddAttribute(seq++, "aria-hidden", "true");
        builder.AddContent(seq++, "⌄");
        builder.CloseElement();

        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-feature-body");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-choice-label");
        builder.AddContent(seq++, GetString(feature, "choice_label") ?? "Choose One");
        builder.CloseElement();

        if (GetProperty(feature, "alternatives") is JsonElement alternatives &&
            alternatives.ValueKind == JsonValueKind.Array)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "class-feature-alternatives");

            var first = true;
            foreach (var alternative in alternatives.EnumerateArray())
            {
                if (!first)
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "class", "class-feature-or");
                    builder.AddContent(seq++, "OR");
                    builder.CloseElement();
                }

                builder.OpenElement(seq++, "article");
                builder.AddAttribute(seq++, "class", "class-feature-alternative");

                builder.OpenElement(seq++, "h4");
                builder.AddContent(seq++, GetString(alternative, "name") ?? "Option");
                builder.CloseElement();

                if (GetString(alternative, "subtitle") is string subtitle &&
                    !string.IsNullOrWhiteSpace(subtitle))
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "class", "class-prerequisite");
                    builder.AddContent(seq++, subtitle);
                    builder.CloseElement();
                }

                if (GetProperty(alternative, "blocks") is JsonElement blocks)
                {
                    foreach (var block in blocks.EnumerateArray())
                        builder.AddContent(seq++, RenderBlock(block));
                }

                builder.CloseElement();
                first = false;
            }

            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderAppendix(JsonElement appendix) => builder =>
    {
        var seq = 0;
        var title = GetString(appendix, "title") ?? "Appendix";
        var optionCards =
            string.Equals(
                GetString(appendix, "style"),
                "option-cards",
                StringComparison.OrdinalIgnoreCase)
            || string.Equals(
                title,
                "Artificer Infusions",
                StringComparison.OrdinalIgnoreCase)
            || GetProperty(appendix, "entries") is JsonElement;

        builder.OpenElement(seq++, "section");
        builder.AddAttribute(seq++, "class", optionCards ? "class-feature-chapter option-card-section" : "class-feature-chapter");
        builder.AddAttribute(seq++, "id", AnchorId(title));

        builder.OpenElement(seq++, "header");
        builder.AddAttribute(seq++, "class", "class-chapter-heading");
        if (GetString(appendix, "kicker") is string kicker)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "class-section-kicker");
            builder.AddContent(seq++, kicker);
            builder.CloseElement();
        }
        builder.OpenElement(seq++, "h2");
        builder.AddContent(seq++, title);
        builder.CloseElement();
        builder.CloseElement();

        if (GetProperty(appendix, "intro") is JsonElement intro)
            builder.AddContent(seq++, RenderParagraphs(intro));

        if (GetProperty(appendix, "intro_blocks") is JsonElement introBlocks)
            foreach (var block in introBlocks.EnumerateArray())
                builder.AddContent(seq++, RenderBlock(block));

        if (optionCards)
        {
            // Introductory/non-option blocks remain full-width above the cards.
            // Artificer Infusions are stored as ordinary paragraph + subsection
            // blocks, so paragraphs stay above while each subsection becomes a
            // collapsible option card.
            if (GetProperty(appendix, "blocks") is JsonElement leadingBlocks)
            {
                foreach (var block in leadingBlocks.EnumerateArray())
                {
                    var blockType = GetString(block, "type") ?? "paragraph";

                    if (blockType == "paragraph")
                    {
                        builder.AddContent(seq++, RenderBlock(block));
                        continue;
                    }

                    if (blockType != "options" && blockType != "subsection")
                        builder.AddContent(seq++, RenderBlock(block));
                }
            }

            if (string.Equals(title, "Eldritch Invocations", StringComparison.OrdinalIgnoreCase))
            {
                builder.AddContent(seq++, RenderInvocationTabs(appendix));
            }
            else
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "class-option-feature-list");

                // Collect every supported appendix-card shape first, then sort the
                // complete set by its displayed name. This keeps Infusions,
                // Magecraft options, Birthrights, and future option-card appendices
                // alphabetical regardless of their JSON order.
                foreach (var option in EnumerateAppendixOptionCards(appendix)
                    .OrderBy(AppendixSortKey, StringComparer.OrdinalIgnoreCase))
                {
                    builder.AddContent(seq++, RenderOptionCard(option));
                }

                builder.CloseElement();
            }
        }
        else
        {
            if (GetProperty(appendix, "blocks") is JsonElement blocks)
                foreach (var block in blocks.EnumerateArray())
                    builder.AddContent(seq++, RenderBlock(block));

            if (GetProperty(appendix, "features") is JsonElement features)
            {
                foreach (var feature in features
                    .EnumerateArray()
                    .OrderBy(AppendixSortKey, StringComparer.OrdinalIgnoreCase))
                {
                    builder.AddContent(seq++, RenderFeatureCard(feature));
                }
            }
        }

        builder.CloseElement();
    };

    private RenderFragment RenderInvocationTabs(JsonElement appendix) => builder =>
    {
        var seq = 0;
        var pactBoons = GetPactBoonNames();
        var options = EnumerateAppendixOptionCards(appendix)
            .OrderBy(AppendixSortKey, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var validTabs = new List<string> { "General" };
        validTabs.AddRange(pactBoons);

        if (!validTabs.Any(tab => string.Equals(tab, activeInvocationTab, StringComparison.OrdinalIgnoreCase)))
            activeInvocationTab = "General";

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-invocation-tabs");
        builder.AddAttribute(seq++, "role", "tablist");
        builder.AddAttribute(seq++, "aria-label", "Eldritch invocation groups");

        foreach (var tab in validTabs)
        {
            var tabName = tab;
            var isActive = string.Equals(activeInvocationTab, tabName, StringComparison.OrdinalIgnoreCase);

            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "role", "tab");
            builder.AddAttribute(seq++, "aria-selected", isActive);
            builder.AddAttribute(seq++, "class", $"class-invocation-tab-button{(isActive ? " active" : string.Empty)}");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => activeInvocationTab = tabName));
            builder.AddContent(seq++, InvocationTabLabel(tabName));
            builder.CloseElement();
        }

        builder.CloseElement();

        var visibleOptions = options
            .Where(option => InvocationBelongsToTab(option, activeInvocationTab, pactBoons))
            .ToList();

        if (visibleOptions.Count == 0)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "class-invocation-empty");
            builder.AddContent(seq++, "No eldritch invocations are currently listed for this Pact Boon.");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-option-feature-list class-invocation-list");

        foreach (var option in visibleOptions)
            builder.AddContent(seq++, RenderOptionCard(option));

        builder.CloseElement();
    };

    private List<string> GetPactBoonNames()
    {
        var result = new List<string>();

        if (classDocument is null)
            return result;

        var root = classDocument.RootElement;
        var mechanics = GetProperty(root, "mechanics");

        if (mechanics is not JsonElement mechanicsElement ||
            GetProperty(mechanicsElement, "features") is not JsonElement features ||
            features.ValueKind != JsonValueKind.Array)
        {
            return result;
        }

        foreach (var feature in features.EnumerateArray())
        {
            if (!string.Equals(GetString(feature, "name"), "Pact Boon", StringComparison.OrdinalIgnoreCase) ||
                GetProperty(feature, "blocks") is not JsonElement blocks ||
                blocks.ValueKind != JsonValueKind.Array)
            {
                continue;
            }

            foreach (var block in blocks.EnumerateArray())
            {
                if (!string.Equals(GetString(block, "type"), "options", StringComparison.OrdinalIgnoreCase))
                    continue;

                var options = GetProperty(block, "options") ?? GetProperty(block, "items");
                if (options is not JsonElement optionArray || optionArray.ValueKind != JsonValueKind.Array)
                    continue;

                foreach (var option in optionArray.EnumerateArray())
                {
                    var name = GetString(option, "name") ?? GetString(option, "title");
                    if (!string.IsNullOrWhiteSpace(name) && !result.Contains(name, StringComparer.OrdinalIgnoreCase))
                        result.Add(name);
                }
            }
        }

        return result;
    }

    private static bool InvocationBelongsToTab(JsonElement option, string tab, IReadOnlyList<string> pactBoons)
    {
        var prerequisite = GetString(option, "prerequisite") ?? string.Empty;

        if (string.Equals(tab, "General", StringComparison.OrdinalIgnoreCase))
            return !pactBoons.Any(boon => PrerequisiteMentionsBoon(prerequisite, boon));

        return PrerequisiteMentionsBoon(prerequisite, tab);
    }

    private static bool PrerequisiteMentionsBoon(string prerequisite, string boon)
    {
        if (string.IsNullOrWhiteSpace(prerequisite) || string.IsNullOrWhiteSpace(boon))
            return false;

        var normalizedBoon = boon;
        var parenthesisIndex = normalizedBoon.IndexOf(" (", StringComparison.Ordinal);
        if (parenthesisIndex >= 0)
            normalizedBoon = normalizedBoon[..parenthesisIndex];

        return prerequisite.Contains(normalizedBoon, StringComparison.OrdinalIgnoreCase);
    }

    private static string InvocationTabLabel(string tab)
    {
        if (string.Equals(tab, "General", StringComparison.OrdinalIgnoreCase))
            return "General";

        const string prefix = "Pact of the ";
        return tab.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? tab[prefix.Length..]
            : tab;
    }

    private static string AppendixSortKey(JsonElement element)
        => GetString(element, "name")
            ?? GetString(element, "title")
            ?? string.Empty;

    private static IEnumerable<JsonElement> EnumerateAppendixOptionCards(JsonElement appendix)
    {
        if (GetProperty(appendix, "blocks") is JsonElement blocks &&
            blocks.ValueKind == JsonValueKind.Array)
        {
            foreach (var block in blocks.EnumerateArray())
            {
                var blockType = GetString(block, "type") ?? "paragraph";

                if (string.Equals(blockType, "options", StringComparison.OrdinalIgnoreCase))
                {
                    var options = GetProperty(block, "options") ?? GetProperty(block, "items");
                    if (options is JsonElement items && items.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var option in items.EnumerateArray())
                            yield return option;
                    }
                }
                else if (string.Equals(blockType, "subsection", StringComparison.OrdinalIgnoreCase))
                {
                    // Artificer Infusions and similar appendices store each card
                    // directly as a subsection rather than inside an options array.
                    yield return block;
                }
            }
        }

        // Alternate Artificer JSON shape: appendices[].entries[]
        if (GetProperty(appendix, "entries") is JsonElement entries &&
            entries.ValueKind == JsonValueKind.Array)
        {
            foreach (var entry in entries.EnumerateArray())
                yield return entry;
        }

        // Arbiter birthrights historically use appendix.features.
        if (GetProperty(appendix, "features") is JsonElement features &&
            features.ValueKind == JsonValueKind.Array)
        {
            foreach (var feature in features.EnumerateArray())
                yield return feature;
        }
    }

    private RenderFragment RenderOptionCard(JsonElement option) => builder =>
    {
        var seq = 0;
        var name = GetString(option, "name") ?? GetString(option, "title") ?? "Option";

        // IMPORTANT:
        // End-of-file option cards deliberately use the SAME markup/classes
        // as the normal level-tagged feature cards. This means Birthrights,
        // Infusions, Focus Arts, Finishers, Techniques, Magecraft Features,
        // and any future "option-cards" appendix inherit the exact same CSS
        // and native <details> collapsing behaviour.
        builder.OpenElement(seq++, "details");
        builder.AddAttribute(seq++, "class", "class-feature class-option-feature");
        builder.AddAttribute(seq++, "open", true);

        builder.OpenElement(seq++, "summary");
        builder.AddAttribute(seq++, "class", "class-feature-header");

        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, name);
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-feature-header-actions");

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "class-feature-chevron");
        builder.AddAttribute(seq++, "aria-hidden", "true");
        builder.AddContent(seq++, "⌄");
        builder.CloseElement();

        builder.CloseElement(); // .class-feature-header-actions
        builder.CloseElement(); // summary

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-feature-body");

        if (GetString(option, "prerequisite") is string prereq && !string.IsNullOrWhiteSpace(prereq))
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "class-prerequisite");
            builder.AddContent(seq++, $"Prerequisite: {prereq}");
            builder.CloseElement();
        }
        else if (GetString(option, "subtitle") is string subtitle && !string.IsNullOrWhiteSpace(subtitle))
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "class-prerequisite");
            builder.AddContent(seq++, subtitle);
            builder.CloseElement();
        }

        if (GetProperty(option, "paragraphs") is JsonElement paragraphs)
            builder.AddContent(seq++, RenderParagraphs(paragraphs));

        // Artificer entry-shaped JSON stores the infused object separately.
        if (GetString(option, "item") is string item && !string.IsNullOrWhiteSpace(item))
        {
            builder.OpenElement(seq++, "p");
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, "Item: ");
            builder.CloseElement();
            builder.AddContent(seq++, RenderGlossaryText(item));
            builder.CloseElement();
        }

        // Artificer entry-shaped JSON stores its body as "description".
        if (GetProperty(option, "description") is JsonElement description)
            builder.AddContent(seq++, RenderParagraphs(description));

        if (GetProperty(option, "items") is JsonElement listItems)
            builder.AddContent(seq++, RenderList(listItems));

        if (GetProperty(option, "blocks") is JsonElement blocks)
        {
            foreach (var block in blocks.EnumerateArray())
                builder.AddContent(seq++, RenderBlock(block));
        }

        if (GetProperty(option, "note") is JsonElement note)
        {
            builder.OpenElement(seq++, "aside");
            builder.AddAttribute(seq++, "class", "class-note class-note-variant");

            if (GetString(note, "title") is string noteTitle)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "class-note-heading");
                builder.AddContent(seq++, noteTitle);
                builder.CloseElement();
            }

            if (GetProperty(note, "paragraphs") is JsonElement noteParagraphs)
                builder.AddContent(seq++, RenderParagraphs(noteParagraphs));

            builder.CloseElement();
        }

        builder.CloseElement(); // .class-feature-body
        builder.CloseElement(); // details
    };

    private RenderFragment RenderFightingStyleBlock(JsonElement block) => builder =>
    {
        var seq = 0;
        var type = GetString(block, "type") ?? "paragraph";

        if (type == "options")
        {
            var options = GetProperty(block, "options") ?? GetProperty(block, "items");
            if (options is JsonElement optionItems && optionItems.ValueKind == JsonValueKind.Array)
            {
                builder.OpenElement(seq++, "ul");
                builder.AddAttribute(seq++, "class", "class-list class-fighting-style-list");
                foreach (var option in optionItems.EnumerateArray())
                {
                    var name = option.ValueKind == JsonValueKind.Object
                        ? GetString(option, "name") ?? GetString(option, "title") ?? ValueToText(option)
                        : ValueToText(option);
                    if (string.IsNullOrWhiteSpace(name)) continue;
                    builder.OpenElement(seq++, "li");
                    builder.AddContent(seq++, RenderGlossaryText(name));
                    builder.CloseElement();
                }
                builder.CloseElement();
            }
            return;
        }

        builder.AddContent(seq++, RenderBlock(block));
    };

private RenderFragment RenderBlock(JsonElement block) => builder =>
{
    var seq = 0;
    var type = GetString(block, "type") ?? "paragraph";

    if (type == "paragraph")
    {
        builder.OpenElement(seq++, "p");
        builder.AddContent(
            seq++,
            RenderGlossaryText(
                GetString(block, "text")));
        builder.CloseElement();
        return;
    }

    if (type is "item_block" or "itemblock")
{
    var title =
        GetString(block, "title")
        ?? GetString(block, "name")
        ?? "Item";

    var itemType =
        GetString(block, "item_type")
        ?? GetString(block, "category");

    var rarity =
        GetString(block, "rarity");

    var theme =
        GetString(block, "theme");

    var prerequisite =
        GetString(block, "prerequisite");


    var stats =
        GetProperty(block, "stats")
        ?? default(JsonElement);


    RenderFragment itemContent =
        childBuilder =>
        {
            var childSeq = 0;


            if (
                GetProperty(
                    block,
                    "paragraphs")
                is JsonElement paragraphs)
            {
                childBuilder.AddContent(
                    childSeq++,
                    RenderParagraphs(
                        paragraphs));
            }


            if (
                GetProperty(
                    block,
                    "blocks")
                is JsonElement blocks
                && blocks.ValueKind
                    == JsonValueKind.Array)
            {
                foreach (
                    var child
                    in blocks.EnumerateArray())
                {
                    childBuilder.AddContent(
                        childSeq++,
                        RenderBlock(child));
                }
            }
        };


    builder.OpenComponent<ItemBlock>(
        seq++);


    builder.AddAttribute(
        seq++,
        "Title",
        title);


    builder.AddAttribute(
        seq++,
        "ItemType",
        itemType);


    builder.AddAttribute(
        seq++,
        "Rarity",
        rarity);


    builder.AddAttribute(
        seq++,
        "Theme",
        theme);


    builder.AddAttribute(
        seq++,
        "Prerequisite",
        prerequisite);


    builder.AddAttribute(
        seq++,
        "Stats",
        stats);


    builder.AddAttribute(
        seq++,
        "ChildContent",
        itemContent);


    builder.CloseComponent();

    return;
}

    if (type is "section" or "subsection")
    {
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-feature-subsection");

        if (GetString(block, "title") is string title)
        {
            builder.OpenElement(seq++, "h4");
            builder.AddContent(seq++, title);
            builder.CloseElement();
        }

        if (GetProperty(block, "paragraphs") is JsonElement paragraphs)
        {
            builder.AddContent(
                seq++,
                RenderParagraphs(paragraphs));
        }

        if (GetProperty(block, "blocks") is JsonElement children)
        {
            foreach (var child in children.EnumerateArray())
            {
                builder.AddContent(
                    seq++,
                    RenderBlock(child));
            }
        }

        builder.CloseElement();
        return;
    }

    if (type == "heading")
    {
        builder.OpenElement(seq++, "h4");
        builder.AddContent(seq++, GetString(block, "text"));
        builder.CloseElement();
        return;
    }

    if (type == "list")
    {
        if (GetProperty(block, "items") is JsonElement items)
        {
            builder.AddContent(
                seq++,
                RenderList(items));
        }

        return;
    }

    if (type == "note")
    {
        builder.OpenElement(seq++, "aside");
        builder.AddAttribute(seq++, "class", "class-note");

        if (GetString(block, "title") is string title)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(
                seq++,
                "class",
                "class-note-heading");

            builder.AddContent(seq++, title);
            builder.CloseElement();
        }

        if (GetString(block, "text") is string text)
        {
            builder.OpenElement(seq++, "p");
            builder.AddContent(seq++, RenderGlossaryText(text));
            builder.CloseElement();
        }

        if (GetProperty(block, "paragraphs") is JsonElement paragraphs)
        {
            builder.AddContent(
                seq++,
                RenderParagraphs(paragraphs));
        }

        builder.CloseElement();
        return;
    }

    if (type is "formula" or "formulas")
    {
        var formulas =
            GetProperty(
                block,
                "formula_items");

        if (formulas is JsonElement formulaItems)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(
                seq++,
                "class",
                "class-formula-grid");

            foreach (
                var formula
                in formulaItems.EnumerateArray())
            {
                builder.AddContent(
                    seq++,
                    RenderFormula(formula));
            }

            builder.CloseElement();
        }
        else
        {
            builder.AddContent(
                seq++,
                RenderFormula(block));
        }

        return;
    }

    // =====================================
    // STAT BLOCK
    //
    // Allows class JSON to use the same
    // StatBlock component as Bestiary
    // creatures.
    //
    // Supported:
    //
    // {
    //   "type": "stat_block",
    //   "data": { ... }
    // }
    //
    // or:
    //
    // {
    //   "type": "statblock",
    //   "data": { ... }
    // }
    // =====================================

    if (type is "statblock" or "stat_block")
    {
        var statBlockElement =
            GetProperty(block, "data")
            ?? GetProperty(block, "statblock")
            ?? block;

        var statBlockData =
            JsonSerializer.Deserialize<StatBlockData>(
                statBlockElement.GetRawText());

        if (statBlockData is not null)
        {
            builder.OpenComponent<StatBlock>(seq++);

            builder.AddAttribute(
                seq++,
                "Data",
                statBlockData);

            builder.CloseComponent();
        }

        return;
    }

    if (type == "stats")
    {
        if (GetProperty(block, "items") is JsonElement items)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(
                seq++,
                "class",
                "class-stat-list");

            foreach (var item in items.EnumerateArray())
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(
                    seq++,
                    "class",
                    "class-stat-row");

                builder.OpenElement(seq++, "strong");
                builder.AddContent(
                    seq++,
                    GetString(item, "label"));
                builder.CloseElement();

                builder.OpenElement(seq++, "span");
                builder.AddContent(
                    seq++,
                    RenderGlossaryText(
                        GetValueText(item, "value")));
                builder.CloseElement();

                builder.CloseElement();
            }

            builder.CloseElement();
        }

        return;
    }

    if (type == "options")
    {
        var options =
            GetProperty(block, "options")
            ?? GetProperty(block, "items");

        if (options is JsonElement optionItems)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(
                seq++,
                "class",
                "class-options");

            foreach (
                var option
                in optionItems.EnumerateArray())
            {
                builder.OpenElement(seq++, "article");
                builder.AddAttribute(
                    seq++,
                    "class",
                    "class-option");

                builder.OpenElement(seq++, "h4");
                builder.AddContent(
                    seq++,
                    GetString(option, "name"));
                builder.CloseElement();

                if (
                    GetString(
                        option,
                        "prerequisite")
                    is string prereq)
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(
                        seq++,
                        "class",
                        "class-prerequisite");

                    builder.AddContent(
                        seq++,
                        $"Prerequisite: {prereq}");

                    builder.CloseElement();
                }

                if (
                    GetProperty(
                        option,
                        "paragraphs")
                    is JsonElement paragraphs)
                {
                    builder.AddContent(
                        seq++,
                        RenderParagraphs(paragraphs));
                }

                if (
                    GetProperty(
                        option,
                        "items")
                    is JsonElement items)
                {
                    builder.AddContent(
                        seq++,
                        RenderList(items));
                }

                if (
                    GetProperty(
                        option,
                        "blocks")
                    is JsonElement optionBlocks)
                {
                    foreach (
                        var child
                        in optionBlocks.EnumerateArray())
                    {
                        builder.AddContent(
                            seq++,
                            RenderBlock(child));
                    }
                }

                if (
                    GetProperty(
                        option,
                        "note")
                    is JsonElement note)
                {
                    var noteBlock = note;

                    builder.OpenElement(seq++, "aside");
                    builder.AddAttribute(
                        seq++,
                        "class",
                        "class-note class-note-variant");

                    if (
                        GetString(
                            noteBlock,
                            "title")
                        is string noteTitle)
                    {
                        builder.OpenElement(seq++, "div");
                        builder.AddAttribute(
                            seq++,
                            "class",
                            "class-note-heading");

                        builder.AddContent(
                            seq++,
                            noteTitle);

                        builder.CloseElement();
                    }

                    if (
                        GetProperty(
                            noteBlock,
                            "paragraphs")
                        is JsonElement noteParagraphs)
                    {
                        builder.AddContent(
                            seq++,
                            RenderParagraphs(
                                noteParagraphs));
                    }

                    builder.CloseElement();
                }

                builder.CloseElement();
            }

            builder.CloseElement();
        }

        return;
    }

    if (type == "table")
    {
        builder.AddContent(
            seq++,
            RenderDynamicTable(
                block,
                "class-table class-inline-table"));

        return;
    }
};

    private RenderFragment RenderFormula(JsonElement formula) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "class-formula");
        builder.OpenElement(seq++, "span"); builder.AddContent(seq++, GetString(formula, "label")); builder.CloseElement();
        builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, GetString(formula, "value")); builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderParagraphs(JsonElement paragraphs) => builder =>
    {
        var seq = 0;

        if (paragraphs.ValueKind == JsonValueKind.String)
        {
            builder.OpenElement(seq++, "p");
            builder.AddContent(
                seq++,
                RenderGlossaryText(
                    ValueToText(paragraphs)));
            builder.CloseElement();
            return;
        }

        if (paragraphs.ValueKind != JsonValueKind.Array)
            return;

        foreach (var paragraph in paragraphs.EnumerateArray())
        {
            builder.OpenElement(seq++, "p");
            builder.AddContent(
                seq++,
                RenderGlossaryText(
                    ValueToText(paragraph)));
            builder.CloseElement();
        }
    };

    private RenderFragment RenderList(JsonElement items) => builder =>
    {
        var seq = 0;

        if (items.ValueKind != JsonValueKind.Array)
            return;

        builder.OpenElement(seq++, "ul");
        builder.AddAttribute(seq++, "class", "class-list");

        foreach (var item in items.EnumerateArray())
        {
            builder.OpenElement(seq++, "li");
            builder.AddContent(
                seq++,
                RenderGlossaryText(
                    ValueToText(item)));
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private RenderFragment RenderDynamicTable(JsonElement table, string cssClass) => builder =>
    {
        var columns = GetProperty(table, "columns");
        var rows = GetProperty(table, "rows");

        if (
            columns is not JsonElement columnArray
            || rows is not JsonElement rowArray
            || columnArray.ValueKind != JsonValueKind.Array
            || rowArray.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        var seq = 0;
        var columnCount = columnArray.GetArrayLength();

        static string ColumnClass(string key)
        {
            var normalized = new string(
                key.ToLowerInvariant()
                    .Select(character => char.IsLetterOrDigit(character) ? character : '-')
                    .ToArray());

            while (normalized.Contains("--"))
                normalized = normalized.Replace("--", "-");

            return $"table-col-{normalized.Trim('-')}";
        }

        static string CellClasses(string key)
        {
            var classes = new List<string> { ColumnClass(key) };

            if (key.Equals("level", StringComparison.OrdinalIgnoreCase))
                classes.Add("table-level");

            if (key.Equals("features", StringComparison.OrdinalIgnoreCase))
                classes.Add("table-features");

            return string.Join(" ", classes);
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "class-table-scroll");

        builder.OpenElement(seq++, "table");
        builder.AddAttribute(seq++, "class", $"{cssClass} table-cols-{columnCount}");

        builder.OpenElement(seq++, "thead");
        builder.OpenElement(seq++, "tr");

        foreach (var column in columnArray.EnumerateArray())
        {
            var key = GetString(column, "key") ?? string.Empty;
            var label = GetString(column, "label") ?? string.Empty;

            builder.OpenElement(seq++, "th");
            builder.AddAttribute(seq++, "class", CellClasses(key));
            builder.AddContent(seq++, RenderGlossaryText(label));
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "tbody");

        foreach (var row in rowArray.EnumerateArray())
        {
            builder.OpenElement(seq++, "tr");

            foreach (var column in columnArray.EnumerateArray())
            {
                var key = GetString(column, "key") ?? string.Empty;

                builder.OpenElement(seq++, "td");
                builder.AddAttribute(seq++, "class", CellClasses(key));

                if (GetProperty(row, key) is JsonElement value)
                {
                    builder.AddContent(
                        seq++,
                        RenderGlossaryText(
                            ValueToText(value)));
                }

                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string AnchorId(string value)
    {
        var chars =
            value
                .ToLowerInvariant()
                .Select(character =>
                    char.IsLetterOrDigit(character)
                        ? character
                        : '-')
                .ToArray();

        var result =
            new string(chars);

        while (result.Contains("--"))
            result =
                result.Replace(
                    "--",
                    "-");

        return result.Trim('-');
    }

    private static string Humanize(string value)
        => string.Join(" ", value.Split('_', StringSplitOptions.RemoveEmptyEntries).Select(word => char.ToUpperInvariant(word[0]) + word[1..]));

    private static string SlugToDisplayName(string slug)
        => string.IsNullOrWhiteSpace(slug) ? "Class" : string.Join(" ", slug.Split('-', StringSplitOptions.RemoveEmptyEntries).Select(word => char.ToUpperInvariant(word[0]) + word[1..]));

    private static string ToSlug(string value)
    {
        return string.Join(
            "-",
            value
                .Trim()
                .ToLowerInvariant()
                .Split(
                    new[] { ' ', '_', '-' },
                    StringSplitOptions.RemoveEmptyEntries));
    }

    private static bool IsSafeSlug(string slug)
        => !string.IsNullOrWhiteSpace(slug) && slug.All(character => char.IsLetterOrDigit(character) || character == '-');

    public void Dispose() => classDocument?.Dispose();
}
