<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <ResourcePreloader />

    <!--
        Start connecting to the image CDN immediately.
        This reduces the delay before images begin downloading.
    -->
    <link rel="preconnect"
          href="https://pub-bf21913a9572403eaaeb529e5bc42880.r2.dev"
          crossorigin />

    <link rel="dns-prefetch"
          href="//pub-bf21913a9572403eaaeb529e5bc42880.r2.dev" />

    <!--
        The Royal Treasury emblem appears immediately in the navigation,
        so preload it instead of waiting for the body to be parsed.
    -->
    <link rel="preload"
          href="https://pub-bf21913a9572403eaaeb529e5bc42880.r2.dev/site-images/site-emblem.png"
          as="image"
          fetchpriority="high" />

    <link rel="stylesheet"
          href="@Assets["app.css"]" />

    <!-- NavMenu uses a global stylesheet as a .NET 10 scoped-CSS workaround. -->
    <link rel="stylesheet"
          href="@Assets["css/nav-menu.css"]" />

    <link rel="stylesheet"
          href="@Assets["Website_of_Everything.styles.css"]" />

    <ImportMap />

    <!-- Favicons -->
    <link rel="icon"
          type="image/png"
          href="https://pub-bf21913a9572403eaaeb529e5bc42880.r2.dev/site-images/site-emblem.png" />

    <link rel="apple-touch-icon"
          href="https://pub-bf21913a9572403eaaeb529e5bc42880.r2.dev/site-images/site-emblem.png" />

    <HeadOutlet />
</head>

<body>

    <Routes />

    <ReconnectModal />

    <!--
        Keeps desktop glossary tooltips beside
