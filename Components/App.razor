<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <ResourcePreloader />

    <link rel="stylesheet"
          href="@Assets["app.css"]" />

    <!-- NavMenu uses a global stylesheet as a .NET 10 scoped-CSS workaround. -->
    <link rel="stylesheet"
          href="@Assets["css/nav-menu.css"]" />

    <link rel="stylesheet"
          href="@Assets["Website_of_Everything.styles.css"]" />

    <ImportMap />

    <!-- Royal Treasury favicon: serve it from wwwroot so it is always available with the app. -->
    <link rel="icon"
          type="image/png"
          sizes="512x512"
          href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon"
          href="@Assets["favicon.png"]" />

    <HeadOutlet />
</head>

<body>

    <Routes />

    <ReconnectModal />

    <!--
        Keeps desktop glossary tooltips beside
        their triggering word while clamping
        them inside the visible viewport.
    -->
    <script src="/js/glossary-position.js"></script>

    <script src="@Assets["_framework/blazor.web.js"]"></script>

</body>

</html>