<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <ResourcePreloader />

    <link rel="stylesheet"
          href="@Assets["app.css"]" />

    <!-- NavMenu uses a global stylesheet as a .NET 10 scoped-CSS workaround. -->
    <link rel="stylesheet"
          href="@Assets["css/nav-menu.css"]" />

    <link rel="stylesheet"
          href="@Assets["Website_of_Everything.styles.css"]" />

    <ImportMap />

    <!-- Royal Treasury favicon -->
    <link rel="icon"
          type="image/png"
          href="/images/site-emblem.png" />

    <HeadOutlet />
</head>

<body>

    <div id="site-page-loader"
         class="site-page-loader site-page-loader-visible"
         data-permanent
         role="status"
         aria-live="polite"
         aria-label="Loading page"
         aria-hidden="false">
        <div class="site-page-loader-panel">
            <img class="site-page-loader-emblem"
                 src="https://pub-bf21913a9572403eaaeb529e5bc42880.r2.dev/site-images/site-emblem.png"
                 alt=""
                 aria-hidden="true" />
            <div class="site-page-loader-vault" aria-hidden="true">
                <div class="site-page-loader-vault-frame">
                    <div class="site-page-loader-vault-door">
                        <span class="site-page-loader-vault-rivet rivet-1"></span>
                        <span class="site-page-loader-vault-rivet rivet-2"></span>
                        <span class="site-page-loader-vault-rivet rivet-3"></span>
                        <span class="site-page-loader-vault-rivet rivet-4"></span>
                        <div class="site-page-loader-vault-wheel">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <i></i>
                        </div>
                    </div>
                    <div class="site-page-loader-vault-darkness"></div>
                </div>
            </div>
            <div class="site-page-loader-title">Opening the Treasury</div>
            <div class="site-page-loader-copy">Preparing the next page…</div>
        </div>
    </div>

    <Routes />

    <ReconnectModal />

    <!--
        Keeps desktop glossary tooltips beside
        their triggering word while clamping
        them inside the visible viewport.
    -->
    <script src="/js/glossary-position.js"></script>
    <script src="/js/page-loading.js"></script>

    <script src="@Assets["_framework/blazor.web.js"]"></script>

</body>

</html>