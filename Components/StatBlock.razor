@using System.Text.Json
@using Website_of_Everything.Models
@using Website_of_Everything.Components.Pages


<article class="rt-statblock @CreatureTypeClass">


    <!-- =================================
         CREATURE HEADER
         ================================= -->

    <header class="rt-statblock-header">

        <h2>
            @Data.Title
        </h2>


        @if (!string.IsNullOrWhiteSpace(CreatureLine))
        {
            <p>

                <!--
                    IMPORTANT:

                    Creature types such as
                    beast, undead, fiend, etc.
                    are only permitted to
                    activate in this context.
                -->

                <GlossaryText
                    Text="@CreatureLine"
                    Context="GlossaryContext.StatBlockCreatureLine" />

            </p>
        }

    </header>


    <!-- =================================
         COLUMNS
         ================================= -->

    <div class="
        rt-statblock-columns
        @(HasRightColumn
            ? ""
            : "rt-statblock-columns-single")">


        <!-- =================================
             LEFT COLUMN
             ================================= -->

        <div class="rt-statblock-column">


            <!-- =================================
                 CORE STATS
                 ================================= -->

            <section class="rt-stat-card">

                <div class="rt-stat-section-bar">
                    Stats
                </div>


                <dl class="rt-core-stats">


                    <!-- AC -->

                    @if (
                        !string.IsNullOrWhiteSpace(
                            Data.ArmorClass))
                    {
                        <div>

                            <dt>
                                AC
                            </dt>

                            <dd>

                                <GlossaryText
                                    Text="@Data.ArmorClass"
                                    Context="GlossaryContext.StatBlock" />

                            </dd>

                        </div>
                    }


                    <!-- THRESHOLD -->

                    @if (
                        !string.IsNullOrWhiteSpace(
                            Data.Threshold))
                    {
                        <div>

                            <dt>
                                Threshold
                            </dt>

                            <dd>

                                <GlossaryText
                                    Text="@Data.Threshold"
                                    Context="GlossaryContext.StatBlock" />

                            </dd>

                        </div>
                    }


                    <!-- HIT POINTS -->

                    @if (
                        !string.IsNullOrWhiteSpace(
                            Data.HitPoints))
                    {
                        <div>

                            <dt>
                                Hit Points
                            </dt>

                            <dd>

                                <GlossaryText
                                    Text="@Data.HitPoints"
                                    Context="GlossaryContext.StatBlock" />

                            </dd>

                        </div>
                    }


                    <!-- SPEED -->

                    @if (Data.Speed.Count > 0)
                    {
                        <div>

                            <dt>
                                Speed
                            </dt>

                            <dd>

                                <GlossaryText
                                    Text="@SpeedText"
                                    Context="GlossaryContext.StatBlock" />

                            </dd>

                        </div>
                    }

                </dl>

            </section>


            <!-- =================================
                 ABILITY SCORES
                 ================================= -->

            @if (Data.AbilityScores.Count > 0)
            {
                <section class="rt-stat-card">

                    <div class="rt-stat-section-bar">
                        Abilities
                    </div>


                    <div class="rt-abilities">

                        @foreach (
                            var abilityName
                            in AbilityOrder)
                        {
                            @if (
                                Data.AbilityScores
                                    .TryGetValue(
                                        abilityName,
                                        out var ability))
                            {
                                <div class="rt-ability">


                                    <div class="rt-ability-score">

                                        <span>
                                            @abilityName
                                        </span>

                                        <strong>
                                            @ability.Score
                                        </strong>

                                    </div>


                                    <div class="rt-ability-rolls">

                                        <div>

                                            <small>
                                                Check
                                            </small>

                                            <strong>
                                                @DisplayAbilityCheck(
                                                    ability)
                                            </strong>

                                        </div>


                                        <div>

                                            <small>
                                                Save
                                            </small>

                                            <strong>
                                                @DisplayAbilitySave(
                                                    abilityName,
                                                    ability)
                                            </strong>

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </section>
            }


            <!-- =================================
                 CREATURE INFO
                 ================================= -->

            @if (HasInfo)
            {
                <section class="rt-stat-card">

                    <div class="rt-stat-section-bar">
                        Info
                    </div>


                    <dl class="rt-details">


                        <!-- QUALITY TRAITS -->

                        @if (Data.QualityTraits.Count > 0)
                        {
                            <div>

                                <dt>
                                    Quality Traits
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@string.Join(", ", Data.QualityTraits)"
                                        Context="GlossaryContext.StatBlockQualityTrait" />

                                </dd>

                            </div>
                        }


                        <!-- SKILLS -->

                        @if (Data.Skills.Count > 0)
                        {
                            <div>

                                <dt>
                                    Skills
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@string.Join(", ", Data.Skills)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- RESISTANCES -->

                        @if (Data.Resistances.Count > 0)
                        {
                            <div>

                                <dt>
                                    Resistances
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@string.Join(", ", Data.Resistances)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- VULNERABILITIES -->

                        @if (Data.Vulnerabilities.Count > 0)
                        {
                            <div>

                                <dt>
                                    Vulnerabilities
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@string.Join(", ", Data.Vulnerabilities)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- IMMUNITIES -->

                        @if (Data.Immunities.Count > 0)
                        {
                            <div>

                                <dt>
                                    Immunities
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@string.Join(", ", Data.Immunities)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- CONDITION IMMUNITIES -->

                        @if (Data.ConditionImmunities.Count > 0)
                        {
                            <div>

                                <dt>
                                    Condition Immunities
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@string.Join(", ", Data.ConditionImmunities)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- SENSES -->

                        @if (Data.Senses.Count > 0)
                        {
                            <div>

                                <dt>
                                    Senses
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@string.Join(", ", Data.Senses)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- LANGUAGES -->

                        @if (HasJsonValue(Data.Languages))
                        {
                            <div>

                                <dt>
                                    Languages
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@FormatJsonValue(Data.Languages)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- CHALLENGE RATING -->

                        @if (
                            !string.IsNullOrWhiteSpace(
                                Data.ChallengeRating))
                        {
                            <div>

                                <dt>
                                    CR
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@Data.ChallengeRating"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }


                        <!-- PROFICIENCY BONUS -->

                        @if (
                            HasJsonValue(
                                Data.ProficiencyBonus))
                        {
                            <div>

                                <dt>
                                    PB
                                </dt>

                                <dd>

                                    <GlossaryText
                                        Text="@FormatJsonValue(Data.ProficiencyBonus)"
                                        Context="GlossaryContext.StatBlock" />

                                </dd>

                            </div>
                        }

                    </dl>

                </section>
            }


            <!-- =================================
                 TRAITS
                 ================================= -->

            @if (Data.Traits.Count > 0)
            {
                <section class="rt-stat-section">

                    <div class="rt-stat-section-bar">
                        Traits
                    </div>


                    @foreach (
                        var entry
                        in Data.Traits)
                    {
                        <p class="rt-stat-entry">

                            <strong>
                                <em>

                                    <GlossaryText
                                        Text="@entry.Name"
                                        Context="GlossaryContext.StatBlock" />.

                                </em>
                            </strong>

                            <StatBlockEntryDetails
                                Entry="@entry" />

                        </p>
                    }

                </section>
            }

        </div>


        <!-- =================================
             RIGHT COLUMN
             ================================= -->

        @if (HasRightColumn)
        {
            <div class="rt-statblock-column">


                <!-- =================================
                     ACTIONS
                     ================================= -->

                @if (Data.Actions.Count > 0)
                {
                    <section class="rt-stat-section">

                        <div class="rt-stat-section-bar">
                            Actions
                        </div>


                        @foreach (
                            var entry
                            in Data.Actions)
                        {
                            <p class="rt-stat-entry">

                                <strong>
                                    <em>

                                        <GlossaryText
                                            Text="@entry.Name"
                                            Context="GlossaryContext.StatBlock" />.

                                    </em>
                                </strong>

                                <StatBlockEntryDetails
                                    Entry="@entry" />

                            </p>
                        }

                    </section>
                }


                <!-- =================================
                     BONUS ACTIONS
                     ================================= -->

                @if (Data.BonusActions.Count > 0)
                {
                    <section class="rt-stat-section">

                        <div class="rt-stat-section-bar">
                            Bonus Actions
                        </div>


                        @foreach (
                            var entry
                            in Data.BonusActions)
                        {
                            <p class="rt-stat-entry">

                                <strong>
                                    <em>

                                        <GlossaryText
                                            Text="@entry.Name"
                                            Context="GlossaryContext.StatBlock" />.

                                    </em>
                                </strong>

                                <StatBlockEntryDetails
                                    Entry="@entry" />

                            </p>
                        }

                    </section>
                }


                <!-- =================================
                     REACTIONS
                     ================================= -->

                @if (Data.Reactions.Count > 0)
                {
                    <section class="rt-stat-section">

                        <div class="rt-stat-section-bar">
                            Reactions
                        </div>


                        @foreach (
                            var entry
                            in Data.Reactions)
                        {
                            <p class="rt-stat-entry">

                                <strong>
                                    <em>

                                        <GlossaryText
                                            Text="@entry.Name"
                                            Context="GlossaryContext.StatBlock" />.

                                    </em>
                                </strong>

                                <StatBlockEntryDetails
                                    Entry="@entry" />

                            </p>
                        }

                    </section>
                }


                <!-- =================================
                     LEGENDARY ACTIONS
                     ================================= -->

                @if (
                    Data.LegendaryActions.Count > 0)
                {
                    <section class="rt-stat-section">

                        <div class="rt-stat-section-bar">
                            @LegendaryActionsHeading
                        </div>


                        @foreach (
                            var entry
                            in Data.LegendaryActions)
                        {
                            <p class="rt-stat-entry">

                                <strong>
                                    <em>

                                        <GlossaryText
                                            Text="@entry.Name"
                                            Context="GlossaryContext.StatBlock" />.

                                    </em>
                                </strong>

                                <StatBlockEntryDetails
                                    Entry="@entry" />

                            </p>
                        }

                    </section>
                }


                <!-- =================================
                     MYTHIC ACTIONS
                     ================================= -->

                @if (
                    Data.MythicActions.Count > 0
                    ||
                    !string.IsNullOrWhiteSpace(
                        Data.MythicActions.Intro))
                {
                    <section class="rt-stat-section">

                        <div class="rt-stat-section-bar">
                            @MythicActionsHeading
                        </div>


                        @if (
                            !string.IsNullOrWhiteSpace(
                                Data.MythicActions.Intro))
                        {
                            <p class="rt-stat-entry">

                                <GlossaryText
                                    Text="@Data.MythicActions.Intro"
                                    Context="GlossaryContext.StatBlock" />

                            </p>
                        }


                        @foreach (
                            var entry
                            in Data.MythicActions)
                        {
                            <p class="rt-stat-entry">

                                <strong>
                                    <em>

                                        <GlossaryText
                                            Text="@entry.Name"
                                            Context="GlossaryContext.StatBlock" />.

                                    </em>
                                </strong>

                                <StatBlockEntryDetails
                                    Entry="@entry" />

                            </p>
                        }

                    </section>
                }


                <!-- =================================
                     LEGENDARY REACTIONS
                     ================================= -->

                @if (
                    Data.LegendaryReactions.Count > 0)
                {
                    <section class="rt-stat-section">

                        <div class="rt-stat-section-bar">
                            @LegendaryReactionsHeading
                        </div>


                        @foreach (
                            var entry
                            in Data.LegendaryReactions)
                        {
                            <p class="rt-stat-entry">

                                <strong>
                                    <em>

                                        <GlossaryText
                                            Text="@entry.Name"
                                            Context="GlossaryContext.StatBlock" />.

                                    </em>
                                </strong>

                                <StatBlockEntryDetails
                                    Entry="@entry" />

                            </p>
                        }

                    </section>
                }

            </div>
        }

    </div>

</article>


@code {

    // =====================================
    // DATA
    // =====================================

    [Parameter]
    [EditorRequired]
    public StatBlockData Data { get; set; } =
        new();


    // =====================================
    // ABILITY ORDER
    // =====================================

    private static readonly string[]
        AbilityOrder =
        [
            "STR",
            "DEX",
            "CON",
            "INT",
            "WIS",
            "CHA"
        ];


    // =====================================
    // SPEED ORDER
    // =====================================

    private static readonly string[]
        SpeedOrder =
        [
            "walk",
            "climb",
            "fly",
            "swim",
            "burrow"
        ];


    // =====================================
    // CREATURE-TYPE COLOUR CLASS
    // =====================================

    private string CreatureTypeClass
    {
        get
        {
            var creatureType =
                Data.Creature.Type
                    ?.Trim()
                    .ToLowerInvariant()
                ?? string.Empty;


            /*
             * StartsWith is intentional.
             *
             * It means:
             *
             * fiend (yokai)
             *
             * still receives the Fiend
             * colour scheme.
             *
             * Likewise:
             *
             * humanoid (petitioner)
             *
             * still receives Humanoid.
             */
            var knownTypes =
                new[]
                {
                    "aberration",
                    "beast",
                    "celestial",
                    "construct",
                    "dragon",
                    "elemental",
                    "fey",
                    "fiend",
                    "giant",
                    "humanoid",
                    "monstrosity",
                    "ooze",
                    "plant",
                    "undead"
                };


            var match =
                knownTypes.FirstOrDefault(
                    type =>
                        creatureType.StartsWith(
                            type,
                            StringComparison.OrdinalIgnoreCase));


            return match is null
                ? "rt-type-default"
                : $"rt-type-{match}";
        }
    }


    // =====================================
    // CREATURE LINE
    // =====================================

    private string CreatureLine
    {
        get
        {
            var creatureType =
                JoinWords(
                    Data.Creature.Size,
                    Data.Creature.Type);


            return string.Join(
                ", ",
                new[]
                {
                    creatureType,
                    Data.Creature.Alignment
                }
                .Where(
                    value =>
                        !string.IsNullOrWhiteSpace(
                            value)));
        }
    }


    // =====================================
    // SPEED TEXT
    // =====================================

    private string SpeedText
    {
        get
        {
            var results =
                new List<string>();


            var used =
                new HashSet<string>(
                    StringComparer
                        .OrdinalIgnoreCase);


            foreach (
                var speedName
                in SpeedOrder)
            {
                if (
                    Data.Speed.TryGetValue(
                        speedName,
                        out var speedValue)
                    &&
                    !string.IsNullOrWhiteSpace(
                        speedValue))
                {
                    results.Add(
                        FormatSpeed(
                            speedName,
                            speedValue));


                    used.Add(
                        speedName);
                }
            }


            foreach (
                var speed
                in Data.Speed)
            {
                if (
                    used.Contains(
                        speed.Key)
                    ||
                    string.IsNullOrWhiteSpace(
                        speed.Value))
                {
                    continue;
                }


                results.Add(
                    FormatSpeed(
                        speed.Key,
                        speed.Value));
            }


            return string.Join(
                ", ",
                results);
        }
    }


    // =====================================
    // HAS INFO
    // =====================================

    private bool HasInfo =>
        Data.QualityTraits.Count > 0
        ||
        Data.Skills.Count > 0
        ||
        Data.Resistances.Count > 0
        ||
        Data.Vulnerabilities.Count > 0
        ||
        Data.Immunities.Count > 0
        ||
        Data.ConditionImmunities.Count > 0
        ||
        Data.Senses.Count > 0
        ||
        HasJsonValue(
            Data.Languages)
        ||
        !string.IsNullOrWhiteSpace(
            Data.ChallengeRating)
        ||
        HasJsonValue(
            Data.ProficiencyBonus);


    // =====================================
    // RIGHT COLUMN
    // =====================================

    private bool HasRightColumn =>
        Data.Actions.Count > 0
        ||
        Data.BonusActions.Count > 0
        ||
        Data.Reactions.Count > 0
        ||
        Data.LegendaryActions.Count > 0
        ||
        Data.MythicActions.Count > 0
        ||
        !string.IsNullOrWhiteSpace(
            Data.MythicActions.Intro)
        ||
        Data.LegendaryReactions.Count > 0;


    // =====================================
    // LEGENDARY ACTIONS HEADING
    // =====================================

    private string LegendaryActionsHeading =>
        LegendarySectionHeading(
            Data.LegendaryActions,
            "Legendary Actions");


    // =====================================
    // MYTHIC ACTIONS HEADING
    // =====================================

    private string MythicActionsHeading =>
        LegendarySectionHeading(
            Data.MythicActions,
            "Mythic Actions");


    // =====================================
    // LEGENDARY REACTIONS HEADING
    // =====================================

    private string LegendaryReactionsHeading =>
        LegendarySectionHeading(
            Data.LegendaryReactions,
            "Legendary Reactions");


    // =====================================
    // LEGENDARY SECTION HEADING
    // =====================================

    private static string
        LegendarySectionHeading(
            StatBlockLegendaryActions section,
            string fallbackHeader)
    {
        var header =
            string.IsNullOrWhiteSpace(
                section.Header)

            ? fallbackHeader

            : section.Header.Trim();


        if (
            section.ActionsPerRound > 0)
        {
            var actionLabel =
                section.ActionsPerRound == 1

                ? "Action/Round"

                : "Actions/Round";


            return
                $"{header} " +
                $"({section.ActionsPerRound} " +
                $"{actionLabel})";
        }


        if (
            !string.IsNullOrWhiteSpace(
                section.UsesText))
        {
            return
                $"{header} " +
                $"({section.UsesText.Trim()})";
        }


        if (
            section.Uses <= 0)
        {
            return
                header;
        }


        var useLabel =
            section.Uses == 1

            ? "Use"

            : "Uses";


        return
            $"{header} " +
            $"({section.Uses} " +
            $"{useLabel})";
    }


    // =====================================
    // JOIN WORDS
    // =====================================

    private static string JoinWords(
        string first,
        string second)
    {
        return string.Join(
            " ",
            new[]
            {
                first,
                second
            }
            .Where(
                value =>
                    !string.IsNullOrWhiteSpace(
                        value)));
    }


    // =====================================
    // FORMAT SPEED
    // =====================================

    private static string FormatSpeed(
        string name,
        string value)
    {
        /*
         * Walking speed displays as:
         *
         * 30 ft.
         *
         * rather than:
         *
         * Walk 30 ft.
         */
        if (
            name.Equals(
                "walk",
                StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }


        return
            $"{ToTitleCase(name)} {value}";
    }


    // =====================================
    // TITLE CASE
    // =====================================

    private static string ToTitleCase(
        string value)
    {
        if (
            string.IsNullOrWhiteSpace(
                value))
        {
            return string.Empty;
        }


        var cleaned =
            value.Replace(
                '_',
                ' ');


        return
            char.ToUpperInvariant(
                cleaned[0])
            +
            cleaned[1..];
    }


    // =====================================
    // DISPLAY ABILITY CHECK
    //
    // Older stat blocks use "check".
    // Monster files may instead use
    // "modifier".
    // =====================================

    private static string DisplayAbilityCheck(
        StatBlockAbilityScore ability)
    {
        if (
            !string.IsNullOrWhiteSpace(
                ability.Check)
            &&
            ability.Check != "-")
        {
            return ability.Check;
        }


        if (
            !string.IsNullOrWhiteSpace(
                ability.Modifier)
            &&
            ability.Modifier != "-")
        {
            return ability.Modifier;
        }


        return "—";
    }


    // =====================================
    // DISPLAY ABILITY SAVE
    //
    // Priority:
    //
    // 1. A save stored directly on the
    //    ability-score object.
    //
    // 2. A matching value from the top-level
    //    saving_throws array.
    //
    // 3. If the creature is not specifically
    //    proficient in that save, use the same
    //    value as its normal ability check.
    // =====================================

    private string DisplayAbilitySave(
        string abilityName,
        StatBlockAbilityScore ability)
    {
        var directSave =
            DisplayRoll(
                ability.Save);


        if (directSave != "—")
        {
            return directSave;
        }


        if (
            TryGetExplicitSavingThrow(
                abilityName,
                out var explicitSave))
        {
            return explicitSave;
        }


        return
            DisplayAbilityCheck(
                ability);
    }


    // =====================================
    // FIND TOP-LEVEL SAVING THROW
    //
    // Supports both abbreviated and full
    // ability names, for example:
    //
    // Dex +10
    // Dexterity +10
    //
    // It also tolerates older files that put
    // several saves in one comma-separated
    // string.
    // =====================================

    private bool TryGetExplicitSavingThrow(
        string abilityName,
        out string value)
    {
        value =
            string.Empty;


        var aliases =
            abilityName
                .ToUpperInvariant()
            switch
            {
                "STR" =>
                    new[]
                    {
                        "Str",
                        "Strength"
                    },

                "DEX" =>
                    new[]
                    {
                        "Dex",
                        "Dexterity"
                    },

                "CON" =>
                    new[]
                    {
                        "Con",
                        "Constitution"
                    },

                "INT" =>
                    new[]
                    {
                        "Int",
                        "Intelligence"
                    },

                "WIS" =>
                    new[]
                    {
                        "Wis",
                        "Wisdom"
                    },

                "CHA" =>
                    new[]
                    {
                        "Cha",
                        "Charisma"
                    },

                _ =>
                    Array.Empty<string>()
            };


        foreach (
            var rawSavingThrow
            in Data.SavingThrows)
        {
            if (
                string.IsNullOrWhiteSpace(
                    rawSavingThrow))
            {
                continue;
            }


            var candidates =
                rawSavingThrow
                    .Split(
                        new[]
                        {
                            ',',
                            ';'
                        },
                        StringSplitOptions
                            .RemoveEmptyEntries
                        |
                        StringSplitOptions
                            .TrimEntries);


            foreach (
                var candidate
                in candidates)
            {
                foreach (
                    var alias
                    in aliases)
                {
                    if (
                        candidate.Length <=
                            alias.Length
                        ||
                        !candidate.StartsWith(
                            alias,
                            StringComparison
                                .OrdinalIgnoreCase))
                    {
                        continue;
                    }


                    var boundary =
                        candidate[
                            alias.Length];


                    if (
                        !char.IsWhiteSpace(
                            boundary)
                        &&
                        boundary != ':')
                    {
                        continue;
                    }


                    var parsedValue =
                        candidate[
                                alias.Length..]
                            .Trim()
                            .TrimStart(':')
                            .Trim();


                    if (
                        string.IsNullOrWhiteSpace(
                            parsedValue)
                        ||
                        parsedValue == "-")
                    {
                        continue;
                    }


                    value =
                        parsedValue;


                    return true;
                }
            }
        }


        return false;
    }


    // =====================================
    // DISPLAY CHECK / SAVE
    // =====================================

    private static string DisplayRoll(
        string value)
    {
        if (
            string.IsNullOrWhiteSpace(
                value)
            ||
            value == "-")
        {
            return "—";
        }


        return value;
    }


    // =====================================
    // JSON HAS VALUE
    // =====================================

    private static bool HasJsonValue(
        JsonElement value)
    {
        if (
            value.ValueKind
            is JsonValueKind.Undefined
            or JsonValueKind.Null)
        {
            return false;
        }


        if (
            value.ValueKind ==
            JsonValueKind.String)
        {
            return
                !string.IsNullOrWhiteSpace(
                    value.GetString());
        }


        if (
            value.ValueKind ==
            JsonValueKind.Array)
        {
            return
                value.GetArrayLength() > 0;
        }


        return true;
    }


    // =====================================
    // FORMAT JSON
    // =====================================

    private static string FormatJsonValue(
        JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.String =>
                value.GetString()
                ?? string.Empty,

            JsonValueKind.Array =>
                string.Join(
                    ", ",
                    value
                        .EnumerateArray()
                        .Select(
                            FormatJsonValue)),

            JsonValueKind.True =>
                "Yes",

            JsonValueKind.False =>
                "No",

            JsonValueKind.Null =>
                string.Empty,

            JsonValueKind.Undefined =>
                string.Empty,

            _ =>
                value.ToString()
        };
    }

}