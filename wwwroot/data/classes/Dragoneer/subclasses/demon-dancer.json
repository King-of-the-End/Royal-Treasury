    {
      "name": "Hungering Dart",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "The first time you hit a creature with a melee attack each turn, you gain temporary hit points equal to half damage you deal on that attack. If you score a critical hit you regain these points as hit points instead, with any regained hit points that exceed your maximum amount becoming temporary hit points."
        }
      ]
    },
    {
      "name": "Devilsight",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You have devilsight, allowing you to see in magical and nonmagical darkness as though it was bright light out to a range equal to 15 feet × your proficiency bonus. If another feature gives you greater devilsight than this feature, the range of that source’s devilsight is increased by half of this feature’s amount instead."
        }
      ]
    },
    {
      "name": "Killstrike",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you make a weapon attack you can choose to spend a dragoneer Spell Slot, adding the Spell Slot level to their attack, and extra embodiment damage to the resulting damage roll equal to a d6 × the Spell Slot level."
        }
      ]
    },
    {
      "name": "Dread Strike",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You may use your bonus action to make two weapon attacks with a Light or Finesse weapon."
        }
      ]
    },
    {
      "name": "Veil of the Black Beast",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "As a bonus action, you can create a shroud of darkness surrounding you that obscures your presence, which remains for one minute. While this shroud is active, other creatures have disadvantage on attack rolls against you, your belabored flight speed is converted into a fly speed automatically at the start of each of your turns, and you have advantage on Stealth and Intimidation checks. If you are in complete darkness while this shroud is active, you are treated as invisible. You may use this feature a number of times per Long Rest equal to half your proficiency bonus."
        }
      ]
    },
    {
      "name": "Famished Dart",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Your Hungering Dart feature now gives you temporary hit points/hit points equal to the full damage you deal, rather than half."
        }
      ]
    }
  ]
}
