    {
      "name": "Chain Dance",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Once per turn, when you reduce a creature to 0 hit points as the immediate result of an action you took that turn, you can choose to do one of the following:"
        },
        {
          "type": "list",
          "items": [
            "Immediately make one weapon attack with advantage against another target within range.",
            "Before the end of the turn, use your bonus action to make two additional weapon attacks against a single target within range."
          ]
        }
      ]
    },
    {
      "name": "Whirlwind Cry",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "As an action, you can make a weapon attack using the same weapon against each creature you choose within that weapon’s reach. You can do so a number of times per Long Rest equal to your proficiency bonus."
        }
      ]
    },
    {
      "name": "Deny the Loss",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When an ally of yours who is within reach of a weapon you are holding would be hit by an attack you can see, you may use your reaction to redirect the attack to you, causing it to hit automatically. Any damage you take from this is reduced by half your dragoneer level."
        },
        {
          "type": "paragraph",
          "text": "You may also choose to do as described above without using your reaction, but must spend a dragoneer Spell Slot instead and you cannot do so if you are incapacitated. If you do, the damage is further reduced by 1d8 × the level of the Spell Slot you used to do so."
        }
      ]
    },
    {
      "name": "Chain Attack Improvement",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You can make three attacks, instead of one, when you take the Attack action. When you do, you can replace one of these attacks with casting a dragoneer spell with a casting time of 1 action."
        }
      ]
    },
    {
      "name": "Commander’s Authority",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You and creatures within 15 feet of you are immune to the frightened and enraged conditions. They retain this immunity until they end a turn outside this range."
        },
        {
          "type": "paragraph",
          "text": "Additionally, as long as you aren’t incapacitated, you and each creature within this feature’s range add a +2 bonus to the first attack roll and saving throw they make each turn."
        }
      ]
    }
  ]
}
