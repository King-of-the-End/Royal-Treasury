    {
      "name": "Ember and Burn",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you cast a spell using a dragoneer Spell Slot, roll a d100. On a result equal to or less than your dragoneer level plus 10, the spell slot is not consumed."
        }
      ]
    },
    {
      "name": "Power of Connection",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "By offloading the burden of magic you’re wielding to the dragon spirit fueling you, you may concentrate on a second spell (or effect) that requires it alongside the first. Both effects requiring concentration use a combined concentration check, failing or succeeding together."
        }
      ]
    },
    {
      "name": "Chain Burst",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you trade a weapon attack to cast a spell as described in your Chain Action feature, you can choose to cast a spell that has a level equal to half the Spell Slot level you used or less. This spell is cast as though the Spell Slot used was equal to the base level of that spell. If you do so, you can trade a second weapon attack as part of that Chain Action to cast another spell in the same manner, which must also have a casting time of 1 action."
        }
      ]
    },
    {
      "name": "Magic Resistance",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You have advantage on saving throws against magical effects."
        }
      ]
    },
    {
      "name": "Venomous Arcana",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Your arcane potency has caused arcane energy to freely leak from your body, lashing back against any who strike you. Any time a creature hits you with an attack from within 30 feet, they take a d10 of embodiment damage. This damage ignores damage thresholds and resistances (but not immunities)."
        }
      ]
    }
  ]
