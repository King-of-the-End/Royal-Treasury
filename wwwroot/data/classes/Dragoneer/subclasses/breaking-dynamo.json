    {
      "name": "Improved Critical",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You score a critical hit on a d20 result of 19 or 20."
        }
      ]
    },
    {
      "name": "Head-On Focus",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you are hit with an attack from further than 10 feet away from you, you can react quickly enough to defend yourself. As long as you aren’t incapacitated, your armor class against that attack gains a bonus equal to your proficiency bonus."
        }
      ]
    },
    {
      "name": "Wrathful Charge",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you fail a saving throw, you gain a single point of Wrath which you retain for 1 minute. You can have a number of points of Wrath equal to your proficiency bonus."
        },
        {
          "type": "paragraph",
          "text": "When you make a weapon attack, you may spend a point of Wrath to add your proficiency bonus a second time to the result, and also to the damage roll if you hit."
        }
      ]
    },
    {
      "name": "Chain Attack Improvement",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You can make three attacks, instead of one, when you take the Attack action. When you do, you can replace one of these attacks with casting a dragoneer spell with a casting time of 1 action."
        }
      ]
    },
    {
      "name": "Embodied Chain Attack",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You can make four attacks, instead of one, when you take the Attack action. When you do, you can replace one of these attacks with casting a dragoneer spell with a casting time of 1 action."
        },
        {
          "type": "paragraph",
          "text": "Furthermore, your Embodied Strike deals an additional weapon damage die of damage."
        }
      ]
    }
  ]
