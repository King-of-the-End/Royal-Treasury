    {
      "name": "Improved Critical",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You score critical hits on a d20 result of 19 or 20."
        }
      ]
    },
    {
      "name": "Wyrmheart Strikes",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You can use Wisdom in place of Strength or Dexterity for weapon attacks and damage rolls. You may also treat weapon attacks as spell attacks that are considered to be produced by a spell for secondary effects and features."
        }
      ]
    },
    {
      "name": "Shifting Tides",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You are able to bend the tides of fate and chance in your favor. Each time you roll initiative in combat, roll a number of d20s equal to your proficiency bonus, and record the results. These results are Tide Changes. At any point during that combat, when you roll a d20 you can spend one of your Tide Changes to change the d20 result into it, and that Tide Change is then lost. You can do so before or after rolling a d20, but not after the GM declares the success or failure of the roll."
        }
      ]
    },
    {
      "name": "Tide Burst",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You learn to use your Tide Changes more efficiently. When you spend one to change a d20 result, you may turn each d20 result you roll until the end of that turn into that result as well. You may choose to do so to each subsequent roll after rolling it normally and seeing its result."
        },
        {
          "type": "paragraph",
          "text": "Additionally, at the start of each of your turns you can choose one of your remaining Tide Changes and reroll it, and must keep the new result."
        }
      ]
    },
    {
      "name": "Superior Critical",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You score critical hits on a d20 result of 18, 19, or 20."
        }
      ]
    },
    {
      "name": "Critical Change",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you score a critical hit on an attack, roll two d20s and record the higher result of the two as a new Tide Change, which vanishes at the end of combat."
        }
      ]
    }
  ]
}
