    {
      "name": "Holy Relief",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Once per Rest, as a bonus action, you may touch one creature within range and restore hit points to them equal to Xd6, where X is your dragoneer level. When you do so, you may omit one or more d6s from the roll (before making it) to do one of the following effects targeting the same creatures:"
        },
        {
          "type": "list",
          "items": [
            "Remove one point of Combat Fatigue.",
            "If they are Dying, the condition is removed immediately and they regain 1 hit point.",
            "One effect causing them to be blinded, deafened, poisoned, or paralyzed ends.",
            "They gain 1d6 temporary hit points."
          ]
        }
      ]
    },
    {
      "name": "Fate’s Ordainment",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you roll a d20 result less than your proficiency bonus for an attack roll, ability check, or saving throw, fate intervenes and allows you to roll a single new d20 which you must use as your new result."
        }
      ]
    },
    {
      "name": "Improved Spellcasting",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Any time you would roll damage for any dragoneer spell you cast, you may add half your dragoneer level to the result."
        }
      ]
    },
    {
      "name": "Dragon’s Protection",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Once per Long Rest, when you are reduced to 0 hit points you may use your reaction to roll a number of d6s equal to half your dragoneer level twice: you regain hit points equal to the first set instead of being reduced to 0, and you gain temporary hit points equal to the second set."
        }
      ]
    },
    {
      "name": "Avoidance",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you make a saving throw to take half damage, fate intervenes to protect you from harm. You take no damage on a successful save, and half damage on a failure."
        }
      ]
    }
  ]
}
