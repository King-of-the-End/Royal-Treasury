    {
      "name": "Sealing Arc",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You can produce the endurance of dragons to defend you, allowing you to produce the effects of the shield spell, requiring no Spell Slot or components. You can do so twice per Rest, then as you gain dragoneer levels you can use it additional times per Rest: three times at 7th level, and four times at 13th level."
        }
      ]
    },
    {
      "name": "Echo Spirit",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you cast a dragoneer spell, you can choose to project a copy of yourself up to 30 feet away from you and have the spell originate from that echo as though it was you. At the end of the turn you produce the echo, it vanishes and the continuing effects of the spell, if their range is “self,” return to being centered on you."
        }
      ]
    },
    {
      "name": "Blast Magic",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You can empower spells by calling them out by their Draconic name. When you cast a spell at a higher level than its base level, you can treat the spell as though it has the following At Higher Level options, alongside any it already has:"
        },
        {
          "type": "list",
          "items": [
            "The DC of the first save each creature makes against this spell increases by 1 (1 level), 2 (3 levels) or 3 (5 levels).",
            "Any attack rolls made as part of this spell on the same turn it is cast gain a +1 bonus.",
            "Any damage dealt by this spell becomes your embodiment type instead."
          ]
        },
        {
          "type": "paragraph",
          "text": "To do this, you must perform vocal components for the spell (even if it doesn’t have them or a feature would let you ignore them). If you do not or cannot, these options do not take effect."
        }
      ]
    },
    {
      "name": "Wyrmblood Weapon",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You can produce the effects of sword of the archmage once per Rest, requiring no Spell Slot or material components. When you do, the sword can deal your embodiment type instead of force damage."
        }
      ]
    },
    {
      "name": "Draconian Bypass",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Your spells ignore any trait or feature that would give a target advantage on saving throws against magical effects unless they outright negate those effects or the target would automatically be unaffected by them."
        }
      ]
    }
  ]
}
