    {
      "name": "Pull Advantage",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you would have advantage on an attack roll, you can choose to make the roll without advantage to add a +5 bonus to the attack instead."
        }
      ]
    },
    {
      "name": "Pack Strike",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you make an attack against a target while they are within melee reach of one of your allies, you have advantage on that attack."
        }
      ]
    },
    {
      "name": "Adjudicator’s Sentence",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Once per turn, when you choose to forgo advantage on an attack using Pull Advantage and hit your target, you deal an additional 2d8 embodiment damage. This damage increases by a d8 once each when you reach 13th and 17th level as a dragoneer."
        }
      ]
    },
    {
      "name": "Expand Preparations",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Choose one saving throw to become proficient in which you cannot have been proficient in already."
        }
      ]
    },
    {
      "name": "Dragon’s Eye",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You gain truesight out to 60 feet, and when you target an invisible creature with any attack within a weapon’s normal range you may treat them as though you could see them plainly."
        },
        {
          "type": "paragraph",
          "text": "Furthermore, your attacks ignore all except total cover."
        }
      ]
    }
  ]
