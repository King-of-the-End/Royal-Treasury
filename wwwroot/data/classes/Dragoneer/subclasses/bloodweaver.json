    {
      "name": "Spirit Restoring Aura",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Each time you cast a dragoneer spell, you regain hit points equal to twice the level of the Spell Slot you expend when casting it. If the spell did not require a spell slot but is still a leveled spell, you regain hit points equal to the base level of the spell instead."
        }
      ]
    },
    {
      "name": "Metasorcery",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Choose two Metamagic options available to the sorcerer. You learn these Metamagic options and can use them as described by that class, and have Sorcery Points equal to your highest dragoneer spell slot level to use for them, which you regain each time you complete a Long Rest. Each time you gain a level as a dragoneer you may switch one of the Metamagic options you picked for another."
        }
      ]
    },
    {
      "name": "Dragon-Binding",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You are capable of expending a Spell Slot to conjure up the spirit of a Gargantuan dragon as a bonus action, which takes semi-corporeal form. The dragon makes an attack using your spell attack bonus against one target you choose within 60 feet, and on a hit the target is restrained until the end of their next turn and they take embodiment damage equal to 1d8 × the expended Spell Slot’s level."
        }
      ]
    },
    {
      "name": "Dragoneer’s Bonus",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you cast any spell that does not have a Dragoneer Bonus effect but is still a dragoneer spell, that spell is cast as though the Spell Slot you used to cast it was one level higher."
        }
      ]
    },
    {
      "name": "Bloodletting Ritual",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you cast a spell you can choose to forgo the hit points you would have regained through Spirit Restoring Aura to instead add the same amount to all damage rolls made for that spell the first time they damage each given target. If the spell would only have one target, the amount is the full bonus described by Spirit Restoring Aura, but if it would have multiple targets it deals half that much to each instead."
        }
      ]
    }
  ]
}
