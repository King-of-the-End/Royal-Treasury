    {
      "name": "Drake’s Eye",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you attack with a ranged or thrown weapon you are proficient with, you can treat its long range as its normal range."
        }
      ]
    },
    {
      "name": "Improved Critical (Embodied)",
      "level": "1",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You score critical hits on a d20 result of 19 or 20. When you score a critical hit, you can choose to deal all of your weapon’s damage as your embodiment type."
        }
      ]
    },
    {
      "name": "Dragon Shell",
      "level": "3",
      "blocks": [
        {
          "type": "paragraph",
          "text": "When you hit a target with a weapon attack and deal weapon damage to them, you can use your bonus action to create a blast of energy that targets each creature you choose within 10 feet of your target (including them). Each target must make a saving throw (based on your embodiment damage’s save type) against your spell save DC. On a failure, they take the same damage your attack dealt, but as your embodiment damage. You can use this trait a number of times per Rest equal to half your proficiency bonus (rounded down)."
        }
      ]
    },
    {
      "name": "Smiteful Burst",
      "level": "7",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Once per turn, when you score a critical hit due to a d20 result on an attack roll against a target, you deal additional damage of your embodiment type equal to a d8 × your highest level spell slot (including used ones)."
        }
      ]
    },
    {
      "name": "Vain Sympathy",
      "level": "13",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Choose a second Embodiment Type. You gain it as a mutation, and so have access to its feature, movement type, embodiment damage type and save type just as you would for your first. When an embodiment damage type is called for, you can choose which you use, and must use the corresponding embodiment type’s saving throw (and vice versa)."
        }
      ]
    },
    {
      "name": "Superior Critical (Embodied)",
      "level": "17",
      "blocks": [
        {
          "type": "paragraph",
          "text": "You score a critical hit on a d20 result of 18, 19, or 20."
        }
      ]
    }
  ]
