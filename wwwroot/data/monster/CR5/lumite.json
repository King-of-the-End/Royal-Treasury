        {
          "name": "Bite",
          "name_format": "bold_italic",
          "description": "Melee Weapon Attack: +7 to hit, reach 5 ft., one target. Hit: 17 (2d12 + 4) piercing damage plus 11 (2d10) acid damage. If the target is Medium or smaller, they are restrained and grappled (escape DC 15). The lumite can only grapple one creature at a time, and cannot use its Bite while grappling one.",
          "inline_formatting": {
            "Melee Weapon Attack": "italic",
