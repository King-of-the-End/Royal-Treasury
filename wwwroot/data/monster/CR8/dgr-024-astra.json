      "id": "corrosion_astra",
      "title": "Corrosion ASTRA",
      "tag": "Corrosion",
      "traits": [
        {
          "name": "Movement",
          "name_format": "bold_italic",
          "description": "The DGR has a burrow speed equal to its fly speed."
        },
        {
          "name": "Siege",
          "name_format": "bold_italic",
          "description": "The DGR deals double damage to vehicles and structures."
        }
      ],
      "actions": [
        {
          "name": "Multiattack",
          "name_format": "bold_italic",
          "description": "The DGR makes three Adaptive Claw attacks."
        },
        {
          "name": "Adaptive Claw",
          "name_format": "bold_italic",
          "description": "Melee Weapon Attack: \u002B7 to hit, reach 10 ft., one target. Hit: 10 (1d10 \u002B 4) slashing damage plus 7 (1d12) acid damage.",
          "inline_formatting": {
            "Melee Weapon Attack": "italic",
            "Hit": "italic"
          }
        },
        {
          "name": "Arrow of Enlightened Fury",
          "name_format": "bold_italic",
          "description": "Ranged Weapon Attack: \u002B7 to hit, range 120/480 ft., one target. Hit: 46 (8d8 \u002B 10) acid damage.",
          "inline_formatting": {
            "Ranged Weapon Attack": "italic",
            "Hit": "italic"
          }
        }
      ],
      "bonus_actions": [
        {
          "name": "Reactor Flare (1/Rest)",
          "name_format": "bold_italic",
          "description": "The DGR unleashes a burst of energy, targeting each creature within 20 feet of it. Each target must make a DC 16 Dexterity saving throw, taking 39 (6d12) acid damage on a failed save, or half as much on a successful one."
        }
